---
import { contentT } from '~/lib/content-i18n';
import { getEntry } from 'astro:content';
import { glossaryEntryId, termPopoverId, termsSeenIn } from '~/lib/glossary';
import { localizedHref } from '~/lib/links';
import { toLocale } from '~/lib/locales';

interface Props {
  /** File name of the term without extension, e.g. "port". */
  id: string;
}

const { id } = Astro.props;
// Language of the CONTENT, not the URL: on an untranslated page (/en/… showing Spanish),
// the definitions must come out in Spanish.
const locale = toLocale(Astro.locals.starlightRoute.entryMeta.locale);
const entry = await getEntry('glossary', glossaryEntryId(locale, id));
if (!entry) {
  throw new Error(
    `[Term] The term "${id}" does not exist in "${locale}". Create it in src/content/glossary/${locale}/${id}.yaml`,
  );
}
const popoverId = termPopoverId(termsSeenIn(Astro.locals), id);
const anchorName = `--${popoverId}`;
const href = `${localizedHref(locale, 'glossary')}#${id}`;
// Watch the whitespace: the Astro compiler removes line breaks between tags,
// which is why no space appears before the punctuation that follows the term («puerto .»).
// Check the HTML if you change the markup.
---

<span class="term">
  <button
    type="button"
    class="term__trigger"
    popovertarget={popoverId}
    popovertargetaction="show"
    style={`anchor-name: ${anchorName}`}
  >
    <slot />
  </button>
  {/* data-pagefind-ignore: the definition is not lesson content; without this it pollutes the search. */}
  <span
    id={popoverId}
    popover
    class="term__popover"
    style={`position-anchor: ${anchorName}`}
    data-pagefind-ignore
  >
    <span class="term__header">
      <span class="term__kind">{contentT(Astro.locals)('term.kind')}</span>{' '}
      <strong class="term__name">{entry.data.term}</strong>
    </span>
    <span class="term__short">{entry.data.short}</span>
    <a class="term__link" href={href}>
      {contentT(Astro.locals)('term.seeGlossary')}
    </a>
  </span>
</span>

<script>
  // With a mouse: open on hover and close on leave. With keyboard, touch screen or a click,
  // the button opens the popover, and Esc or tapping outside closes it: the mouse no longer closes it on leave.
  if (window.matchMedia('(hover: hover)').matches) {
    for (const term of document.querySelectorAll<HTMLElement>('.term')) {
      const popover = term.querySelector<HTMLElement>('[popover]');
      const trigger = term.querySelector<HTMLElement>('.term__trigger');
      if (!popover || !trigger) continue;
      let closeTimer: number | undefined;
      let openedByHover = false;
      popover.addEventListener('toggle', (event) => {
        if ((event as ToggleEvent).newState === 'closed') openedByHover = false;
      });
      // A click (or Enter) on the term leaves it open, even if it had opened on hover.
      trigger.addEventListener('click', () => {
        openedByHover = false;
      });
      term.addEventListener('mouseenter', () => {
        window.clearTimeout(closeTimer);
        if (popover.matches(':popover-open')) return;
        popover.showPopover();
        openedByHover = true;
      });
      term.addEventListener('mouseleave', () => {
        if (!openedByHover) return;
        // Margin to move the mouse from the term to the definition without it closing.
        closeTimer = window.setTimeout(() => popover.hidePopover(), 200);
      });
    }
  }
</script>

<style>
  .term__trigger {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: help;
    text-decoration: underline wavy var(--ide-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .term__trigger:focus-visible {
    outline: 2px solid var(--ide-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  /* Like an IDE's info box: header, definition and footer. */
  .term__popover {
    max-width: min(24rem, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
    color: var(--ide-text);
    box-shadow: var(--sl-shadow-lg);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    /* The box lives inside the paragraph: it must not inherit its bold, italic or uppercase. */
    font-weight: 400;
    font-style: normal;
    text-transform: none;
    letter-spacing: normal;
  }
  .term__popover:popover-open {
    display: flex;
    flex-direction: column;
  }
  .term__header,
  .term__short,
  .term__link {
    padding: 0.625rem 0.875rem;
  }
  .term__header {
    border-bottom: 1px solid var(--ide-border);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .term__kind {
    color: var(--ide-keyword);
  }
  .term__name {
    color: var(--ide-strong);
  }
  .term__link {
    border-top: 1px solid var(--ide-border);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--ide-accent);
  }
  @supports (position-area: block-end) {
    .term__popover {
      inset: auto;
      margin: 0.375rem 0;
      position-area: block-end span-inline-end;
      position-try-fallbacks: flip-block, flip-inline;
    }
    /* On narrow screens, the definition takes the full width instead of a column next to the term. */
    @media (max-width: 40rem) {
      .term__popover {
        position-area: block-end span-all;
        position-try-fallbacks: flip-block;
        justify-self: stretch;
        max-width: none;
        margin-inline: 1rem;
      }
    }
  }
</style>
