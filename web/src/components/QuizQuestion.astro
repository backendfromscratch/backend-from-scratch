---
import { contentT } from '~/lib/content-i18n';
import { reviewLink } from '~/lib/quiz';

interface Props {
  question: string;
  /** The text of the heading of this page that explains it: the score sends there whoever fails it. */
  review: string;
}

// One question of a <Quiz>, with its <QuizOption>s. The answer is checked with a button and
// not on choosing: with the keyboard, the arrows move through the options and would choose them.
const { question, review } = Astro.props;
const link = reviewLink(review, Astro.locals.starlightRoute.headings);
const t = contentT(Astro.locals);
---

<div class="quiz__question" data-review-href={link.href} data-review-text={link.text}>
  <fieldset>
    <legend>{question}</legend>
    <div class="quiz__options">
      <slot />
    </div>
    <div class="quiz__actions">
      <button type="button" class="quiz__check">
        {t('quiz.check')}
      </button>
      <p class="quiz__verdict" role="status"></p>
    </div>
  </fieldset>
</div>

<style>
  /* Like an entry in an editor's problems panel, as <SelfCheck>. */
  .quiz__question {
    counter-increment: quiz;
    margin-block: 0.75rem;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
    font-weight: 600;
    color: var(--ide-strong);
    /* A long error code (`ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX`) would push the page sideways on a phone. */
    overflow-wrap: anywhere;
  }
  legend::before {
    content: counter(quiz) '. ';
    font-family: var(--__sl-font-mono);
    color: var(--ide-accent);
  }
  fieldset > .quiz__options,
  fieldset > .quiz__actions {
    margin-top: 0.75rem;
  }
  .quiz__options {
    display: grid;
    gap: 0.5rem;
  }
  .quiz__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .quiz__check {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--ide-accent);
    border-radius: 0.25rem;
    background: var(--ide-accent);
    color: var(--ide-on-accent);
    font: inherit;
    cursor: pointer;
  }
  .quiz__check[hidden] {
    display: none;
  }
  .quiz__verdict {
    margin: 0;
    font-weight: 600;
    color: var(--ide-strong);
  }
</style>
