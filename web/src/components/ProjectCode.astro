---
/**
 * A file of a guided project (projects/), whole or one region, as a code block with its path
 * as the title. The code is the code CI runs: never copy it into the lesson by hand.
 * <ProjectCode file="tienda-api/04-servidor-http/src/app.ts" region="rutas" />
 */
import { Code } from '@astrojs/starlight/components';
import { extractRegion, languageOf, readProjectFile } from '~/lib/snippet';

interface Props {
  /** The path inside projects/: the project, the step and the file. */
  file: string;
  /** The region, `// #region name`; without it, the whole file. */
  region?: string;
  /** Lines to highlight, as Expressive Code's `mark`. */
  mark?: string | number | (string | number)[];
}

const { file, region, mark } = Astro.props;
const code = extractRegion(readProjectFile(file), region);
// The title is the path inside the step, the way the reader sees it in their folder.
const title = file.split('/').slice(2).join('/');
---

<Code code={code} lang={languageOf(file)} title={title} mark={mark} />
