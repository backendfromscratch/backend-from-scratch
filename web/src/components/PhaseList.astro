---
import { getCollection } from 'astro:content';
import { phases } from '~/data/phases';
import { phaseFolderName } from '~/lib/explorer';
import { countLessons, isPhasePublished } from '~/lib/lessons';
import { localizedHref } from '~/lib/links';
import { toLocale } from '~/lib/locales';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const t = Astro.locals.t;
// Una fase y sus lecciones cuentan en este idioma solo si existen en él (las copias de respaldo se borran).
const ids = (await getCollection('docs')).map((entry) => entry.id);
---

<ul class="phase-list not-content" role="list">
  {phases.map((phase) => {
    const available = isPhasePublished(ids, locale, phase);
    const name = phaseFolderName(locale, phase.number);
    return (
      <li class:list={['phase', { 'phase--soon': !available }]}>
        <p class="phase__line">
          <span class="phase__check" aria-hidden="true" data-pagefind-ignore>
            {available ? '- [x]' : '- [ ]'}
          </span>
          {available ? (
            <a href={localizedHref(locale, name)}>{name}</a>
          ) : (
            <span class="phase__name">{name}</span>
          )}
          <span class="phase__title">{phase.title[locale]}</span>
          {available && phase.lessonCount && (
            <span class="phase__count">
              <span aria-hidden="true" data-pagefind-ignore>
                //
              </span>{' '}
              {t('phase.lessons', {
                published: countLessons(ids, locale, phase.number),
                total: phase.lessonCount,
              })}
            </span>
          )}
          {!available && <span class="sr-only">({t('phase.comingSoon')})</span>}
        </p>
        <p class="phase__summary">{phase.summary[locale]}</p>
      </li>
    );
  })}
</ul>

<style>
  .phase-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: var(--__sl-font-mono);
  }
  .phase__line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .phase__check {
    color: var(--ide-keyword);
  }
  .phase__line a {
    color: var(--ide-accent);
  }
  .phase__title {
    color: var(--ide-strong);
  }
  .phase__count {
    color: var(--ide-string);
  }
  .phase--soon .phase__name,
  .phase--soon .phase__title,
  .phase--soon .phase__check {
    color: var(--ide-muted);
  }
  .phase__summary {
    margin: 0.25rem 0 0 3.25rem;
    font-family: var(--__sl-font);
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
  }
</style>
