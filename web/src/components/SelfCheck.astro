---
import { contentT } from '~/lib/content-i18n';
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="self-check">
  <summary>
    <span class="self-check__icon" aria-hidden="true">
      ?
    </span>
    <span class="self-check__question">{question}</span>
    <span class="self-check__hint">{contentT(Astro.locals)('selfCheck.show')}</span>
  </summary>
  <div class="self-check__answer">
    <slot />
  </div>
</details>

<style>
  /* Like an entry in an editor's problems panel. */
  .self-check {
    margin-block: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
  }
  .self-check summary {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    cursor: pointer;
  }
  /* Starlight draws an arrow in summary::before; here the «?» icon replaces it. */
  .self-check summary::before {
    display: none;
  }
  .self-check__icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ide-accent);
    color: var(--ide-on-accent);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    font-weight: 700;
  }
  .self-check__question {
    /* Long words like ERR_CONNECTION_REFUSED must not push the hint off the screen. */
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 600;
    color: var(--ide-strong);
  }
  .self-check__hint {
    margin-inline-start: auto;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    color: var(--ide-accent);
  }
  .self-check[open] .self-check__hint {
    display: none;
  }
  .self-check__answer {
    margin-top: 0.75rem;
  }
</style>
