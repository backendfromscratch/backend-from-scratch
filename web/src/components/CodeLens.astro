---
interface Props {
  href: string;
  /** Lo que «se ejecuta», como un fichero: p. ej. «fase-0/00-introduccion.md». */
  label: string;
  /** Nombre real del destino para el lector de pantalla, p. ej. «la introducción de la Fase 0». */
  name: string;
}
const { href, label, name } = Astro.props;
const action = Astro.locals.t('codeLens.run');
---

<a class="code-lens not-content" href={href} aria-label={`${action} ${name}`}>
  <span aria-hidden="true">▶ {action} </span>
  <span class="code-lens__target" aria-hidden="true">
    {label}
  </span>
</a>

<style>
  .code-lens {
    display: inline-flex;
    gap: 0.25rem;
    margin-block: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
    text-decoration: none;
  }
  .code-lens:hover {
    border-color: var(--ide-accent);
  }
  .code-lens__target {
    color: var(--ide-accent);
  }
</style>
