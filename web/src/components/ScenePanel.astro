---
/**
 * The scene column of a scene lesson (docs/specs/2026-11-20-visual-lessons-design.md): the bar with
 * the scene's name and its controls, the stage with the lesson's worlds, the instrument under it and
 * the line that changes the text's width. Rendered by TwoColumnContent.astro after <main>, so the
 * text comes first in the HTML; CSS puts the scene on the left (or on top, on a phone).
 * The stage is decorative (aria-hidden): the text says everything. The controls are real buttons.
 */
import { contentT } from '~/lib/content-i18n';
import { toLocale } from '~/lib/locales';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { LessonModule } from '~/scenes/core/types';
import Apps from '~/scenes/worlds/apps/Apps.astro';
import Crypto from '~/scenes/worlds/crypto/Crypto.astro';
import Hosts from '~/scenes/worlds/hosts/Hosts.astro';
import Layers from '~/scenes/worlds/layers/Layers.astro';
import Names from '~/scenes/worlds/names/Names.astro';
import Nat from '~/scenes/worlds/nat/Nat.astro';
import Protocol from '~/scenes/worlds/protocol/Protocol.astro';
import Network from '~/scenes/worlds/network/Network.astro';
import TimeBar from '~/scenes/worlds/network/TimeBar.astro';
import Restaurant from '~/scenes/worlds/restaurant/Restaurant.astro';
import Town from '~/scenes/worlds/town/Town.astro';
import Transport from '~/scenes/worlds/transport/Transport.astro';

interface Props {
  /** The lesson's translationKey: its module is src/scenes/lessons/<lesson>.ts. */
  lesson: string;
}

const modules = import.meta.glob<{ default: LessonModule<unknown> }>('../scenes/lessons/*.ts', {
  eager: true,
});
const lesson = modules[`../scenes/lessons/${Astro.props.lesson}.ts`]?.default;
if (!lesson)
  throw new Error(`[ScenePanel] There is no src/scenes/lessons/${Astro.props.lesson}.ts`);
// Each lesson's client entry (its <script>, which imports its choreography and starts the engine) is
// its own component: only the page that renders it bundles it.
const entries = import.meta.glob<{ default: AstroComponentFactory }>('../scenes/lessons/*.astro', {
  eager: true,
});
const Entry = entries[`../scenes/lessons/${Astro.props.lesson}.astro`]?.default;
if (!Entry)
  throw new Error(`[ScenePanel] There is no src/scenes/lessons/${Astro.props.lesson}.astro`);
const worlds = new Set(lesson.worlds.map((world) => world.id));
const lang = toLocale(Astro.locals.starlightRoute.locale);
const t = contentT(Astro.locals);
const first = lesson.scenes[0]!;
const speedNames = {
  slow: t('scenes.speedSlow'),
  normal: t('scenes.speedNormal'),
  fast: t('scenes.speedFast'),
};
const strings = {
  pause: t('scenes.pause'),
  resume: t('scenes.resume'),
  replay: t('scenes.replay'),
  speed: t('scenes.speed'),
  speeds: speedNames,
  splitValue: t('scenes.splitValue'),
  fold: t('scenes.fold'),
  unfold: t('scenes.unfold'),
  paused: t('scenes.paused'),
  dot: t('scenes.dot'),
};
---

<aside
  class="scene-panel print:hidden"
  aria-label={t('scenes.label')}
  data-scenes={Astro.props.lesson}
  data-lang={lang}
  data-strings={JSON.stringify(strings)}
  data-pagefind-ignore
>
  <div class="scene-bar">
    <div class="scene-bar__title">
      <span class="scene-chip" id="scene-chip" data-kind={first.kind}>
        {first.chip[lang]}
      </span>
      <span class="scene-bar__name" id="scene-title">
        {first.title[lang]}
      </span>
    </div>
    <div class="scene-dots" id="scene-dots" role="group" aria-label={t('scenes.label')}></div>
    <span class="scene-count" id="scene-count" aria-hidden="true">
      1/{lesson.scenes.length}
    </span>
    <div class="scene-ctrl">
      <button
        type="button"
        id="scene-prev"
        aria-label={t('scenes.prev')}
        title={t('scenes.prev')}
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M15 6l-6 6 6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        id="scene-play"
        data-state="ended"
        aria-label={t('scenes.replay')}
        title={t('scenes.replay')}
      >
        <svg class="scene-ic-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8.5 5.5v13M15.5 5.5v13"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg class="scene-ic-play" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8 5.8v12.4l10-6.2z"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          ></path>
        </svg>
        <svg class="scene-ic-replay" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
          <path
            d="M4 4.5v4.2h4.2"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button type="button" id="scene-next" aria-label={t('scenes.next')} title={t('scenes.next')}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M9 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button type="button" class="scene-speed" id="scene-speed">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4.5 16.5a7.5 7.5 0 1 1 15 0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
          <path
            d="M12 16.5l3.8-4.6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
          <circle cx="12" cy="16.5" r="1.6" fill="currentColor"></circle>
        </svg>
        <span>{speedNames.normal}</span>
      </button>
      <button
        type="button"
        class="scene-fold"
        id="scene-fold"
        aria-expanded="true"
        aria-label={t('scenes.fold')}
        title={t('scenes.fold')}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6 15l6-6 6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="scene-stage" data-view={first.view} aria-hidden="true">
    <svg class="scene-wires" aria-hidden="true">
      <defs>
        {(['dns', 'tcp', 'tls', 'http', 'muted'] as const).map((kind) => (
          <marker
            id={`scene-mk-${kind}`}
            data-kind={kind}
            viewBox="0 0 10 10"
            refX="8.5"
            refY="5"
            markerWidth="6.5"
            markerHeight="6.5"
            orient="auto"
          >
            <path class="scene-marker" d="M0 0L10 5L0 10z" />
          </marker>
        ))}
      </defs>
      <g data-wires="links"></g>
      <g data-wires="tube"></g>
      <g data-wires="trails"></g>
    </svg>
    <div class="scene-board">
      {worlds.has('network') && <Network lang={lang} />}
      {worlds.has('town') && <Town lang={lang} />}
      {worlds.has('apps') && <Apps lang={lang} />}
      {worlds.has('restaurant') && <Restaurant lang={lang} />}
      {worlds.has('crypto') && <Crypto lang={lang} />}
      {worlds.has('hosts') && <Hosts lang={lang} />}
      {worlds.has('protocol') && <Protocol lang={lang} />}
      {worlds.has('layers') && <Layers lang={lang} />}
      {worlds.has('names') && <Names lang={lang} />}
      {worlds.has('nat') && <Nat lang={lang} />}
      {worlds.has('transport') && <Transport lang={lang} />}
    </div>
    <div class="scene-layout"></div>
    <div class="scene-fx"></div>
    <p class="scene-caption"></p>
  </div>

  {lesson.instrument?.name === 'timebar' && <TimeBar lang={lang} />}

  <div
    class="scene-sash"
    role="separator"
    aria-orientation="vertical"
    aria-label={t('scenes.split')}
    aria-valuenow="40"
    aria-valuemin="25"
    aria-valuemax="70"
    tabindex="0"
    title={t('scenes.splitHint')}
  >
    <span class="scene-sash__grip" aria-hidden="true"></span>
  </div>
</aside>

<Entry />

<!-- Without JavaScript nothing would move: the lesson is the text alone, as any other. -->
<noscript>
  <style is:inline>
    .main-pane.main-pane--scenes {
      display: block;
    }
    .scene-panel {
      display: none !important;
    }
  </style>
</noscript>
