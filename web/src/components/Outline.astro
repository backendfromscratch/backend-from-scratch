---
/**
 * The page outline: the ESQUEMA section of the explorer (Sidebar.astro). On desktop it replaces
 * Starlight's table of contents, which marks the section crossing a fixed strip under the
 * header; here that strip ends up below the pinned tabs, and jumping to a section marked the
 * previous one. This one marks the last section whose heading has already reached where a jump
 * lands (scroll-padding-top, in theme.css). The logic, with tests: src/lib/outline.ts.
 */
import { flattenOutline } from '~/lib/outline';

const { toc } = Astro.locals.starlightRoute;
const items = toc ? flattenOutline(toc.items) : [];
---

{items.length > 0 && (
  <ide-outline>
    <nav aria-label={Astro.locals.t('tableOfContents.onThisPage')}>
      <ul class="ide-outline__list" role="list">
        {items.map((item) => (
          <li>
            <a class="ide-outline__link" href={`#${item.slug}`} data-depth={item.mark.length}>
              <span class="ide-outline__mark" aria-hidden="true">
                {item.mark}
              </span>
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </ide-outline>
)}

<script>
  import { revealScrollTop } from '~/lib/explorer';
  import { currentSection } from '~/lib/outline';

  /** The reading line: where a jump to an anchor lands, with a little margin. */
  const readingLine = () =>
    parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 8 || 0;

  class IdeOutline extends HTMLElement {
    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      const headings = links.map((link) =>
        document.getElementById(decodeURIComponent(link.hash.slice(1))),
      );
      // The section just jumped to (click in the outline or URL with #): at the end of the
      // page its heading never scrolls up, so we need to know which one it was.
      const indexOfHash = () => links.findIndex((link) => link.hash === window.location.hash);
      let jumpTarget = indexOfHash();
      // The outline section that scrolls (Sidebar.astro): when the mark changes, it shows it.
      const scroller = this.closest<HTMLElement>('.ide-section');
      let shown = -1;
      const reveal = (link: HTMLElement) => {
        if (!scroller) return;
        const top =
          link.getBoundingClientRect().top -
          scroller.getBoundingClientRect().top +
          scroller.scrollTop;
        scroller.scrollTop = revealScrollTop(
          { scrollTop: scroller.scrollTop, height: scroller.clientHeight },
          { top, height: link.offsetHeight },
        );
      };
      let frame = 0;
      const update = () => {
        frame = 0;
        const tops = headings.map((heading) => heading?.getBoundingClientRect().top ?? Infinity);
        const page = document.documentElement;
        const atBottom =
          window.scrollY > 0 && window.scrollY + window.innerHeight >= page.scrollHeight - 2;
        const jump = { target: jumpTarget, viewHeight: window.innerHeight };
        const index = currentSection(tops, readingLine(), atBottom, jump);
        links.forEach((link, i) => {
          if (i === index) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        const marked = links[index];
        if (index !== shown && marked) {
          shown = index;
          reveal(marked);
        }
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      links.forEach((link, i) =>
        link.addEventListener('click', () => {
          jumpTarget = i;
          schedule();
        }),
      );
      // Collapsed, the outline cannot scroll: when opened, it shows the marked section.
      scroller?.addEventListener('toggle', () => {
        shown = -1;
        schedule();
      });
      window.addEventListener('hashchange', () => {
        jumpTarget = indexOfHash();
        schedule();
      });
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  }
  customElements.define('ide-outline', IdeOutline);
</script>

<style>
  .ide-outline__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ide-outline__link {
    display: block;
    padding: 0.2rem 0.75rem 0.2rem 1.75rem;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    color: var(--ide-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ide-outline__link[data-depth='3'] {
    padding-inline-start: 2.75rem;
  }
  .ide-outline__link:hover {
    background: var(--ide-selection);
    color: var(--ide-strong);
  }
  .ide-outline__link[aria-current='true'] {
    color: var(--ide-accent);
  }
  .ide-outline__mark {
    margin-inline-end: 0.5ch;
    color: var(--ide-keyword);
  }
</style>
