---
/**
 * The list on the playgrounds page, one phase at a time: each piece with its level, a sentence and a
 * link to the «Pruébalo» of its lesson. The data: src/data/playgrounds.ts.
 */
import { getCollection } from 'astro:content';
import { playgrounds } from '~/data/playgrounds';
import { fileNameFor, phaseFolderName } from '~/lib/explorer';
import { toLocale, type Locale } from '~/lib/locales';
import { urlOfId } from '~/lib/translations';
import { getTranslationIndex } from '~/lib/translations-astro';

interface Props {
  phase: number;
}

/** The id of the «Pruébalo» heading of each lesson, where its playground always is. */
const TRY_IT_ID: Record<Locale, string> = { es: 'pruébalo', en: 'try-it' };

const { phase } = Astro.props;
const route = Astro.locals.starlightRoute;
const locale = toLocale(route.locale);
const t = Astro.locals.t;
const index = await getTranslationIndex();
const docs = await getCollection('docs');

const items = playgrounds
  .filter((playground) => playground.phase === phase)
  .map((playground) => {
    const pageId = index.byKey.get(playground.lesson)?.[locale];
    const entry = docs.find((doc) => doc.id === pageId);
    if (!pageId || !entry) {
      throw new Error(
        `[playgrounds] «${playground.id}»: cannot find the lesson «${playground.lesson}» in «${locale}»`,
      );
    }
    const href = urlOfId(pageId);
    const label = entry.data.sidebar.label ?? entry.data.title;
    return {
      ...playground,
      href: `${href}#${TRY_IT_ID[locale]}`,
      file: fileNameFor(route.sidebar, [phaseFolderName(locale, phase)], { href, label }),
    };
  });
---

<ul class="playground-list not-content" role="list">
  {items.map((item) => (
    <li class="playground">
      <p class="playground__line">
        <span class="playground__mark" aria-hidden="true" data-pagefind-ignore>
          ▶
        </span>
        <a href={item.href}>{item.title[locale]}</a>
        <span class="playground__level">
          <span aria-hidden="true" data-pagefind-ignore>
            //
          </span>{' '}
          {t(item.level === 'lab' ? 'playgrounds.lab' : 'playgrounds.playground')}
        </span>
      </p>
      <p class="playground__summary">{item.summary[locale]}</p>
      <p class="playground__lesson">{t('playgrounds.inLesson', { file: item.file })}</p>
    </li>
  ))}
</ul>

<style>
  .playground-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--__sl-font-mono);
  }
  .playground__line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--sl-text-base);
  }
  .playground__mark {
    color: var(--ide-string);
  }
  .playground__line a {
    color: var(--ide-accent);
  }
  .playground__level {
    font-size: var(--sl-text-sm);
    color: var(--ide-comment);
  }
  .playground__summary,
  .playground__lesson {
    margin: 0.25rem 0 0 1.75rem;
  }
  .playground__summary {
    font-family: var(--__sl-font);
    font-size: var(--sl-text-base);
    color: var(--ide-text);
  }
  .playground__lesson {
    font-size: var(--sl-text-xs);
    color: var(--ide-muted);
  }
</style>
