---
import { contentT } from '~/lib/content-i18n';

interface Props {
  /** The answer, as the reader chooses it. */
  text: string;
  /** The right one. Exactly one per question. */
  correct?: boolean;
}

// One answer of a <QuizQuestion>. The slot explains why it is right or wrong: it is shown
// after checking, for the chosen answer and for the right one. The radio button gets its
// group name from the script in Quiz.astro.
const { text, correct = false } = Astro.props;
const t = contentT(Astro.locals);
---

<div class="quiz__option" data-correct={correct ? '' : undefined}>
  <label class="quiz__choice">
    <input type="radio" />
    <span class="quiz__text">{text}</span>
    <span class="quiz__mark quiz__mark--right" hidden>
      {t('quiz.rightAnswer')}
    </span>
    <span class="quiz__mark quiz__mark--yours" hidden>
      {t('quiz.yourAnswer')}
    </span>
  </label>
  <div class="quiz__why" hidden>
    <slot />
  </div>
</div>

<style>
  /* Two classes: Starlight's content styles separate siblings with a margin, and this wins. */
  :global(.quiz__options) > .quiz__option {
    margin: 0;
    border: 1px solid var(--ide-border);
    border-radius: 0.25rem;
    background: var(--ide-bg);
  }
  /* Chosen and not yet checked: after checking, the radio buttons are disabled. */
  .quiz__option:has(input:checked:not(:disabled)) {
    border-color: var(--ide-accent);
  }
  /* After checking: never only color, the marks say it in words too. */
  .quiz__option.is-right,
  .quiz__option.is-answer {
    border-color: var(--ide-string);
  }
  .quiz__option.is-wrong {
    border-color: var(--ide-accent);
  }
  .quiz__choice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }
  .quiz__choice:has(input:disabled) {
    cursor: default;
  }
  .quiz__choice input {
    flex-shrink: 0;
    accent-color: var(--ide-accent);
  }
  .quiz__text {
    flex: 1 1 12rem;
    min-width: 0;
  }
  .quiz__mark {
    /* When it does not fit next to the answer, it goes to the right on its own line. */
    margin-inline-start: auto;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .quiz__mark[hidden] {
    display: none;
  }
  .quiz__mark--right {
    color: var(--ide-string);
  }
  .quiz__mark--yours {
    color: var(--ide-accent);
  }
  .is-right .quiz__mark--yours {
    color: var(--ide-string);
  }
  .quiz__option > .quiz__why {
    margin: 0;
    padding: 0 0.75rem 0.5rem 2.25rem;
    color: var(--ide-text);
  }
  .quiz__why > :global(:first-child) {
    margin-top: 0;
  }
</style>
