---
/**
 * NAT diagram: how the home router rewrites a packet's addresses when it goes out to the
 * internet and undoes the change in the reply.
 *
 * It is HTML and CSS, not SVG, for the same reason as Encapsulation: on narrow screens the text
 * keeps its size, follows the theme colors and is read by screen readers. All
 * texts arrive through props, because each language passes its own.
 */
interface Step {
  /** The leg of the journey, e.g. «Tu portátil → router». */
  hop: string;
  /** Source IP address and port of the packet on this leg. */
  src: string;
  /** Destination IP address and port of the packet on this leg. */
  dst: string;
  /** The field the router has just rewritten, if any. */
  changed?: 'src' | 'dst';
  /** What happens on this leg. */
  note?: string;
}

interface Props {
  /** Figure caption. Explains how to read the diagram. */
  caption: string;
  /** Names of the two fields and the text of the rewritten-field mark. */
  labels: { src: string; dst: string; changed: string };
  /** The legs of the journey, in order. */
  steps: Step[];
  /** The translation table the router keeps. */
  table: { title: string; columns: [string, string]; rows: [string, string][] };
}

const { caption, labels, steps, table } = Astro.props;
const fields = ['src', 'dst'] as const;

/** Splits «IP:port» into two pieces, so the line only breaks after the colon. */
function splitPort(address: string): [string, string] {
  const colon = address.lastIndexOf(':');
  return colon === -1 ? [address, ''] : [address.slice(0, colon + 1), address.slice(colon + 1)];
}
---

<figure class="nat not-content">
  <ol class="nat__steps" role="list">
    {steps.map((step, index) => (
      <li class="nat__step">
        <p class="nat__hop">
          <span class="nat__index">{index + 1}</span>
          {step.hop}
        </p>
        <dl class="nat__fields">
          {fields.map((field) => (
            <div class:list={['nat__field', { 'nat__field--changed': step.changed === field }]}>
              <dt>{labels[field]}</dt>
              <dd>
                <code>
                  {splitPort(step[field])[0]}
                  <wbr />
                  {splitPort(step[field])[1]}
                </code>
                {step.changed === field && <span class="nat__badge">{labels.changed}</span>}
              </dd>
            </div>
          ))}
        </dl>
        {step.note && <p class="nat__note">{step.note}</p>}
      </li>
    ))}
  </ol>
  <table class="nat__table">
    <caption>{table.title}</caption>
    <thead>
      <tr>
        <th scope="col">{table.columns[0]}</th>
        <th scope="col">{table.columns[1]}</th>
      </tr>
    </thead>
    <tbody>
      {table.rows.map(([outside, inside]) => (
        <tr>
          <td>
            <code>
              {splitPort(outside)[0]}
              <wbr />
              {splitPort(outside)[1]}
            </code>
          </td>
          <td>
            <code>
              {splitPort(inside)[0]}
              <wbr />
              {splitPort(inside)[1]}
            </code>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .nat {
    margin-block: 1.5rem;
    font-family: var(--__sl-font-mono, var(--sl-font-system-mono));
  }
  .nat__steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each leg is a card; between one and the next, a down arrow. */
  .nat__step {
    position: relative;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
  }
  .nat__step + .nat__step::before {
    content: '↓' / '';
    position: absolute;
    /* In the middle of the gap between cards (half of `gap`). */
    inset-block-start: -0.375rem;
    inset-inline-start: 1.25rem;
    transform: translateY(-50%);
    line-height: 1;
    font-size: var(--sl-text-xs);
    color: var(--ide-gutter);
  }
  .nat__hop {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ide-strong);
  }
  .nat__index {
    color: var(--ide-keyword);
  }
  .nat__fields {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }
  .nat__field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.125rem;
    padding-inline-start: 0.625rem;
    border-inline-start: 2px solid transparent;
  }
  /* The rewritten field: border and text label, so it does not depend on color alone. */
  .nat__field--changed {
    border-inline-start-color: var(--ide-accent);
  }
  .nat__field dt {
    min-width: 4.5rem;
    font-size: var(--sl-text-xs);
    color: var(--ide-muted);
  }
  .nat__field dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .nat code {
    font-family: inherit;
    font-size: var(--sl-text-sm);
    color: var(--ide-strong);
    /* It breaks at the <wbr> after the colon; in the middle of a number, only as a last resort. */
    overflow-wrap: break-word;
  }
  .nat__field--changed code {
    color: var(--ide-accent);
    font-weight: 600;
  }
  .nat__badge {
    padding: 0 0.375rem;
    border: 1px solid var(--ide-accent);
    border-radius: 0.25rem;
    font-size: var(--sl-text-2xs);
    color: var(--ide-accent);
  }
  .nat__note {
    margin: 0.5rem 0 0;
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--ide-text);
  }
  .nat__table {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .nat__table caption {
    margin-bottom: 0.5rem;
    text-align: start;
    font-weight: 600;
    color: var(--ide-strong);
  }
  .nat__table th,
  .nat__table td {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--ide-border);
    text-align: start;
    vertical-align: top;
  }
  .nat__table th {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--ide-muted);
    background: var(--ide-chrome);
  }
  /* Here they can break: a whole «IP:port» does not fit in two columns at 375 px. */
  .nat__table td code {
    white-space: normal;
  }
  figcaption {
    margin-top: 0.75rem;
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
  }
</style>
