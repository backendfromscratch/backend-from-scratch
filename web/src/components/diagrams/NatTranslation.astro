---
/**
 * Diagrama de NAT: cómo el router de casa reescribe las direcciones de un paquete al salir a
 * internet y deshace el cambio en la respuesta.
 *
 * Es HTML y CSS, no SVG, por lo mismo que Encapsulation: en pantallas estrechas el texto
 * conserva su tamaño, sigue los colores del tema y lo leen los lectores de pantalla. Todos los
 * textos llegan por props, porque cada idioma pasa los suyos.
 */
interface Step {
  /** El tramo del viaje, p. ej. «Tu portátil → router». */
  hop: string;
  /** Dirección IP y puerto de origen del paquete en este tramo. */
  src: string;
  /** Dirección IP y puerto de destino del paquete en este tramo. */
  dst: string;
  /** El campo que el router acaba de reescribir, si lo hay. */
  changed?: 'src' | 'dst';
  /** Qué ocurre en este tramo. */
  note?: string;
}

interface Props {
  /** Pie de la figura. Explica cómo leer el diagrama. */
  caption: string;
  /** Nombres de los dos campos y texto de la marca del campo reescrito. */
  labels: { src: string; dst: string; changed: string };
  /** Los tramos del viaje, en orden. */
  steps: Step[];
  /** La tabla de traducciones que guarda el router. */
  table: { title: string; columns: [string, string]; rows: [string, string][] };
}

const { caption, labels, steps, table } = Astro.props;
const fields = ['src', 'dst'] as const;

/** Separa «IP:puerto» en dos trozos, para que la línea solo se parta después de los dos puntos. */
function splitPort(address: string): [string, string] {
  const colon = address.lastIndexOf(':');
  return colon === -1 ? [address, ''] : [address.slice(0, colon + 1), address.slice(colon + 1)];
}
---

<figure class="nat not-content">
  <ol class="nat__steps" role="list">
    {steps.map((step, index) => (
      <li class="nat__step">
        <p class="nat__hop">
          <span class="nat__index">{index + 1}</span>
          {step.hop}
        </p>
        <dl class="nat__fields">
          {fields.map((field) => (
            <div class:list={['nat__field', { 'nat__field--changed': step.changed === field }]}>
              <dt>{labels[field]}</dt>
              <dd>
                <code>
                  {splitPort(step[field])[0]}
                  <wbr />
                  {splitPort(step[field])[1]}
                </code>
                {step.changed === field && <span class="nat__badge">{labels.changed}</span>}
              </dd>
            </div>
          ))}
        </dl>
        {step.note && <p class="nat__note">{step.note}</p>}
      </li>
    ))}
  </ol>
  <table class="nat__table">
    <caption>{table.title}</caption>
    <thead>
      <tr>
        <th scope="col">{table.columns[0]}</th>
        <th scope="col">{table.columns[1]}</th>
      </tr>
    </thead>
    <tbody>
      {table.rows.map(([outside, inside]) => (
        <tr>
          <td>
            <code>
              {splitPort(outside)[0]}
              <wbr />
              {splitPort(outside)[1]}
            </code>
          </td>
          <td>
            <code>
              {splitPort(inside)[0]}
              <wbr />
              {splitPort(inside)[1]}
            </code>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .nat {
    margin-block: 1.5rem;
    font-family: var(--__sl-font-mono, var(--sl-font-system-mono));
  }
  .nat__steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Cada tramo es una tarjeta; entre una y la siguiente, una flecha hacia abajo. */
  .nat__step {
    position: relative;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
  }
  .nat__step + .nat__step::before {
    content: '↓' / '';
    position: absolute;
    /* En medio del hueco entre tarjetas (la mitad de `gap`). */
    inset-block-start: -0.375rem;
    inset-inline-start: 1.25rem;
    transform: translateY(-50%);
    line-height: 1;
    font-size: var(--sl-text-xs);
    color: var(--ide-gutter);
  }
  .nat__hop {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ide-strong);
  }
  .nat__index {
    color: var(--ide-keyword);
  }
  .nat__fields {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }
  .nat__field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.125rem;
    padding-inline-start: 0.625rem;
    border-inline-start: 2px solid transparent;
  }
  /* El campo reescrito: borde y etiqueta de texto, para que no dependa solo del color. */
  .nat__field--changed {
    border-inline-start-color: var(--ide-accent);
  }
  .nat__field dt {
    min-width: 4.5rem;
    font-size: var(--sl-text-xs);
    color: var(--ide-muted);
  }
  .nat__field dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .nat code {
    font-family: inherit;
    font-size: var(--sl-text-sm);
    color: var(--ide-strong);
    /* Se parte por el <wbr> de después de los dos puntos; a mitad de un número, solo si no queda otra. */
    overflow-wrap: break-word;
  }
  .nat__field--changed code {
    color: var(--ide-accent);
    font-weight: 600;
  }
  .nat__badge {
    padding: 0 0.375rem;
    border: 1px solid var(--ide-accent);
    border-radius: 0.25rem;
    font-size: var(--sl-text-2xs);
    color: var(--ide-accent);
  }
  .nat__note {
    margin: 0.5rem 0 0;
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--ide-text);
  }
  .nat__table {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .nat__table caption {
    margin-bottom: 0.5rem;
    text-align: start;
    font-weight: 600;
    color: var(--ide-strong);
  }
  .nat__table th,
  .nat__table td {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--ide-border);
    text-align: start;
    vertical-align: top;
  }
  .nat__table th {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--ide-muted);
    background: var(--ide-chrome);
  }
  /* Aquí sí se pueden partir: «IP:puerto» entero no cabe en dos columnas a 375 px. */
  .nat__table td code {
    white-space: normal;
  }
  figcaption {
    margin-top: 0.75rem;
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
  }
</style>
