---
/**
 * Encapsulation diagram: how a message goes down the layers and each one adds its header.
 *
 * It is HTML and CSS (a grid), not SVG, so the text keeps its size on narrow screens,
 * follows the theme colors and is read by screen readers. All texts
 * arrive through props, because each language passes its own.
 */
interface Props {
  /** Figure caption. Explains how to read the diagram. */
  caption: string;
  /** Name of each layer and its data unit, e.g. «Transporte · segmento». */
  layers: {
    application: string;
    transport: string;
    network: string;
    link: string;
  };
  /** Text of each block. */
  blocks: {
    data: string;
    transportHeader: string;
    networkHeader: string;
    linkHeader: string;
    linkTrailer: string;
  };
}

const { caption, layers, blocks } = Astro.props;
---

<figure class="encapsulation not-content">
  <div class="encapsulation__grid">
    <p class="encapsulation__layer encapsulation__layer--application">{layers.application}</p>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--transport">{layers.transport}</p>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--network">{layers.network}</p>
    <span class="block block--network">{blocks.networkHeader}</span>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--link">{layers.link}</p>
    <span class="block block--link">{blocks.linkHeader}</span>
    <span class="block block--network">{blocks.networkHeader}</span>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>
    <span class="block block--link block--trailer">{blocks.linkTrailer}</span>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .encapsulation {
    margin-block: 1.5rem;
  }
  /*
   * Five fixed columns, one per possible block: link header, network header, transport header,
   * the data and the link trailer. Each layer takes the columns that belong to it, which is why the
   * blocks line up in a staircase.
   */
  .encapsulation__grid {
    display: grid;
    grid-template-columns: auto auto auto minmax(4.5rem, 1fr) auto;
    column-gap: 0.25rem;
    row-gap: 0.25rem;
    align-items: stretch;
  }
  .encapsulation__layer {
    grid-column: 1 / -1;
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ide-strong);
  }
  .encapsulation__layer:first-child {
    margin-top: 0;
  }
  .block {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid;
    border-radius: 0.375rem;
    font-family: var(--__sl-font-mono, var(--sl-font-system-mono));
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    text-align: center;
  }
  .block--data {
    grid-column: 4;
    background: color-mix(in srgb, var(--ide-keyword) 16%, var(--ide-bg));
    border-color: var(--ide-keyword);
    color: var(--ide-strong);
  }
  .block--transport {
    grid-column: 3;
    background: color-mix(in srgb, var(--ide-info) 16%, var(--ide-bg));
    border-color: var(--ide-info);
    color: var(--ide-strong);
  }
  .block--network {
    grid-column: 2;
    background: color-mix(in srgb, var(--ide-string) 16%, var(--ide-bg));
    border-color: var(--ide-string);
    color: var(--ide-strong);
  }
  .block--link {
    grid-column: 1;
    background: color-mix(in srgb, var(--ide-accent) 16%, var(--ide-bg));
    border-color: var(--ide-accent);
    color: var(--ide-strong);
  }
  .block--trailer {
    grid-column: 5;
  }
  /* On narrow screens, more compact blocks so the link row (five blocks) fits entirely. */
  @media (max-width: 40rem) {
    .encapsulation__grid {
      column-gap: 0.1875rem;
    }
    .block {
      padding-inline: 0.375rem;
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
  }
</style>
