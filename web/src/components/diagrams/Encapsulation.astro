---
/**
 * Diagrama de encapsulación: cómo un mensaje baja por las capas y cada una le añade su cabecera.
 *
 * Es HTML y CSS (una cuadrícula), no SVG, para que el texto conserve su tamaño en pantallas
 * estrechas, siga los colores del tema y lo lean los lectores de pantalla. Todos los textos
 * llegan por props, porque cada idioma pasa los suyos.
 */
interface Props {
  /** Pie de la figura. Explica cómo leer el diagrama. */
  caption: string;
  /** Nombre de cada capa y de su unidad de datos, p. ej. «Transporte · segmento». */
  layers: {
    application: string;
    transport: string;
    network: string;
    link: string;
  };
  /** Texto de cada bloque. */
  blocks: {
    data: string;
    transportHeader: string;
    networkHeader: string;
    linkHeader: string;
    linkTrailer: string;
  };
}

const { caption, layers, blocks } = Astro.props;
---

<figure class="encapsulation not-content">
  <div class="encapsulation__grid">
    <p class="encapsulation__layer encapsulation__layer--application">{layers.application}</p>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--transport">{layers.transport}</p>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--network">{layers.network}</p>
    <span class="block block--network">{blocks.networkHeader}</span>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>

    <p class="encapsulation__layer encapsulation__layer--link">{layers.link}</p>
    <span class="block block--link">{blocks.linkHeader}</span>
    <span class="block block--network">{blocks.networkHeader}</span>
    <span class="block block--transport">{blocks.transportHeader}</span>
    <span class="block block--data">{blocks.data}</span>
    <span class="block block--link block--trailer">{blocks.linkTrailer}</span>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .encapsulation {
    margin-block: 1.5rem;
  }
  /*
   * Cinco columnas fijas, una por bloque posible: cabecera de enlace, de red, de transporte,
   * los datos y la cola de enlace. Cada capa ocupa las columnas que le tocan, y por eso los
   * bloques quedan alineados en escalera.
   */
  .encapsulation__grid {
    display: grid;
    grid-template-columns: auto auto auto minmax(4.5rem, 1fr) auto;
    column-gap: 0.25rem;
    row-gap: 0.25rem;
    align-items: stretch;
  }
  .encapsulation__layer {
    grid-column: 1 / -1;
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--ide-strong);
  }
  .encapsulation__layer:first-child {
    margin-top: 0;
  }
  .block {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid;
    border-radius: 0.375rem;
    font-family: var(--__sl-font-mono, var(--sl-font-system-mono));
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    text-align: center;
  }
  .block--data {
    grid-column: 4;
    background: color-mix(in srgb, var(--ide-keyword) 16%, var(--ide-bg));
    border-color: var(--ide-keyword);
    color: var(--ide-strong);
  }
  .block--transport {
    grid-column: 3;
    background: color-mix(in srgb, var(--ide-info) 16%, var(--ide-bg));
    border-color: var(--ide-info);
    color: var(--ide-strong);
  }
  .block--network {
    grid-column: 2;
    background: color-mix(in srgb, var(--ide-string) 16%, var(--ide-bg));
    border-color: var(--ide-string);
    color: var(--ide-strong);
  }
  .block--link {
    grid-column: 1;
    background: color-mix(in srgb, var(--ide-accent) 16%, var(--ide-bg));
    border-color: var(--ide-accent);
    color: var(--ide-strong);
  }
  .block--trailer {
    grid-column: 5;
  }
  /* En pantallas estrechas, bloques más compactos para que la fila de enlace (cinco bloques) quepa entera. */
  @media (max-width: 40rem) {
    .encapsulation__grid {
      column-gap: 0.1875rem;
    }
    .block {
      padding-inline: 0.375rem;
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--ide-muted);
  }
</style>
