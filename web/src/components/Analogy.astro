---
import { contentT } from '~/lib/content-i18n';
interface Props {
  title?: string;
}

const { title } = Astro.props;
const t = contentT(Astro.locals);
const heading = title ?? t('analogy.title');

if (!Astro.slots.has('limits')) {
  throw new Error(
    '[Analogy] Falta el apartado «dónde falla la analogía» (<div slot="limits">…</div>, con líneas en blanco alrededor del contenido). Una analogía sin límites enseña cosas falsas.',
  );
}
---

<section class="analogy" aria-label={heading}>
  <p class="analogy__title">
    <span aria-hidden="true">/* </span>
    {heading}
    <span aria-hidden="true"> */</span>
  </p>
  <slot />
  <div class="analogy__limits">
    <p class="analogy__label">
      <span aria-hidden="true">// </span>
      {t('analogy.limits')}
    </p>
    <slot name="limits" />
  </div>
</section>

<style>
  .analogy {
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
  }
  .analogy__title,
  .analogy__label {
    margin: 0 0 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--ide-comment);
  }
  .analogy__limits {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--ide-border);
    color: var(--ide-muted);
  }
</style>
