---
import { contentT } from '~/lib/content-i18n';
import { acronymParts, type Acronym } from '~/lib/glossary';
import { toLocale } from '~/lib/locales';

interface Props {
  acronym: Acronym;
  class?: string;
}

// What the letters of a glossary term stand for («API viene del inglés Application Programming
// Interface…»), in the popover of <Term> and on the glossary page. On a Spanish page the English
// words carry lang="en", so a screen reader pronounces them in English.
const { acronym, class: className } = Astro.props;
const t = contentT(Astro.locals);
const locale = toLocale(Astro.locals.starlightRoute.entryMeta.locale);
const parts = acronymParts(
  acronym,
  { plain: t('acronym.plain'), translated: t('acronym.translated') },
  locale !== 'en',
);
---

<span class={className}>
  {parts.map((part) => (part.foreign ? <i lang="en">{part.text}</i> : part.text))}
</span>
