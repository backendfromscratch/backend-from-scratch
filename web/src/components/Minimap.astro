---
/**
 * The minimap: the page in miniature to the right of the editor, only from 82rem. Like VS Code's in
 * its default mode: each word is a stroke (headings in purple and code in green), at a fixed
 * scale, and if the page does not fit, the minimap slides along with it. The rectangle marks what
 * is visible; on click, the page jumps there, and on drag, the rectangle follows the pointer.
 *
 * It is drawn in a <canvas>: it does not repeat the text in the page (neither for Google nor for
 * screen readers) and weighs less than thousands of elements. For accessibility it is decorative:
 * the explorer's outline does the same with the keyboard. The logic, with tests: src/lib/minimap.ts.
 */
---

<div class="ide-minimap print:hidden" aria-hidden="true" data-pagefind-ignore>
  <canvas class="ide-minimap__canvas"></canvas>
  <div class="ide-minimap__view"></div>
</div>

<script>
  import {
    dragScroll,
    layoutStrokes,
    mapOffset,
    proportionalScale,
    scrollTargetFor,
    viewportRect,
    wordKind,
    type Word,
    type WordKind,
  } from '~/lib/minimap';

  const wide = matchMedia('(min-width: 82rem)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const map = document.querySelector<HTMLElement>('.ide-minimap');
  const canvas = map?.querySelector<HTMLCanvasElement>('.ide-minimap__canvas');
  const view = map?.querySelector<HTMLElement>('.ide-minimap__view');
  const content = document.querySelector<HTMLElement>('.sl-markdown-content');
  /** A taller canvas stops being drawn in some browsers. */
  const MAX_CANVAS_PX = 32_000;
  /** Text that has a box but is not visible: the kind only screen readers read. */
  const HIDDEN_TEXT = '.sr-only, script, style, template';
  let scale = 0;
  let offset = 0;

  const docHeight = () => document.documentElement.scrollHeight;

  /** What is drawn: the title, the lesson intro and the content (none repeated). */
  function roots(): HTMLElement[] {
    const all = [document.getElementById('_top'), document.querySelector('.lesson-intro'), content];
    const found = all.filter((el): el is HTMLElement => el instanceof HTMLElement);
    return found.filter((el) => !found.some((other) => other !== el && other.contains(el)));
  }

  /** Each visible word, with its box in document px (x from the content edge). */
  function measureWords(): Word[] {
    const left = (content ?? document.body).getBoundingClientRect().left;
    const range = document.createRange();
    const words: Word[] = [];
    for (const root of roots()) {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const text = node as Text;
        const parent = text.parentElement;
        if (!parent || parent.closest(HIDDEN_TEXT)) continue;
        const ancestors: Element[] = [];
        for (
          let el: Element | null = parent;
          el && el !== root.parentElement;
          el = el.parentElement
        ) {
          ancestors.push(el);
        }
        const kind = wordKind(ancestors);
        for (const match of text.data.matchAll(/\S+/g)) {
          range.setStart(text, match.index);
          range.setEnd(text, match.index + match[0].length);
          for (const rect of range.getClientRects()) {
            words.push({
              x: rect.left - left,
              y: rect.top + window.scrollY,
              width: rect.width,
              height: rect.height,
              kind,
            });
          }
        }
      }
    }
    return words;
  }

  /** The theme colors, read every time: they change when going from dark to light. */
  function palette(): Record<WordKind, string> {
    const style = getComputedStyle(document.documentElement);
    const token = (name: string) => style.getPropertyValue(name).trim();
    return {
      text: token('--ide-gutter'),
      heading: token('--ide-keyword'),
      code: token('--ide-string'),
    };
  }

  /** Positions the drawing (what has slid) and the rectangle of what is visible. */
  function place() {
    if (!map || !canvas || !view) return;
    offset = mapOffset(window.scrollY, window.innerHeight, docHeight(), scale, map.clientHeight);
    canvas.style.transform = `translateY(${-offset}px)`;
    const rect = viewportRect(window.scrollY, window.innerHeight, scale, offset);
    view.style.transform = `translateY(${rect.top}px)`;
    view.style.height = `${rect.height}px`;
  }

  function draw() {
    if (!map || !canvas || !wide.matches) return;
    const width = canvas.clientWidth;
    scale = proportionalScale(content?.clientWidth ?? 0, width);
    const height = Math.max(1, Math.ceil(docHeight() * scale));
    const ratio = Math.min(window.devicePixelRatio || 1, MAX_CANVAS_PX / height);
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);
    canvas.style.height = `${height}px`;
    const context = canvas.getContext('2d');
    if (context) {
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      const colors = palette();
      for (const stroke of layoutStrokes(measureWords(), scale)) {
        context.fillStyle = colors[stroke.kind];
        context.fillRect(stroke.x, stroke.y, stroke.width, stroke.height);
      }
    }
    place();
  }

  // When pressing outside the rectangle, the page jumps there; from that moment, dragging moves the
  // rectangle like a scroll bar.
  let drag: { startY: number; startScroll: number } | undefined;
  map?.addEventListener('pointerdown', (event) => {
    if (!view) return;
    map.setPointerCapture(event.pointerId);
    const rect = view.getBoundingClientRect();
    if (event.clientY >= rect.top && event.clientY <= rect.bottom) {
      drag = { startY: event.clientY, startScroll: window.scrollY };
      return;
    }
    const mapY = event.clientY - map.getBoundingClientRect().top;
    const top = scrollTargetFor(mapY, scale, window.innerHeight, docHeight(), offset);
    window.scrollTo({ top, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    drag = { startY: event.clientY, startScroll: top };
  });
  map?.addEventListener('pointermove', (event) => {
    if (!drag || !map.hasPointerCapture(event.pointerId)) return;
    const deltaY = event.clientY - drag.startY;
    window.scrollTo({
      top: dragScroll(
        drag.startScroll,
        deltaY,
        scale,
        window.innerHeight,
        docHeight(),
        map.clientHeight,
      ),
    });
  });
  const endDrag = () => {
    drag = undefined;
  };
  map?.addEventListener('pointerup', endDrag);
  map?.addEventListener('pointercancel', endDrag);

  let placeFrame = 0;
  window.addEventListener(
    'scroll',
    () => {
      if (placeFrame) return;
      placeFrame = requestAnimationFrame(() => {
        placeFrame = 0;
        place();
      });
    },
    { passive: true },
  );

  // It is redrawn if the page changes (a lab that mounts, a dropdown that
  // opens), the window, the theme or the font (when the web font loads, words change width).
  let drawFrame = 0;
  const redraw = () => {
    if (drawFrame) return;
    drawFrame = requestAnimationFrame(() => {
      drawFrame = 0;
      draw();
    });
  };
  if (content) new ResizeObserver(redraw).observe(content);
  window.addEventListener('resize', redraw);
  wide.addEventListener('change', redraw);
  new MutationObserver(redraw).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  document.fonts?.ready.then(redraw);
  draw();
</script>

<style is:global>
  .ide-minimap {
    display: none;
  }
  @media (min-width: 82rem) {
    .ide-minimap {
      position: fixed;
      z-index: 2;
      inset-block: calc(
          var(--sl-nav-height) + var(--ide-tabbar-height) + var(--ide-breadcrumbs-height)
        )
        var(--ide-statusbar-height);
      inset-inline-end: 0;
      display: block;
      width: var(--ide-minimap-width);
      overflow: hidden;
      background: var(--ide-bg);
      box-shadow: inset 1px 0 0 var(--ide-border);
      cursor: pointer;
      touch-action: none;
    }
  }
  /* The drawing: as tall as the page at scale; it slides with transform. */
  .ide-minimap__canvas {
    position: absolute;
    top: 0;
    left: 0.75rem;
    width: calc(100% - 1.5rem);
  }
  .ide-minimap__view {
    position: absolute;
    top: 0;
    inset-inline: 0;
    background: color-mix(in srgb, var(--ide-text) 8%, transparent);
  }
</style>
