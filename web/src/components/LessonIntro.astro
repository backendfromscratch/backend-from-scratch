---
import { contentT } from '~/lib/content-i18n';
import { getEntry, type CollectionEntry } from 'astro:content';
import { phases } from '~/data/phases';
import { linkLabel, phaseFolderName, qualifiedFileName } from '~/lib/explorer';
import { defaultLocale, toLocale } from '~/lib/locales';
import { urlOfId } from '~/lib/translations';
import { getTranslationIndex } from '~/lib/translations-astro';

interface Props {
  lesson: NonNullable<CollectionEntry<'docs'>['data']['lesson']>;
}

const { lesson } = Astro.props;
const t = contentT(Astro.locals);
const { sidebar } = Astro.locals.starlightRoute;
const urlLocale = toLocale(Astro.locals.starlightRoute.locale);
const phaseSlugs = phases.map((p) => phaseFolderName(urlLocale, p.number));
const index = await getTranslationIndex();

const prerequisites = await Promise.all(
  lesson.prerequisites.map(async (key) => {
    // Each prerequisite is a lesson's translationKey. It links in the URL's language and, if it
    // is not translated yet, in the default language.
    const ids = index.byKey.get(key);
    const id = ids?.[urlLocale] ?? ids?.[defaultLocale];
    const entry = id === undefined ? undefined : await getEntry('docs', id);
    if (!entry) throw new Error(`[LessonIntro] The prerequisite "${key}" does not exist`);
    const href = urlOfId(entry.id);
    const title = entry.data.title;
    // The name and the file, the same ones this page's sidebar gives (its language).
    const name = linkLabel(sidebar, href) ?? title;
    // If the prerequisite is in another phase, with its folder in front («fase-0/01-…md»).
    const file = qualifiedFileName(sidebar, phaseSlugs, { href, label: title }, Astro.url.pathname);
    return { href, name, file };
  }),
);
---

<div class="lesson-intro">
  <p class="lesson-intro__quote">
    <span class="lesson-intro__marker" aria-hidden="true" data-pagefind-ignore>
      &gt;
    </span>
    <span>
      <span class="sr-only">{t('lesson.oneLiner')} </span>
      {lesson.oneLiner}
    </span>
  </p>
  <p class="lesson-intro__comment">
    <span aria-hidden="true" data-pagefind-ignore>
      //{' '}
    </span>
    {t('lesson.objectives')}
  </p>
  <ul class="lesson-intro__tasks" role="list">
    {lesson.objectives.map((objective) => (
      <li>
        <span class="lesson-intro__marker" aria-hidden="true" data-pagefind-ignore>
          - [ ]
        </span>
        <span>{objective}</span>
      </li>
    ))}
  </ul>
  {prerequisites.length > 0 && (
    <p class="lesson-intro__imports">
      <span class="sr-only">{t('lesson.prerequisites')} </span>
      {prerequisites.map((prerequisite) => (
        <span class="lesson-intro__import">
          <span class="lesson-intro__keyword" aria-hidden="true" data-pagefind-ignore>
            import
          </span>{' '}
          <a href={prerequisite.href} aria-label={prerequisite.name}>
            {prerequisite.file}
          </a>{' '}
          <span class="lesson-intro__comment-inline" aria-hidden="true" data-pagefind-ignore>
            {t('lesson.prerequisiteComment')}
          </span>
        </span>
      ))}
    </p>
  )}
</div>

<style>
  .lesson-intro {
    margin-top: 1rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .lesson-intro p,
  .lesson-intro ul {
    margin: 0;
  }
  .lesson-intro__quote {
    display: flex;
    gap: 0.75rem;
    font-size: var(--sl-text-xl);
    line-height: 1.5;
    color: var(--ide-strong);
  }
  .lesson-intro__marker {
    flex-shrink: 0;
    font-family: var(--__sl-font-mono);
    color: var(--ide-keyword);
  }
  .lesson-intro__quote .lesson-intro__marker {
    color: var(--ide-string);
  }
  .lesson-intro__comment,
  .lesson-intro__comment-inline {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--ide-comment);
  }
  .lesson-intro__tasks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .lesson-intro__tasks li {
    display: flex;
    gap: 0.75rem;
  }
  .lesson-intro__imports {
    display: flex;
    flex-direction: column;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .lesson-intro__keyword {
    color: var(--ide-keyword);
  }
  .lesson-intro a {
    color: var(--ide-accent);
  }
</style>
