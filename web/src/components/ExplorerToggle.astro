---
/**
 * The button that hides and shows the side panel (explorer and outline) on a computer, like VS Code's
 * "Toggle Primary Side Bar". It lives in the panel, next to «EXPLORADOR», beside what it hides: when
 * hidden, the panel shrinks to a narrow rail that keeps only this button (theme.css). On mobile it is
 * not drawn: there the panel is the ☰ menu.
 * The choice is remembered (EXPLORER_KEY) and applied before painting, so the panel does not flash.
 */
import { EXPLORER_KEY } from '~/lib/storage';
const label = Astro.locals.t('explorer.toggle');
---

<script is:inline define:vars={{ explorerKey: EXPLORER_KEY }}>
  try {
    if (localStorage.getItem(explorerKey) === 'collapsed') {
      document.documentElement.dataset.ideExplorer = 'collapsed';
    }
  } catch {}
</script>

<ide-explorer-toggle class="sl-hidden md:sl-flex print:hidden">
  <button
    type="button"
    class="ide-explorer-toggle"
    aria-controls="ide-files"
    aria-expanded="true"
    aria-label={label}
    title={label}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path class="ide-explorer-toggle__panel" d="M4 5h5v14H4z" />
      <path d="M9 4v16" />
    </svg>
  </button>
</ide-explorer-toggle>

<script>
  import { explorerCollapsed, toggledExplorer } from '~/lib/explorer-panel';
  import { EXPLORER_KEY, safeStorage } from '~/lib/storage';

  class ExplorerToggle extends HTMLElement {
    connectedCallback() {
      const storage = safeStorage(() => window.localStorage);
      const button = this.querySelector('button')!;
      const root = document.documentElement;
      const apply = (collapsed: boolean) => {
        if (collapsed) root.dataset.ideExplorer = 'collapsed';
        else delete root.dataset.ideExplorer;
        button.setAttribute('aria-expanded', String(!collapsed));
      };
      apply(explorerCollapsed(storage.get(EXPLORER_KEY)));
      button.addEventListener('click', () => {
        const next = toggledExplorer(root.dataset.ideExplorer === 'collapsed');
        storage.set(EXPLORER_KEY, next);
        apply(next === 'collapsed');
      });
    }
  }
  customElements.define('ide-explorer-toggle', ExplorerToggle);
</script>

<style>
  ide-explorer-toggle {
    align-items: center;
  }
  .ide-explorer-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ide-muted);
    cursor: pointer;
  }
  .ide-explorer-toggle:hover {
    color: var(--ide-strong);
    background: var(--ide-chrome);
  }
  .ide-explorer-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  /* The left column is filled while the panel is shown, as in VS Code. */
  .ide-explorer-toggle__panel {
    stroke: none;
  }
  .ide-explorer-toggle[aria-expanded='true'] .ide-explorer-toggle__panel {
    fill: currentColor;
  }
</style>
