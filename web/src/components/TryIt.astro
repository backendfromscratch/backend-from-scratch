---
import { contentT } from '~/lib/content-i18n';
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

interface Props {
  /** Command or commands for macOS and Linux (and WSL). */
  cmd: string;
  /** Alternative for Windows. If given, per-system tabs appear, synced across the whole page. */
  windows?: string;
  /**
   * What the Windows alternative is written in: `powershell` (default) or `sh` if they are commands that
   * run inside WSL. With `sh`, the tab is called «Windows (WSL)» and the prompt is `$`, not `PS>`:
   * typing `nc` in PowerShell does not work.
   */
  windowsLang?: 'powershell' | 'sh';
  /** Expected output, copied from a real run. */
  output?: string;
  /** Title of the block. Defaults to «Pruébalo en tu terminal». */
  title?: string;
  /** Language used to highlight `cmd`. Defaults to `sh`; use `http` if what is typed is an HTTP message. */
  lang?: string;
}

const { cmd, windows, windowsLang = 'powershell', output, title, lang = 'sh' } = Astro.props;
const t = contentT(Astro.locals);
const heading = title ?? t('tryIt.title');
---

<section class="try-it" aria-label={heading}>
  <p class="try-it__title">{heading}</p>
  {windows ? (
    <Tabs syncKey="os">
      <TabItem label="macOS / Linux">
        <Code code={cmd} lang={lang} frame="terminal" />
      </TabItem>
      <TabItem label={windowsLang === 'sh' ? 'Windows (WSL)' : 'Windows'}>
        <Code code={windows} lang={windowsLang} frame="terminal" />
      </TabItem>
    </Tabs>
  ) : (
    <Code code={cmd} lang={lang} frame="terminal" />
  )}
  {output && (
    <>
      <p class="try-it__label">{t('tryIt.output')}</p>
      <Code code={output} lang="text" />
    </>
  )}
  <div class="try-it__explanation">
    <slot />
  </div>
</section>

<style>
  /*
   * The prompt in front of each command, as in a terminal: «$» (macOS, Linux, WSL) or «PS>»
   * (PowerShell). It is decorative: it is not read or copied, and the copy button copies only the command.
   * Each line is a command (the exercises do not use lines split with «\»). Messages typed
   * by hand (lang="http") and outputs carry no prompt.
   */
  .try-it :global(pre[data-language='sh'] .ec-line .code::before) {
    content: '$ ' / '';
    color: var(--ide-comment);
    user-select: none;
  }
  .try-it :global(pre[data-language='powershell'] .ec-line .code::before) {
    content: 'PS> ' / '';
    color: var(--ide-comment);
    user-select: none;
  }
  /* An editor's integrated terminal panel. */
  .try-it {
    margin-block: 1.5rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
  }
  .try-it__title {
    margin: 0;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--ide-border);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ide-strong);
    box-shadow: inset 0 -1px 0 var(--ide-accent);
  }
  .try-it > :not(.try-it__title) {
    margin-inline: 1rem;
  }
  .try-it__label {
    margin-block: 1rem 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--ide-comment);
  }
  .try-it__explanation {
    margin-block: 1rem;
  }
</style>
