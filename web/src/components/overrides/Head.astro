---
/**
 * Starlight's <head>, with the two fonts every page draws above the fold preloaded first: the
 * frame's monospace (JetBrains Mono) and the prose's (Atkinson Hyperlegible Next), latin, the
 * subset Spanish and English use. Their @font-face rules (Fontsource, font-display: swap) paint with
 * a fallback font until the file arrives; when it arrived after the first paint, the title and the
 * lesson header wrapped differently and the whole page moved (a layout shift Google's CLS counts):
 * measured on Linux in CI at 0.012 to 0.018 on scene lessons, whose text column is narrow, and 0
 * with these two preloads. The ?url imports resolve to the same hashed files the CSS uses.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import prose from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
---

<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={prose} as="font" type="font/woff2" crossorigin />
<Default />
