---
/**
 * The title and the lesson intro. The tab and breadcrumbs are in EditorTabs.astro, at the top
 * of the editor.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import LessonIntro from '~/components/LessonIntro.astro';
import { isLessonId } from '~/lib/lessons';

const { entry } = Astro.locals.starlightRoute;
const { lesson } = entry.data;

if (isLessonId(entry.id) && !lesson) {
  throw new Error(
    `[lesson] "${entry.id}" is a lesson and is missing the "lesson" block (oneLiner, objectives) in the frontmatter`,
  );
}
---

<Default />
{lesson && <LessonIntro lesson={lesson} />}
