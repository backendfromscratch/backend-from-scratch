---
/**
 * The title and the lesson intro and, above the title of a lesson, its reading time.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import LessonIntro from '~/components/LessonIntro.astro';
import { isLessonId } from '~/lib/lessons';
import { readingMinutes } from '~/lib/reading';

const { entry } = Astro.locals.starlightRoute;
const { lesson } = entry.data;

if (isLessonId(entry.id) && !lesson) {
  throw new Error(
    `[lesson] "${entry.id}" is a lesson and is missing the "lesson" block (oneLiner, objectives) in the frontmatter`,
  );
}
const minutes = lesson ? readingMinutes(entry.body ?? '') : undefined;
---

{minutes && (
  <p class="ide-reading" data-pagefind-ignore>
    {Astro.locals.t('reading.minutes', { minutes })}
  </p>
)}
<Default />
{lesson && <LessonIntro lesson={lesson} />}

<style>
  .ide-reading {
    margin: 0 0 0.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    color: var(--ide-muted);
  }
</style>
