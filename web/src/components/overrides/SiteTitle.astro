---
import { toKebab } from '~/lib/explorer';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="ide-site-title" aria-label={siteTitle}>
  <span class="ide-site-title__mark" aria-hidden="true"></span>
  <span aria-hidden="true">{toKebab(siteTitle)}</span>
</a>

<style>
  .ide-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--__sl-font-mono);
    font-weight: 700;
    font-size: var(--sl-text-base);
    color: var(--ide-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .ide-site-title__mark {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    background: var(--ide-accent);
  }
</style>
