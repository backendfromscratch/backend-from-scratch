---
/**
 * The theme, as a single button that switches between dark and light, in the header and in the
 * mobile menu. Replaces Starlight's selector (dark, light or auto, in a <select> whose names were cut
 * short). Until the first click it follows the system; then it remembers the choice. It stores it
 * where Starlight does (lib/theme.ts), so Starlight's <head> script paints it before the page shows.
 * The icon is the theme the click leads to: the sun in dark mode, the moon in light mode.
 */
---

<ide-theme-toggle>
  <button type="button" class="ide-theme-toggle" aria-label={Astro.locals.t('theme.toggle')}>
    <svg class="ide-theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="ide-theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
    </svg>
  </button>
</ide-theme-toggle>

<script>
  import { nextTheme, storedTheme, themeFor, THEME_KEY } from '~/lib/theme';
  import { safeStorage } from '~/lib/storage';

  const storage = safeStorage(() => localStorage);
  const root = document.documentElement;
  const systemLight = matchMedia('(prefers-color-scheme: light)');

  // A stored value that is not «dark» or «light» is not a choice. Starlight never writes one, but
  // its <head> script would paint it dark: it is cleared and the page follows the system.
  const stored = storage.get(THEME_KEY);
  if (stored && !storedTheme(stored)) {
    storage.set(THEME_KEY, '');
    root.dataset.theme = themeFor(null, systemLight.matches);
  }

  // While the reader has not chosen, the page follows the system, also if it changes.
  systemLight.addEventListener('change', () => {
    root.dataset.theme = themeFor(storage.get(THEME_KEY), systemLight.matches);
  });

  class IdeThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const theme = nextTheme(root.dataset.theme);
        root.dataset.theme = theme;
        storage.set(THEME_KEY, theme);
      });
    }
  }
  if (!customElements.get('ide-theme-toggle'))
    customElements.define('ide-theme-toggle', IdeThemeToggle);
</script>

<style>
  .ide-theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ide-muted);
    cursor: pointer;
  }
  .ide-theme-toggle:hover {
    color: var(--ide-strong);
  }
  .ide-theme-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global(:root[data-theme='light']) .ide-theme-toggle__sun,
  :global(:root:not([data-theme='light'])) .ide-theme-toggle__moon {
    display: none;
  }
</style>
