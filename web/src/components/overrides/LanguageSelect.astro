---
/**
 * The languages as links, «ES · EN», in the header and in the mobile menu. Replaces Starlight's
 * selector: a <select> takes two clicks, its option names were cut short and Google does not
 * follow it. Each link goes to the real translation of the page (routes are translated, so it is not
 * the same route with another prefix) or, if the page is not translated, to the home page of that
 * language. The SEO audit checks they match the hreflang (lib/seo/audit.ts, language-links).
 */
import { localeLabels, locales, toLocale } from '~/lib/locales';
import { languageTargets } from '~/lib/route-fixes';
import { translationsOf } from '~/lib/translations';
import { getTranslationIndex } from '~/lib/translations-astro';

const route = Astro.locals.starlightRoute;
const current = toLocale(route.locale);
const targets = languageTargets(translationsOf(await getTranslationIndex(), route.entry.id));
---

<nav
  class="ide-languages"
  data-language-links
  aria-label={Astro.locals.t('languageSelect.accessibleLabel')}
>
  {locales.map((locale, index) => (
    <>
      {index > 0 && (
        <span class="ide-languages__dot" aria-hidden="true">
          ·
        </span>
      )}
      <a
        href={targets[locale]}
        lang={locale}
        hreflang={locale}
        aria-current={locale === current ? 'page' : undefined}
      >
        {locale.toUpperCase()}
        <span class="sr-only"> {localeLabels[locale]}</span>
      </a>
    </>
  ))}
</nav>

<style>
  .ide-languages {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .ide-languages a {
    padding: 0.25rem 0.375rem;
    border-radius: 0.25rem;
    color: var(--ide-muted);
    text-decoration: none;
  }
  .ide-languages a:hover {
    color: var(--ide-strong);
  }
  .ide-languages a[aria-current='page'] {
    color: var(--ide-strong);
    font-weight: 700;
  }
  .ide-languages__dot {
    color: var(--ide-muted);
  }
</style>
