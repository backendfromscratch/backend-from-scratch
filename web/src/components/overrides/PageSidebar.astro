---
/**
 * Only the mobile table of contents («En esta página», on top), below 50rem. From 50rem, the table of contents goes
 * in the explorer (Sidebar.astro, ESQUEMA section).
 */
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
---

{Astro.locals.starlightRoute.toc && (
  <div class="md:sl-hidden">
    <MobileTableOfContents />
  </div>
)}
