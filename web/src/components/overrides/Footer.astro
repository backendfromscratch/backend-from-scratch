---
import Pagination from './Pagination.astro';
import { phases } from '~/data/phases';
import { contentLicense, repoUrl, siteUrl } from '~/data/site';
import { lessonIssueUrl } from '~/lib/contact';
import { currentLesson, phaseFolderName, statusStep, toKebab } from '~/lib/explorer';
import { isLessonId } from '~/lib/lessons';
import type { Locale } from '~/lib/locales';
import { toLocale } from '~/lib/locales';

// The about page, with the ways to get in touch; its route is translated (translationKey: about).
const aboutHref: Record<Locale, string> = { es: '/sobre-el-curso/', en: '/en/about/' };

const route = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = toLocale(route.locale);
const current = currentLesson(route.sidebar, phases, locale);

let where = toKebab(route.siteTitle);
if (current) {
  const step = statusStep(current);
  const text =
    step.key === 'status.intro'
      ? t(step.key)
      : step.key === 'status.lesson'
        ? t(step.key, { n: step.n, total: step.total })
        : t(step.key, { n: step.n });
  where = `${phaseFolderName(locale, current.phase.number)} · ${text}`;
}
// After a lesson's quiz: a link to tell the author what is unclear or wrong.
const feedbackHref = isLessonId(route.id)
  ? lessonIssueUrl(repoUrl, locale, {
      title: route.entry.data.title,
      url: `${siteUrl}${Astro.url.pathname}`,
    })
  : undefined;
---

<footer class="ide-footer">
  {feedbackHref && (
    <p class="ide-feedback print:hidden" data-pagefind-ignore>
      {t('lesson.feedback')} <a href={feedbackHref}>{t('lesson.feedbackLink')}</a>
    </p>
  )}
  <Pagination />
  {/* Outside the search index: it is on every page and would match every search. */}
  <p class="ide-license" data-pagefind-ignore>
    {t('footer.license')}{' '}
    <a href={contentLicense.url[locale]} rel="license">
      {contentLicense.name}
    </a>
    <span aria-hidden="true"> · </span>
    <a href={aboutHref[locale]}>{t('footer.about')}</a>
  </p>
</footer>
{/* Outside the search index and print; lang: the text is in the URL's language. */}
<div class="ide-statusbar print:hidden" lang={route.lang} data-pagefind-ignore>
  <span class="ide-statusbar__group">
    <span aria-hidden="true">⎇ main</span>
    <span>{where}</span>
  </span>
  <span class="ide-statusbar__group" aria-hidden="true">
    <span>Markdown</span>
    <span>{locale.toUpperCase()}</span>
  </span>
</div>

<style>
  .ide-feedback {
    margin-block: 2.5rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--ide-border);
    color: var(--ide-muted);
  }
  /* The lessons' link color: outside .sl-markdown-content, it would be the browser's. */
  .ide-feedback a {
    color: var(--sl-color-text-accent);
  }
  .ide-license {
    margin-top: 2rem;
    color: var(--ide-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .ide-license a {
    color: inherit;
  }
  .ide-license a:hover {
    color: var(--ide-strong);
  }
  .ide-statusbar {
    position: fixed;
    inset: auto 0 0 0;
    /*
     * Careful: the bar lives inside .main-pane, which has isolation: isolate, so this z-index
     * only counts within that context. Panels do not cover it because they end above it
     * (theme.css); the mobile menu is a popover and stays on top.
     */
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: var(--ide-statusbar-height);
    padding: 0 0.75rem;
    border-top: 1px solid var(--ide-border);
    background: var(--ide-chrome);
    color: var(--ide-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
  }
  .ide-statusbar__group {
    display: flex;
    gap: 1rem;
  }
  /* The component's style wins over theme.css's: the print rule has to go here. */
  @media print {
    .ide-statusbar {
      display: none;
    }
  }
</style>
