---
import Pagination from './Pagination.astro';
import { phases } from '~/data/phases';
import { currentLesson, phaseFolderName, statusStep, toKebab } from '~/lib/explorer';
import { toLocale } from '~/lib/locales';

const route = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = toLocale(route.locale);
const current = currentLesson(route.sidebar, phases, locale);

let where = toKebab(route.siteTitle);
if (current) {
  const step = statusStep(current);
  const text =
    step.key === 'status.intro'
      ? t(step.key)
      : step.key === 'status.lesson'
        ? t(step.key, { n: step.n, total: step.total })
        : t(step.key, { n: step.n });
  where = `${phaseFolderName(locale, current.phase.number)} · ${text}`;
}
---

<footer class="ide-footer">
  <Pagination />
</footer>
{/* Fuera del índice del buscador y de la impresión; lang: el texto va en el idioma de la URL. */}
<div class="ide-statusbar print:hidden" lang={route.lang} data-pagefind-ignore>
  <span class="ide-statusbar__group">
    <span aria-hidden="true">⎇ main</span>
    <span>{where}</span>
  </span>
  <span class="ide-statusbar__group" aria-hidden="true">
    <span>Markdown</span>
    <span>{locale.toUpperCase()}</span>
  </span>
</div>

<style>
  .ide-statusbar {
    position: fixed;
    inset: auto 0 0 0;
    /*
     * Ojo: la barra vive dentro de .main-pane, que tiene isolation: isolate, así que este z-index
     * solo cuenta dentro de ese contexto. No la tapan los paneles porque terminan encima de ella
     * (theme.css); el menú móvil es un popover y queda por encima.
     */
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: var(--ide-statusbar-height);
    padding: 0 0.75rem;
    border-top: 1px solid var(--ide-border);
    background: var(--ide-chrome);
    color: var(--ide-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    font-weight: 500;
  }
  .ide-statusbar__group {
    display: flex;
    gap: 1rem;
  }
  /* El estilo del componente manda sobre el de theme.css: la regla de impresión tiene que ir aquí. */
  @media print {
    .ide-statusbar {
      display: none;
    }
  }
</style>
