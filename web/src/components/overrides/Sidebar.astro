---
/**
 * The side panel, like an editor's: the course file tree (the phases and, at the end, a «recursos/»
 * folder with the playgrounds and the glossary), always visible, and below it the page outline, which
 * collapses and starts collapsed. The home page is the site title in the header. On mobile (☰ menu)
 * the tree is shown and, below it, the theme and language. On a computer, the button next to
 * «EXPLORADOR» shrinks the panel to a narrow rail (ExplorerToggle.astro).
 */
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import ExplorerToggle from '~/components/ExplorerToggle.astro';
import Outline from '~/components/Outline.astro';
import { phases } from '~/data/phases';
import {
  explorerPages,
  fileLinkName,
  findPhaseLinks,
  folderOpenByDefault,
  phaseFolderName,
  phaseSlugOf,
  toFileName,
  unexpectedSidebarEntries,
} from '~/lib/explorer';
import { toLocale } from '~/lib/locales';
import { flattenOutline } from '~/lib/outline';
import { FOLDERS_KEY, OUTLINE_KEY } from '~/lib/storage';

const route = Astro.locals.starlightRoute;
const locale = toLocale(route.locale);
const t = Astro.locals.t;
const pages = explorerPages(locale, Astro.url.pathname).map((page) => {
  const label = t(page.id === 'playgrounds' ? 'explorer.playgrounds' : 'explorer.glossary');
  return { ...page, label, file: toFileName(label) };
});
// An outline with a single entry (only «Sinopsis», like the syllabus's) does not help: it is not drawn.
const hasOutline = route.toc !== undefined && flattenOutline(route.toc.items).length > 1;
const phaseSlugs = phases.map((phase) => phaseFolderName(locale, phase.number));
// The explorer only draws the phases (and its own resources folder): anything else in the menu is an error.
const unexpected = unexpectedSidebarEntries(route.sidebar, phaseSlugs);
if (unexpected.length > 0) {
  throw new Error(
    `[explorer] The menu has ${unexpected.map((label) => `«${label}»`).join(', ')}, which are not phases: the explorer would not draw them. Remove them from astro.config.ts or give them a place in Sidebar.astro.`,
  );
}
const folders = phases.map((phase) => ({
  phase,
  name: phaseFolderName(locale, phase.number),
  links:
    phase.status === 'available'
      ? findPhaseLinks(route.sidebar, phaseFolderName(locale, phase.number))
      : [],
}));
// On arrival, only the current phase's folder opens (outside the phases, the first published one).
const currentSlug = phaseSlugOf(Astro.url.pathname, phaseSlugs);
const firstPublished = folders.find((folder) => folder.links.length > 0)?.name;
const resources = t('explorer.resources');
const inResources = pages.some((page) => page.current);
---

<div class="ide-side">
  <div class="ide-panels">
    <div class="ide-panels__bar">
      <p class="ide-panels__title" aria-hidden="true">
        {t('explorer.title')}
      </p>
      <ExplorerToggle />
    </div>
    {/* The tree does not collapse: the phases are always visible. */}
    <div id="ide-files" class="ide-section ide-section--files">
      <nav class="explorer" aria-label={t('explorer.title')}>
        <ul class="explorer__list" role="list">
          {folders.map(({ phase, name, links }) =>
            links.length > 0 ? (
              <li>
                <details
                  class="explorer__folder"
                  data-folder={name}
                  data-current={name === currentSlug ? 'true' : undefined}
                  open={folderOpenByDefault(name, currentSlug, firstPublished)}
                >
                  <summary title={phase.title[locale]}>
                    <svg class="ide-chevron" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                    <span class="explorer__name">{name}</span>{' '}
                    <span class="explorer__hint">{phase.title[locale]}</span>
                  </summary>
                  <ul class="explorer__list" role="list">
                    {links.map((link, index) => (
                      <li>
                        <a
                          class="explorer__file explorer__file--nested"
                          href={link.href}
                          aria-current={link.isCurrent ? 'page' : undefined}
                          aria-label={fileLinkName(link.label, toFileName(link.label, index))}
                          title={link.label}
                        >
                          <span class="ide-file-icon" aria-hidden="true">
                            #
                          </span>
                          {toFileName(link.label, index)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li class="explorer__folder explorer__folder--soon" title={phase.title[locale]}>
                <svg class="ide-chevron ide-chevron--closed" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
                <span class="explorer__name">{name}</span>{' '}
                <span class="explorer__hint">{phase.title[locale]}</span>
                <span class="sr-only"> ({t('explorer.comingSoon')})</span>
              </li>
            ),
          )}
          <li>
            <details
              class="explorer__folder"
              data-folder={resources}
              data-current={inResources ? 'true' : undefined}
              open={inResources}
            >
              <summary>
                <svg class="ide-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
                <span class="explorer__name">{resources}</span>
              </summary>
              <ul class="explorer__list" role="list">
                {pages.map((page) => (
                  <li>
                    <a
                      class="explorer__file explorer__file--nested"
                      href={page.href}
                      aria-current={page.current ? 'page' : undefined}
                      aria-label={fileLinkName(page.label, page.file)}
                      title={page.label}
                    >
                      {page.id === 'playgrounds' ? (
                        <svg class="explorer__icon" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M9 3h6" />
                          <path d="M10 3v6l-5.5 9.5A1.5 1.5 0 0 0 5.8 21h12.4a1.5 1.5 0 0 0 1.3-2.5L14 9V3" />
                          <path d="M7.5 15h9" />
                        </svg>
                      ) : (
                        <svg class="explorer__icon" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z" />
                          <path d="M5 17a3 3 0 0 1 3-3h11" />
                        </svg>
                      )}
                      {page.file}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
      </nav>
    </div>
    {hasOutline && (
      <details
        id="ide-outline-section"
        class="ide-section ide-section--outline sl-hidden md:sl-block"
      >
        <summary class="ide-section__summary">
          <svg class="ide-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
          {t('tableOfContents.onThisPage')}
        </summary>
        <Outline />
      </details>
    )}
  </div>
</div>

<script is:inline define:vars={{ outlineKey: OUTLINE_KEY, foldersKey: FOLDERS_KEY }}>
  // Before painting: the outline starts collapsed and opens if the reader opened it on another page; the
  // phase folders the reader opened or collapsed stay that way (the current phase's, always open).
  try {
    const outline = document.getElementById('ide-outline-section');
    if (outline && localStorage.getItem(outlineKey) === 'open') outline.open = true;
    const folders = JSON.parse(localStorage.getItem(foldersKey) || '{}');
    for (const folder of document.querySelectorAll('.explorer__folder[data-folder]')) {
      const open = folders[folder.dataset.folder];
      if (folder.dataset.current !== 'true' && typeof open === 'boolean') folder.open = open;
    }
  } catch {}
</script>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  import { revealScrollTop } from '~/lib/explorer';
  import { FOLDERS_KEY, OUTLINE_KEY, safeStorage } from '~/lib/storage';

  // If the reader opens or collapses the outline or a folder, the next page respects it.
  const storage = safeStorage(() => window.localStorage);
  for (const folder of document.querySelectorAll<HTMLDetailsElement>(
    '.explorer__folder[data-folder]',
  )) {
    folder.addEventListener('toggle', () => {
      // The current phase's folder always opens on arrival: it is not saved.
      if (folder.dataset.current === 'true') return;
      let saved: Record<string, boolean> = {};
      try {
        saved = JSON.parse(storage.get(FOLDERS_KEY) ?? '{}') as Record<string, boolean>;
      } catch {
        // What was saved cannot be understood: start from scratch.
      }
      storage.set(FOLDERS_KEY, JSON.stringify({ ...saved, [folder.dataset.folder!]: folder.open }));
    });
  }
  const outline = document.querySelector<HTMLDetailsElement>('#ide-outline-section');
  outline?.addEventListener('toggle', () => storage.set(OUTLINE_KEY, outline.open ? 'open' : ''));

  // As in an editor, the open file is visible in the tree even if it is far down.
  const scroller = document.querySelector<HTMLElement>('.ide-section--files');
  const current = scroller?.querySelector<HTMLElement>('[aria-current="page"]');
  if (scroller && current && matchMedia('(min-width: 50rem)').matches) {
    const top =
      current.getBoundingClientRect().top -
      scroller.getBoundingClientRect().top +
      scroller.scrollTop;
    scroller.scrollTop = revealScrollTop(
      { scrollTop: scroller.scrollTop, height: scroller.clientHeight },
      { top, height: current.offsetHeight },
    );
  }
</script>

<style>
  /* Inside the scrolling panels, keyboard focus goes inside: outside it would be clipped. */
  .ide-side :global(:focus-visible) {
    outline-offset: -2px;
  }
  .ide-side {
    font-family: var(--__sl-font-mono);
  }
  .ide-panels__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.5rem 0.125rem 1.25rem;
  }
  .ide-panels__title {
    margin: 0;
    font-size: var(--sl-text-2xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ide-muted);
  }
  .ide-section__summary {
    display: block;
    padding: 0.3rem 0.5rem;
    list-style: none;
    cursor: pointer;
    background: var(--ide-chrome);
    font-size: var(--sl-text-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ide-text);
  }
  .ide-section--outline {
    border-top: 1px solid var(--ide-border);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .ide-chevron {
    width: 1rem;
    height: 1rem;
    margin-inline-end: 0.25rem;
    vertical-align: -0.2em;
    fill: none;
    stroke: var(--ide-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  details:not([open]) > summary > .ide-chevron,
  .ide-chevron--closed {
    transform: rotate(-90deg);
  }
  .explorer {
    padding-bottom: 0.5rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .explorer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* As in an editor: one line per entry, truncated with «…»; the full name goes in title. */
  .explorer__file,
  .explorer__folder summary,
  .explorer__folder--soon {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .explorer__file {
    padding: 0.2rem 0.5rem 0.2rem 1.75rem;
    color: var(--ide-text);
    text-decoration: none;
  }
  .explorer__file .ide-file-icon {
    margin-inline-end: 0.375rem;
  }
  /* Playgrounds and glossary: the width of the «#» of the other files, so the names line up. */
  .explorer__icon {
    width: 1rem;
    height: 1rem;
    margin-inline-end: 0.375rem;
    vertical-align: -0.15em;
    fill: none;
    stroke: var(--ide-info);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .explorer__file:hover {
    background: var(--ide-selection);
    color: var(--ide-strong);
  }
  .explorer__file[aria-current='page'] {
    background: var(--ide-selection);
    color: var(--ide-strong);
    box-shadow: inset 2px 0 0 var(--ide-accent);
  }
  .explorer__folder summary {
    padding: 0.2rem 0.5rem;
    list-style: none;
    cursor: pointer;
    color: var(--ide-text);
  }
  /* The indent guide of an open folder. */
  .explorer__folder > .explorer__list {
    margin-inline-start: 0.95rem;
    border-inline-start: 1px solid var(--ide-border);
  }
  .explorer__file--nested {
    padding-inline-start: 0.75rem;
  }
  .explorer__name {
    color: var(--ide-accent);
  }
  .explorer__hint {
    color: var(--ide-muted);
  }
  .explorer__folder--soon {
    /* Contains the .sr-only text (absolute position) inside the clipped row. */
    position: relative;
    padding: 0.2rem 0.5rem;
    color: var(--ide-muted);
  }
  .explorer__folder--soon .explorer__name {
    color: var(--ide-muted);
  }
</style>
