---
import { phases } from '~/data/phases';
import { fileLinkName, phaseFolderName, qualifiedFileName } from '~/lib/explorer';
import { toLocale } from '~/lib/locales';

const { pagination, sidebar } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = toLocale(Astro.locals.starlightRoute.locale);
const slugs = phases.map((p) => phaseFolderName(locale, p.number));
const prev = pagination.prev;
const next = pagination.next;
const prevFile = prev && qualifiedFileName(sidebar, slugs, prev, Astro.url.pathname);
const nextFile = next && qualifiedFileName(sidebar, slugs, next, Astro.url.pathname);
---

{(prev || next) && (
  <nav class="ide-pagination print:hidden" aria-label={t('pagination.label')}>
    {prev && (
      <a
        href={prev.href}
        rel="prev"
        aria-label={fileLinkName(`${t('page.previousLink')}: ${prev.label}`, prevFile!)}
      >
        <span aria-hidden="true">← {prevFile}</span>
      </a>
    )}
    {next && (
      <a
        href={next.href}
        rel="next"
        aria-label={fileLinkName(`${t('page.nextLink')}: ${next.label}`, nextFile!)}
      >
        <span aria-hidden="true">{nextFile} →</span>
      </a>
    )}
  </nav>
)}

<style>
  .ide-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ide-border);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .ide-pagination a {
    padding: 0.75rem 1rem;
    border: 1px solid var(--ide-border);
    border-radius: 0.375rem;
    background: var(--ide-chrome);
    color: var(--ide-text);
    text-decoration: none;
  }
  .ide-pagination a:hover {
    border-color: var(--ide-accent);
    color: var(--ide-strong);
  }
  .ide-pagination [rel='next'] {
    margin-inline-start: auto;
  }
</style>
