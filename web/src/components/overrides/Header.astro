---
/**
 * The header, like an editor's title bar: the name on the left, the search in the
 * center and, on the right, the theme and language, where anyone looks for them. On mobile, the theme and
 * language are in the menu (MobileMenuFooter), as in Starlight.
 */
// Starlight's own, as its documentation recommends (its virtual modules have no types). If one
// day the search or the theme selector is replaced, the new one must be imported here.
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '~/components/overrides/LanguageSelect.astro';
import SiteTitle from '~/components/overrides/SiteTitle.astro';
---

<div class="ide-header">
  <div class="ide-header__title">
    <SiteTitle />
  </div>
  <div class="ide-header__search print:hidden">
    <Search />
  </div>
  <div class="ide-header__end sl-hidden md:sl-flex print:hidden">
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .ide-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .ide-header__title {
    /* As in Starlight: a long name does not cover the search or the menu button. */
    overflow: clip;
    min-width: 0;
    margin: -0.25rem;
    padding: 0.25rem;
  }
  .ide-header__end {
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .ide-header {
      display: grid;
      /* Neither the name nor the selectors are clipped: if space runs out, the search shrinks. */
      grid-template-columns: minmax(max-content, 1fr) minmax(0, 32rem) minmax(max-content, 1fr);
    }
    .ide-header__search :global(button[data-open-modal]) {
      width: 100%;
      max-width: none;
    }
  }
</style>
