---
/**
 * La cabecera, como la barra de título de un editor: el nombre a la izquierda, el buscador en el
 * centro y, a la derecha, el tema y el idioma, donde cualquiera los busca. En el móvil, el tema y el
 * idioma están en el menú (MobileMenuFooter), como en Starlight.
 */
// Los de Starlight, como recomienda su documentación (sus módulos virtuales no tienen tipos). Si algún
// día se sustituye el buscador o el selector de tema, hay que importar aquí el nuevo.
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '~/components/overrides/LanguageSelect.astro';
import SiteTitle from '~/components/overrides/SiteTitle.astro';
---

<div class="ide-header">
  <div class="ide-header__title">
    <SiteTitle />
  </div>
  <div class="ide-header__search print:hidden">
    <Search />
  </div>
  <div class="ide-header__end sl-hidden md:sl-flex print:hidden">
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .ide-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .ide-header__title {
    /* Como en Starlight: un nombre largo no tapa el buscador ni el botón del menú. */
    overflow: clip;
    min-width: 0;
    margin: -0.25rem;
    padding: 0.25rem;
  }
  .ide-header__end {
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .ide-header {
      display: grid;
      /* Ni el nombre ni los selectores se recortan: si falta sitio, encoge el buscador. */
      grid-template-columns: minmax(max-content, 1fr) minmax(0, 32rem) minmax(max-content, 1fr);
    }
    .ide-header__search :global(button[data-open-modal]) {
      width: 100%;
      max-width: none;
    }
  }
</style>
