---
/**
 * The editor area: the page and, on wide screens, the minimap. Replaces Starlight's,
 * which reserves a column on the right for the table of contents: here the table of contents goes in the
 * explorer (Sidebar.astro, ESQUEMA section). The mobile table of contents still arrives through the
 * right-sidebar slot (PageSidebar.astro).
 * A scene lesson (`scenes: true`) gets its scene column instead of the minimap: ScenePanel.astro goes
 * after the content, so the text comes first in the HTML (docs/specs/2026-11-20-visual-lessons-design.md).
 */
import Minimap from '~/components/Minimap.astro';
import ScenePanel from '~/components/ScenePanel.astro';
import { SCENE_FOLD_KEY, SCENE_SPLIT_KEY } from '~/lib/storage';

const data = Astro.locals.starlightRoute.entry.data;
const scenes = data.scenes === true ? data.translationKey : undefined;
if (data.scenes === true && !scenes) {
  throw new Error(
    '[TwoColumnContent] A scene lesson needs a translationKey: it names its module in src/scenes/lessons/',
  );
}
---

{Astro.locals.starlightRoute.toc && (
  <aside class="md:sl-hidden print:hidden">
    <slot name="right-sidebar" />
  </aside>
)}
<div class:list={['main-pane', { 'main-pane--scenes': scenes }]}>
  {scenes && <script is:inline define:vars={{ foldKey: SCENE_FOLD_KEY, splitKey: SCENE_SPLIT_KEY }}>
    // Before the text is painted, as the explorer's choice: the reader's fold and text width
    // (src/scenes/core/boot.ts keeps them, and the CSS keeps the width within its limits).
    try {
      const root = document.documentElement;
      if (localStorage.getItem(foldKey) === 'folded') root.setAttribute('data-scene-folded', '');
      const width = Number(localStorage.getItem(splitKey));
      if (width > 0) root.style.setProperty('--scene-text-w', `${Math.round(width)}px`);
    } catch {}
  </script>}
  <slot />
  {scenes && <ScenePanel lesson={scenes} />}
</div>
{!scenes && <Minimap />}

<script>
  // A table or diagram wider than the text column scrolls sideways: while it does, the keyboard can
  // reach it (lib/scroll-regions.ts).
  import { SCROLL_REGIONS, scrolls } from '~/lib/scroll-regions';

  const regions = [...document.querySelectorAll<HTMLElement>(SCROLL_REGIONS)];
  const mark = () => {
    for (const region of regions) {
      if (scrolls(region)) region.tabIndex = 0;
      else region.removeAttribute('tabindex');
    }
  };
  mark();
  if (regions.length > 0) {
    const watch = new ResizeObserver(mark);
    for (const region of regions) watch.observe(region);
  }
</script>

<style>
  /* As in Starlight: the status bar (Footer.astro) relies on this stacking context. */
  .main-pane {
    isolation: isolate;
  }
</style>
