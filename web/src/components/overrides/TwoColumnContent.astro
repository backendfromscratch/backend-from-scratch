---
/**
 * The editor area: the page and, on wide screens, the minimap. Replaces Starlight's,
 * which reserves a column on the right for the table of contents: here the table of contents goes in the
 * explorer (Sidebar.astro, ESQUEMA section). The mobile table of contents still arrives through the
 * right-sidebar slot (PageSidebar.astro).
 */
import Minimap from '~/components/Minimap.astro';
---

{Astro.locals.starlightRoute.toc && (
  <aside class="md:sl-hidden print:hidden">
    <slot name="right-sidebar" />
  </aside>
)}
<div class="main-pane">
  <slot />
</div>
<Minimap />

<script>
  // A table or diagram wider than the text column scrolls sideways: while it does, the keyboard can
  // reach it (lib/scroll-regions.ts).
  import { SCROLL_REGIONS, scrolls } from '~/lib/scroll-regions';

  const regions = [...document.querySelectorAll<HTMLElement>(SCROLL_REGIONS)];
  const mark = () => {
    for (const region of regions) {
      if (scrolls(region)) region.tabIndex = 0;
      else region.removeAttribute('tabindex');
    }
  };
  mark();
  if (regions.length > 0) {
    const watch = new ResizeObserver(mark);
    for (const region of regions) watch.observe(region);
  }
</script>

<style>
  /* As in Starlight: the status bar (Footer.astro) relies on this stacking context. */
  .main-pane {
    isolation: isolate;
  }
</style>
