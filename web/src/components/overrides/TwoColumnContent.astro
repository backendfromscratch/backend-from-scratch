---
/**
 * The editor area: tabs and breadcrumbs on top and, below, the page. Replaces Starlight's,
 * which reserves a column on the right for the table of contents: here the table of contents goes in the
 * explorer (Sidebar.astro, ESQUEMA section). The mobile table of contents still arrives through the
 * right-sidebar slot (PageSidebar.astro).
 */
import EditorTabs from '~/components/EditorTabs.astro';
import Minimap from '~/components/Minimap.astro';
---

{Astro.locals.starlightRoute.toc && (
  <aside class="md:sl-hidden print:hidden">
    <slot name="right-sidebar" />
  </aside>
)}
<div class="main-pane">
  <EditorTabs />
  <slot />
</div>
<Minimap />

<style>
  /* As in Starlight: the status bar (Footer.astro) relies on this stacking context. */
  .main-pane {
    isolation: isolate;
  }
</style>
