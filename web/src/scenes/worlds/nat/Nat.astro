---
/**
 * The nat world's actors (nat.ts says what they do): your laptop with its programs, your phone, two
 * other laptops with the same private IP, your router with its NAT table, the internet's routers,
 * example.com with its sockets, the laptop's route table and the analogy's office building. Every
 * part that shows up later already has its room (spec §4.3). Ids start with `nt-`.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const laptop = icon('<rect x="3" y="3" width="10" height="7" rx="1"/><path d="M1.5 12.5h13"/>');
const phone = icon('<rect x="5" y="1.8" width="6" height="12.4" rx="1.4"/><path d="M7.3 12h1.4"/>');
const router = icon(
  '<rect x="2" y="8" width="12" height="5" rx="1.4"/><path d="M5 8 3.5 4.5M11 8l1.5-3.5"/>',
);
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/>',
);
const natRows = [
  ['203.0.113.7:61000', '192.168.1.133:54321'],
  ['203.0.113.7:61001', '192.168.1.140:50122'],
];
/** example.com's sockets: the one that listens, then one per conversation (clients behind your router, and another). */
const socketRows = [`${t.listens} · *:443`, '203.0.113.7:61000 ↔ :443', '203.0.113.7:61001 ↔ :443'];
---

<div class="scene-actor" data-actor="pc">
  <div class="anchor nt-box nt-pc">
    <div class="nt-box__title">
      <Fragment set:html={laptop} />
      {t.pc}
    </div>
    <div class="nt-ip" id="nt-pc-ip">
      192.168.1.133
    </div>
    <ul class="nt-progs" role="list">
      <li id="nt-prog-browser">
        <span>{t.browser}</span>
        <span class="nt-port">54321</span>
      </li>
      <li id="nt-prog-spotify">
        <span>Spotify</span>
      </li>
      <li id="nt-prog-slack">
        <span>Slack</span>
      </li>
    </ul>
  </div>
</div>

<div class="scene-actor" data-actor="mobile" hidden>
  <div class="anchor nt-box">
    <div class="nt-box__title">
      <Fragment set:html={phone} />
      {t.mobile}
    </div>
    <div class="nt-ip">192.168.1.140</div>
  </div>
</div>

<div class="scene-actor" data-actor="twins" hidden>
  <div class="anchor nt-twins">
    {[t.neighbour, t.tokyo].map((who) => (
      <div class="nt-box nt-box--small">
        <div class="nt-box__title">
          <Fragment set:html={laptop} />
          {who}
        </div>
        <div class="nt-ip">192.168.1.133</div>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="gw" hidden>
  <div class="anchor nt-box nt-gw">
    <div class="nt-box__title">
      <Fragment set:html={router} />
      {t.gw}
    </div>
    <div class="nt-gw__ips">
      <span>
        {t.inside}{' '}
        <b class="nt-ip" id="nt-gw-in">
          192.168.1.1
        </b>
      </span>
      <span>
        {t.outside}{' '}
        <b class="nt-ip" id="nt-gw-out">
          203.0.113.7
        </b>
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="backbone" hidden>
  <div class="anchor nt-box">
    <div class="nt-box__title">
      <Fragment set:html={router} />
      {t.isp}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="ex" hidden>
  <div class="anchor nt-box nt-ex">
    <div class="nt-box__title">
      <Fragment set:html={rack} />
      example.com
    </div>
    <div class="nt-ip">104.20.23.154</div>
  </div>
</div>

<div class="scene-actor" data-actor="routes" hidden>
  <div class="anchor nt-box nt-routes">
    <div class="nt-table__head">{t.routes}</div>
    {t.route.map(([to, via], i) => (
      <div class="nt-route" id={`nt-route-${i + 1}`}>
        <span>{to}</span>
        <span>→ {via}</span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="building" hidden>
  <div class="anchor nt-building">
    <div class="nt-building__name">{t.building}</div>
    <div class="nt-offices">
      {[1, 2, 3].map((n) => (
        <div class="nt-office" id={`nt-office-${n}`}>
          {t.office} {n}
        </div>
      ))}
    </div>
    <div class="nt-desk" id="nt-desk">
      <span class="nt-desk__name">{t.reception}</span>
      <span class="nt-desk__note" id="nt-note">
        {t.notebook}: 61000 → {t.office} 3
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="table" hidden>
  <div class="anchor nt-box nt-card">
    <div class="nt-table" id="nt-table">
      <div class="nt-table__head">{t.table}</div>
      {natRows.map(([out, inside], i) => (
        <div class="nt-table__row" id={`nt-nat-${i + 1}`}>
          <span>{out}</span>
          <span>→ {inside}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="sockets" hidden>
  <div class="anchor nt-box nt-card">
    <div class="nt-sockets" id="nt-sockets">
      <div class="nt-table__head">{t.sockets}</div>
      {socketRows.map((socket, i) => (
        <div class="nt-socket" id={`nt-socket-${i + 1}`}>
          {socket}
        </div>
      ))}
    </div>
  </div>
</div>
