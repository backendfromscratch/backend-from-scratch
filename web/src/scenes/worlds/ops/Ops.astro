---
/**
 * The ops world's actors (ops.ts says what they do): the usage card with its prices, Carmen's budget
 * in Redis, the request's three parts and the API's cache, the histogram of the time to first token,
 * Ana, the evals and their judge, and the trace with its span's attributes. HTML boxes with their
 * text at its own size, SVG only for shapes (people, icons); every part that shows up later already
 * has its room (spec §4.3). Ids start with `op-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { HISTOGRAM, OPS_INITIAL, budgetFill } from './ops';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const s = OPS_INITIAL;
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const cylinder = icon(
  '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
);
const spark = icon('<path d="M8 1.8v12.4M1.8 8h12.4M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/>');
const bolt = icon('<path d="M9 1.8 3.5 9h4L7 14.2 12.5 7h-4z"/>');
const scale = icon(
  '<path d="M8 2v12M4 14h8M2.5 5h11M4.5 5 2.5 9.5a2 2 0 0 0 4 0zM11.5 5l-2 4.5a2 2 0 0 0 4 0z"/>',
);
const flask = icon(
  '<path d="M6 2h4M6.8 2v4.2L3 13a1 1 0 0 0 .9 1.5h8.2A1 1 0 0 0 13 13L9.2 6.2V2M4.6 10h6.8"/>',
);
// The trace's spans, as shares of the request's span: the two calls, and the tool between them.
const SPANS = [
  ['request', 0, 1],
  ['call', 0.04, 0.42],
  ['tool', 0.44, 0.54],
  ['call', 0.56, 0.97],
] as const;
// The histogram's p50 and p95 marks, over a bucket each (an illustration: the text gives no values).
const MARKS = [
  ['p50', 1],
  ['p95', 4],
] as const;
---

<div class="scene-actor" data-actor="pricecard" hidden>
  <div class="anchor op-card op-price">
    <span class="op-price__title">{t.price.title}</span>
    {t.price.head.map((head) => (
      <span class="op-price__head">{head}</span>
    ))}
    {t.price.rows.map(([name, price, tokens]) => (
      <>
        <span class="op-price__name">{name}</span>
        <b class="op-price__price">{price}</b>
        <b class="op-room op-tokens">{tokens}</b>
      </>
    ))}
    <span class="op-price__name op-price__total">{t.price.total[0]}</span>
    <span class="op-price__total"></span>
    <b class="op-room op-price__total op-price__sum" id="op-total">
      {t.price.total[1]}
    </b>
  </div>
</div>

<div class="scene-actor" data-actor="budget" hidden>
  <div class="anchor op-box op-budget" id="op-budget">
    <div class="op-box__title">
      <Fragment set:html={cylinder} />
      {t.budget.title}
    </div>
    <div class="op-box__sub">{t.budget.key}</div>
    <div class="op-budget__row">
      <span class="op-budget__bar" id="op-spent" style={`--fill:${budgetFill(s.opSpent)}`}>
        <i></i>
        <span class="op-budget__limit"></span>
      </span>
      <b class="op-budget__count" id="op-count"></b>
    </div>
    <div class="op-budget__foot">
      <span>{t.budget.limit}</span>
      <b class="op-budget__down">{t.budget.down}</b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="prompt" hidden>
  <div class="anchor op-card op-prompt" id="op-prompt">
    <div class="op-card__title">
      <span>{t.prompt.title}</span>
      <span class="op-hour op-room" id="op-hour">
        {t.prompt.hour}
      </span>
    </div>
    {t.prompt.parts.map((part, i) => (
      <div class="op-part" id={`op-part-${i + 1}`}>
        {part}
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="pcache" hidden>
  <div class="anchor op-box op-pcache">
    <div class="op-box__title">
      <Fragment set:html={bolt} />
      {t.pcache.title}
    </div>
    <div class="op-held op-room" id="op-held">
      <span>{t.pcache.held}</span>
      <b>{t.pcache.ttl}</b>
    </div>
    <div class="op-status" id="op-pcache-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="histogram" hidden>
  <div class="anchor op-card op-hist">
    <div class="op-card__title">{t.histogram.title}</div>
    <div class="op-bars">
      {HISTOGRAM.map((h, i) => (
        <span class="op-bucket">
          <i id={`op-bucket-${i + 1}`} style={`--h:${h}`} />
          {MARKS.filter(([, bucket]) => bucket === i).map(([name]) => (
            <span class="op-p">{name}</span>
          ))}
        </span>
      ))}
    </div>
    <div class="op-axis">{t.histogram.axis}</div>
  </div>
</div>

<div class="scene-actor" data-actor="admin" hidden>
  <div class="anchor op-admin">
    <span
      class="op-admin__who"
      set:html={personSVG({
        id: 'op-ana',
        skin: 'b',
        hair: 'a',
        shirt: 'keyword',
        plate: true,
        hairStyle: 2,
      })}
    />
    <span class="op-admin__label">{t.admin}</span>
  </div>
</div>

<div class="scene-actor" data-actor="evals" hidden>
  <div class="anchor op-card op-evals">
    <div class="op-card__title">
      <Fragment set:html={flask} />
      {t.evals.title}
    </div>
    <div class="op-cases">
      {t.evals.cases.map((name, i) => (
        <span class="op-case" id={`op-case-${i + 1}`}>
          {name}
        </span>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="judge" hidden>
  <div class="anchor op-box op-judge">
    <div class="op-box__title">
      <Fragment set:html={scale} />
      {t.judge.title}
    </div>
    <div class="op-box__sub">claude-haiku-5-5</div>
    <div class="op-status" id="op-judge-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="trace" hidden>
  <div class="anchor op-card op-trace" id="op-trace">
    <div class="op-card__title">
      <Fragment set:html={spark} />
      Jaeger
    </div>
    {SPANS.map(([kind, from, to], i) => (
      <div class:list={['op-span', `op-span--${kind}`]}>
        <span>{t.trace[kind]}</span>
        <span class="op-lane">
          <i id={`op-span-${i + 1}`} style={`--from:${from};--to:${to}`} />
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="spanattrs" hidden>
  <div class="anchor op-card op-attrs">
    <div class="op-card__title">{t.attrs.title}</div>
    {t.attrs.rows.map((row, i) => (
      <div class="op-attr op-room" id={`op-attr-${i + 1}`}>
        {row}
      </div>
    ))}
    <div class="op-attr op-attr--none op-room" id="op-attr-none">
      {t.attrs.none}
    </div>
  </div>
</div>
