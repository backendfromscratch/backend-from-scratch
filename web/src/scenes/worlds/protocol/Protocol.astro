---
/**
 * The protocol world's actors (protocol.ts says what they do): Chrome, your terminal, example.com,
 * the written rules (RFC 9110 and 9112), the programs that follow them, and a list of protocols.
 * Every part that shows up later already has its room (spec §4.3). Ids start with `pr-`.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/><circle cx="11.5" cy="4.75" r=".6" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".6" fill="currentColor"/>',
);
const doc = icon('<path d="M4 1.8h5.5L12.5 5v9.2H4Z"/><path d="M9.5 1.8V5h3M6 8h4.5M6 10.5h4.5"/>');
const impls = ['Chrome', 'curl', 'nginx', 'nc'];
const protocols = [
  ['http', 'HTTP', 'text'],
  ['dns', 'DNS', 'binary'],
  ['tcp', 'TCP', 'binary'],
  ['tls', 'TLS', ''],
  ['ssh', 'SSH', ''],
  ['smtp', 'SMTP', ''],
] as const;
const kindOf = {
  http: 'http',
  dns: 'dns',
  tcp: 'tcp',
  tls: 'tls',
  ssh: 'muted',
  smtp: 'muted',
} as const;
---

<div class="scene-actor" data-actor="chrome">
  <div class="anchor pr-window pr-chrome">
    <div class="pr-window__bar">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="pr-chrome__url">localhost:8080</div>
    <div class="pr-chrome__page">
      <span id="pr-hello">{t.hello}</span>
    </div>
  </div>
  <span class="scene-label">{t.chrome}</span>
</div>

<div class="scene-actor" data-actor="console">
  <div class="anchor pr-window pr-console">
    <div class="pr-window__bar">
      <i></i>
      <i></i>
      <i></i>
      <span>{t.console}</span>
    </div>
    <div class="pr-console__body">
      <div class="pr-console__cmd">
        <span class="pr-console__prompt">$</span>
        <span id="pr-cmd"></span>
      </div>
      <pre class="pr-console__out" id="pr-out"></pre>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="site" hidden>
  <div class="anchor pr-box">
    <div class="pr-box__title">
      <Fragment set:html={rack} />
      example.com
    </div>
    <div class="pr-box__sub">{t.siteSub}</div>
  </div>
</div>

<div class="scene-actor" data-actor="rfc">
  <div class="anchor pr-rfc">
    <div class="pr-rfc__page">
      <div class="pr-box__title">
        <Fragment set:html={doc} />
        RFC 9110
      </div>
      <div class="pr-box__sub">{t.rfc9110}</div>
    </div>
    <div class="pr-rfc__page">
      <div class="pr-box__title">
        <Fragment set:html={doc} />
        RFC 9112
      </div>
      <div class="pr-box__sub">{t.rfc9112}</div>
    </div>
  </div>
  <span class="scene-label">{t.rfc}</span>
</div>

<div class="scene-actor" data-actor="impls" hidden>
  <div class="anchor pr-impls">
    {impls.map((name) => (
      <span class="pr-impl" id={`pr-impl-${name.toLowerCase()}`}>
        {name}
      </span>
    ))}
  </div>
  <span class="scene-label">{t.impls}</span>
</div>

<div class="scene-actor" data-actor="stack" hidden>
  <ul class="anchor pr-stack" role="list">
    {protocols.map(([id, name, kind]) => (
      <li class="pr-stack__row" data-kind={kindOf[id]}>
        <span class="pr-stack__name" id={`pr-p-${id}`}>
          {name}
        </span>
        <span class="pr-stack__use">{t.uses[id]}</span>
        <span class="pr-stack__kind">{kind ? t[kind] : ''}</span>
      </li>
    ))}
  </ul>
  <span class="scene-label">{t.stack}</span>
</div>
