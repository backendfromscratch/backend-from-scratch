---
/**
 * The loop world's actors (loop.ts says what they do): Luis and Ana, the shop's API with your
 * code's single thread, the queue, the fulfilled promises' queue, libuv's four helper threads, the
 * operating system, the two `curl` of the text's diagrams, `ejemplos/orden.ts` and what it prints,
 * the text's four ways out, ten people at once and the analogy's restaurant. Every part that changes
 * keeps its room (spec §4.3): the slots, the bars, the outputs and the marks have fixed sizes. People
 * are worlds/people.ts's busts; the restaurant's furniture is SVG, its words HTML. Ids start with `lp-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { HELPERS, PEOPLE, QUEUE_SLOTS } from './loop';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/>',
);
const lines = icon('<path d="M3 4h10M3 8h10M3 12h6"/>');
const threads = icon('<path d="M2.5 4h11M2.5 7.3h11M2.5 10.6h11M2.5 13.9h7"/>');
const chip = icon(
  '<rect x="4" y="4" width="8" height="8" rx="1.2"/><path d="M6.5 1.8v2.2M9.5 1.8v2.2M6.5 12v2.2M9.5 12v2.2M1.8 6.5H4M1.8 9.5H4M12 6.5h2.2M12 9.5h2.2"/>',
);
const file = icon('<path d="M4 1.8h5l3 3v9.4H4z"/><path d="M9 1.8v3h3"/>');
const ways = icon(
  '<path d="M8 14V8M8 8L3.5 3.5M8 8l4.5-4.5M3.5 3.5v3M3.5 3.5h3M12.5 3.5h-3M12.5 3.5v3"/>',
);
const bell =
  '<svg viewBox="0 0 20 18" aria-hidden="true"><path class="lp-bell__dome" d="M3 14 C3 7 6.5 4 10 4 C13.5 4 17 7 17 14 Z"/><rect class="lp-bell__base" x="1" y="14" width="18" height="3" rx="1.2"/><circle class="lp-bell__knob" cx="10" cy="3" r="1.6"/></svg>';
const table =
  '<svg viewBox="0 0 68 36" aria-hidden="true"><rect class="lp-table__top" x="0" y="0" width="68" height="12" rx="2"/><path class="lp-table__legs" d="M8 12 V34 M60 12 V34"/></svg>';
const potatoes =
  '<svg viewBox="0 0 30 14" aria-hidden="true"><ellipse class="lp-potato" cx="7" cy="9" rx="6" ry="4.5"/><ellipse class="lp-potato" cx="17" cy="9.5" rx="6.5" ry="4.2"/><ellipse class="lp-potato" cx="12" cy="4.8" rx="5.5" ry="4"/><ellipse class="lp-potato" cx="24.5" cy="10" rx="5" ry="3.8"/></svg>';
const people = Array.from({ length: PEOPLE }, (_, i) => i + 1);
---

<!-- Luis and Ana: the problem's customers, and the two requests of «Un solo hilo». -->
<div class="lp-people" data-group>
  <div class="scene-actor" data-actor="luis" hidden>
    <div
      class="anchor lp-person"
      set:html={personSVG({ id: 'lp-luis', skin: 'a', hair: 'b', shirt: 'info', facing: 'right' })}
    />
    <span class="scene-label">Luis</span>
    <span class="lp-clock" id="lp-luis-clock"></span>
  </div>
  <div class="scene-actor" data-actor="ana" hidden>
    <div
      class="anchor lp-person"
      set:html={personSVG({
        id: 'lp-ana',
        skin: 'b',
        hair: 'a',
        shirt: 'keyword',
        hairStyle: 2,
        facing: 'right',
      })}
    />
    <span class="scene-label">Ana</span>
    <span class="lp-clock" id="lp-ana-clock"></span>
  </div>
</div>

<!-- The two clients of the text's diagrams and of «Pruébalo», each with what it printed. -->
<div class="lp-curls" data-group>
  <div class="scene-actor" data-actor="slowcurl" hidden>
    <div class="anchor lp-curl">
      <div class="lp-curl__cmd">
        <span class="lp-prompt">$</span> curl{' '}
        <span class="lp-curl__route" id="lp-slow-route">
          {t.routes.slow}
        </span>
      </div>
      <div class="lp-curl__out" id="lp-slow-out"></div>
    </div>
  </div>
  <div class="scene-actor" data-actor="listcurl" hidden>
    <div class="anchor lp-curl">
      <div class="lp-curl__cmd">
        <span class="lp-prompt">$</span> curl <span class="lp-curl__route">{t.routes.list}</span>
      </div>
      <div class="lp-curl__out" id="lp-list-out"></div>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="nodeapi" hidden>
  <div class="anchor lp-box">
    <div class="lp-box__title">
      <Fragment set:html={rack} />
      {t.api}
    </div>
    <div class="lp-box__sub">{t.thread}</div>
    <div class="lp-slot lp-run" id="lp-run">
      {t.free}
    </div>
    <span class="lp-bar lp-bar--thread" id="lp-bar">
      <i></i>
    </span>
  </div>
</div>

<div class="scene-actor" data-actor="promiseq" hidden>
  <div class="anchor lp-box">
    <div class="lp-box__title">
      <Fragment set:html={lines} />
      {t.promises}
    </div>
    <div class="lp-slot" id="lp-p-1"></div>
  </div>
</div>

<div class="scene-actor" data-actor="eventq" hidden>
  <div class="anchor lp-box">
    <div class="lp-box__title">
      <Fragment set:html={lines} />
      {t.queue}
    </div>
    {Array.from({ length: QUEUE_SLOTS }, (_, i) => (
      <div class="lp-slot" id={`lp-q-${i + 1}`} />
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="libuv" hidden>
  <div class="anchor lp-box lp-box--side">
    <div class="lp-box__title">
      <Fragment set:html={threads} />
      libuv
    </div>
    <div class="lp-box__sub">{t.helpers}</div>
    <div class="lp-lanes">
      {Array.from({ length: HELPERS }, (_, i) => (
        <span class="lp-bar lp-lane" id={`lp-h-${i + 1}`}>
          <i />
        </span>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="os" hidden>
  <div class="anchor lp-box lp-box--side">
    <div class="lp-box__title">
      <Fragment set:html={chip} />
      {t.os}
    </div>
    <div class="lp-box__sub">{t.network}</div>
    <div class="lp-slot lp-os" id="lp-os-wait"></div>
  </div>
</div>

<div class="scene-actor" data-actor="orderts" hidden>
  <div class="anchor lp-box lp-box--wide">
    <div class="lp-box__title">
      <Fragment set:html={file} />
      {t.code.file}
    </div>
    <div class="lp-code">
      {t.code.lines.map((line, i) => (
        <code class="lp-code__line" id={`lp-line-${i + 1}`}>
          {line}
        </code>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="stdout" hidden>
  <div class="anchor lp-term">
    <div class="lp-term__title">
      <span class="lp-prompt">$</span>
      {` ${t.output.cmd}`}
    </div>
    {t.output.lines.map((line, i) => (
      <div class="lp-term__line" id={`lp-out-${i + 1}`}>
        {line}
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="ways" hidden>
  <div class="anchor lp-box lp-box--wide">
    <div class="lp-box__title">
      <Fragment set:html={ways} />
      {t.ways.title}
    </div>
    {t.ways.rows.map(([what, how], i) => (
      <div class="lp-way" id={`lp-way-${i + 1}`}>
        <b class="lp-way__n">{i + 1}</b>
        <span class="lp-way__what">{what}</span>
        <span class="lp-way__how">{how}</span>
      </div>
    ))}
  </div>
</div>

<!-- Ten people asking at once for a route that blocks; each mark becomes a check when served. -->
<div class="scene-actor" data-actor="ten" hidden>
  <div class="anchor lp-ten">
    {people.map((n) => (
      <div class="lp-ten__one" id={`lp-ten-${n}`}>
        <div
          set:html={personSVG({
            id: `lp-tp-${n}`,
            skin: n % 3 === 0 ? 'b' : 'a',
            hair: n % 2 === 0 ? 'b' : 'a',
            shirt: n % 2 === 0 ? 'keyword' : 'info',
            hairStyle: n % 4 < 2 ? 1 : 2,
            facing: 'right',
          })}
        />
        <span class="lp-ten__mark" id={`lp-ten-${n}-mark`}>
          {n}
        </span>
      </div>
    ))}
  </div>
</div>

<!--
  The analogy: a restaurant seen from the front. Three tables with their diners at the back, the
  kitchen on the right with the bell on its pass, and the waiter, who walks along the front; when
  table 3 asks him to peel potatoes, the pile is on the floor beside him.
-->
<div class="scene-actor" data-actor="dining" hidden>
  <div class="anchor lp-dining" id="lp-dining">
    <svg
      class="lp-dining__room"
      viewBox="0 0 460 240"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <rect class="lp-wall" x="3" y="3" width="454" height="234" rx="6"></rect>
      <path class="lp-floor" d="M3 226 H457"></path>
      <path class="lp-divider" d="M330 3 V136"></path>
      <rect class="lp-pass" x="310" y="136" width="40" height="6" rx="2"></rect>
      <rect class="lp-stove" x="372" y="170" width="76" height="56" rx="3"></rect>
      <path class="lp-pot" d="M384 170 V154 H436 V170 Z"></path>
      <path
        class="lp-steam"
        d="M396 148 q-4 -6 0 -12 q4 -6 0 -12 M410 146 q-4 -6 0 -12 q4 -6 0 -12 M424 148 q-4 -6 0 -12 q4 -6 0 -12"
      ></path>
    </svg>
    {t.tables.map((name, i) => (
      <span class={`lp-room lp-room--t${i + 1}`}>{name}</span>
    ))}
    <span class="lp-room lp-room--kitchen">{t.kitchen}</span>
    {[1, 2, 3].map((i) => (
      <div
        class={`lp-diner lp-diner--${i}`}
        set:html={personSVG({
          id: `lp-diner-${i}`,
          skin: i === 2 ? 'a' : 'b',
          hair: i === 1 ? 'a' : 'b',
          shirt: i === 2 ? 'keyword' : 'info',
          hairStyle: i === 3 ? 2 : 1,
          facing: 'right',
        })}
      />
    ))}
    {[1, 2, 3].map((i) => (
      <span class={`lp-table lp-table--${i}`} id={`lp-table-${i}`} set:html={table} />
    ))}
    <span class="lp-bell" id="lp-bell" set:html={bell} />
    <span class="lp-potatoes" set:html={potatoes} />
    <span class="lp-bar lp-peel" id="lp-peel">
      <i></i>
    </span>
    <div
      class="lp-waiter"
      id="lp-waiter"
      set:html={personSVG({
        id: 'lp-server',
        skin: 'a',
        hair: 'a',
        shirt: 'keyword',
        apron: true,
        facing: 'left',
      })}
    />
  </div>
</div>
