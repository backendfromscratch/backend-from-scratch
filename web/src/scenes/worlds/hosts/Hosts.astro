---
/**
 * The hosts world's actors (hosts.ts says what they do): your browser, a server far away, a
 * computer seen inside (two programs over the operating system and its ports), the terminal where
 * `nc -l 8080` listens, and your laptop with both side by side. Every part that shows up later
 * already has its room (spec §4.3). Ids start with `hs-`.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/><circle cx="11.5" cy="4.75" r=".6" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".6" fill="currentColor"/>',
);
const ear = icon(
  '<path d="M5 6.5a3 3 0 1 1 6 0c0 2-2 2.5-2 4.5a2 2 0 0 1-3.6 1.2M7 6.8a1 1 0 1 1 2 0"/>',
);
const program = icon(
  '<rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M2 6h12M4.5 8.5l1.6 1.4-1.6 1.4"/>',
);
const request =
  'GET / HTTP/1.1\nHost: localhost:8080\nUser-Agent: Mozilla/5.0 …\nAccept: text/html,…';
const response = `HTTP/1.1 200 OK\nContent-Type: text/plain; charset=utf-8\n\n${t.hello}`;
---

<div class="scene-actor" data-actor="browser">
  <div class="anchor hs-window hs-browser">
    <div class="hs-window__bar">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="hs-browser__url" id="hs-url">
      <span class="hs-browser__address">localhost:8080</span>
    </div>
    <div class="hs-browser__page">
      <span class="hs-spin" id="hs-spin"></span>
      <span class="hs-browser__hello" id="hs-hello">
        {t.hello}
      </span>
    </div>
  </div>
  <span class="scene-label">{t.browser}</span>
</div>

<div class="scene-actor" data-actor="server" hidden>
  <div class="anchor hs-box">
    <div class="hs-box__title">
      <Fragment set:html={rack} />
      {t.server}
    </div>
    <div class="hs-box__sub">{t.serverSub}</div>
  </div>
</div>

<div class="scene-actor" data-actor="machine" hidden>
  <div class="anchor hs-box hs-machine">
    <div class="hs-box__title">
      <Fragment set:html={rack} />
      {t.computer}
    </div>
    <div class="hs-program" id="hs-program">
      <Fragment set:html={program} />
      <span class="hs-program__name">{t.serverProgram}</span>
      <span class="hs-program__state" id="hs-program-state">
        <span class="hs-program__idle">{t.idle}</span>
        <span class="hs-program__on">
          <Fragment set:html={ear} />
          {t.listening}
        </span>
      </span>
    </div>
    <div class="hs-program hs-program--other">
      <Fragment set:html={program} />
      <span class="hs-program__name">{t.otherProgram}</span>
    </div>
    <div class="hs-os">
      <span class="hs-os__name">{t.os}</span>
      <span class="hs-port">80</span>
      <span class="hs-port">443</span>
      <span class="hs-port" id="hs-port">
        8080
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="terminal" hidden>
  <div class="anchor hs-window hs-term">
    <div class="hs-window__bar">
      <i></i>
      <i></i>
      <i></i>
      <span>{t.terminal}</span>
    </div>
    <div class="hs-term__body">
      <div class="hs-term__line">
        <span class="hs-term__prompt">$</span>
        <span id="hs-cmd"></span>
      </div>
      <pre class="hs-term__block hs-term__request" id="hs-request">{request}</pre>
      <pre class="hs-term__block hs-term__response" id="hs-response" data-full={response}></pre>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="laptop" hidden>
  <div class="anchor sc-scenery hs-laptop">
    <svg viewBox="0 0 300 190" preserveAspectRatio="none" aria-hidden="true">
      <rect class="hs-laptop__lid" x="30" y="6" width="240" height="160" rx="9"></rect>
      <rect class="hs-laptop__screen" x="40" y="16" width="220" height="140" rx="4"></rect>
      <path class="hs-laptop__base" d="M6 172 H294 L282 186 H18 Z"></path>
    </svg>
    <div class="hs-mini hs-mini--browser" id="hs-mini-browser">
      <span class="hs-mini__bar">localhost:8080</span>
      <span class="hs-mini__page">{t.hello}</span>
    </div>
    <div class="hs-mini hs-mini--term" id="hs-mini-term">
      <span class="hs-mini__bar">{t.terminal}</span>
      <span class="hs-mini__page">$ nc -l 8080</span>
    </div>
  </div>
  <span class="scene-label">{t.laptop}</span>
</div>
