---
/**
 * The weather the backend's data describes, as one frontend draws it (Apps.astro): the same data,
 * a different look on the website, the iPhone app and the Android app. Invisible until painted.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';

interface Props {
  kind: 'web' | 'ios' | 'android';
  lang: Locale;
}

const { kind, lang } = Astro.props;
const t = strings[lang];
const sun =
  '<svg class="ap-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.6"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg>';
---

<div class={`ap-wx ap-wx--${kind}`} data-paint>
  <Fragment set:html={sun} />
  <span class="ap-wx__temp">{kind === 'ios' ? '17°' : '17 °C'}</span>
  <span class="ap-wx__place">{t.city}</span>
  <span class="ap-wx__sky">{t.clear}</span>
</div>
