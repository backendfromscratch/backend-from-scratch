---
/**
 * A concert seat map (Apps.astro): rows E to G, seats 11 to 16. Some seats are already sold; 14F,
 * the one you buy, carries `data-seat` so apps.ts can mark it. `mini` is the crowd's small version.
 */
interface Props {
  mini?: boolean;
}

const rows = ['E', 'F', 'G'];
const numbers = [11, 12, 13, 14, 15, 16];
const taken = new Set(['12E', '15E', '11F', '16F', '13G', '14G']);
---

<div class:list={['ap-seats', { 'ap-seats--mini': Astro.props.mini }]}>
  {rows.map((row) => (
    <div class="ap-seats__row">
      {numbers.map((n) => {
        const seat = `${n}${row}`;
        return (
          <span
            class:list={['ap-seat', { 'is-taken': taken.has(seat) }]}
            data-seat={seat === '14F' ? seat : undefined}
          />
        );
      })}
    </div>
  ))}
</div>
