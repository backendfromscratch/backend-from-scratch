---
/**
 * The apps world's actors (apps.ts says what they do): a concert ticket app on your phone and on
 * other people's, the store's backend with the services behind it, and a weather backend with three
 * frontends and your terminal. HTML boxes with their text at its own size, SVG only for shapes, and
 * every part that shows up later already has its room (spec §4.3). Ids start with `ap-`.
 */
import type { Locale } from '~/lib/locales';
import SeatMap from './SeatMap.astro';
import { strings } from './strings';
import WeatherCard from './WeatherCard.astro';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/><circle cx="11.5" cy="4.75" r=".6" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".6" fill="currentColor"/>',
);
const code = icon('<path d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5M9 3 7 13"/>');
const key = icon('<circle cx="5" cy="8" r="3"/><path d="M8 8h6.3M12.2 8v2.6M14.2 8v2"/>');
const cylinder = icon(
  '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
);
const card = icon(
  '<rect x="1.8" y="3.5" width="12.4" height="9" rx="1.5"/><path d="M1.8 6.5h12.4M4.3 10h3"/>',
);
const envelope = icon(
  '<rect x="1.8" y="3.5" width="12.4" height="9" rx="1.5"/><path d="m2.3 4.3 5.7 4.5 5.7-4.5"/>',
);
const cloud = icon(
  '<path d="M4.6 12.5h7a2.9 2.9 0 0 0 .3-5.8 4 4 0 0 0-7.6.9 2.5 2.5 0 0 0 .3 4.9Z"/>',
);
---

<div class="scene-actor" data-actor="phone">
  <div class="anchor ap-phone" id="ap-phone">
    <div class="ap-phone__title">{t.concert}</div>
    <SeatMap />
    <div class="ap-phone__buy" id="ap-buy">
      {t.buy}
    </div>
  </div>
  <span class="scene-label">{t.phone}</span>
</div>

<div class="scene-actor" data-actor="crowd" hidden>
  <div class="anchor ap-crowd">
    {[1, 2, 3].map(() => (
      <div class="ap-phone ap-phone--mini">
        <SeatMap mini />
      </div>
    ))}
  </div>
  <span class="scene-label">{t.crowd}</span>
</div>

<div class="scene-actor" data-actor="internet" hidden>
  <div class="anchor ap-net"></div>
</div>

<div class="scene-actor" data-actor="backend">
  <div class="anchor ap-box ap-backend">
    <div class="ap-box__title">
      <Fragment set:html={rack} />
      {t.backend}
    </div>
    <div class="ap-box__sub">{t.backendSub}</div>
    <div class="ap-backend__row">
      <Fragment set:html={code} />
      {t.program}
    </div>
    <ul class="ap-backend__checks" role="list">
      <li id="ap-check-1">
        <b class="ap-check"></b>
        {t.checks[0]}
      </li>
      <li id="ap-check-2">
        <b class="ap-check"></b>
        {t.checks[1]}
      </li>
    </ul>
    <div class="ap-backend__row ap-backend__key" id="ap-key">
      <Fragment set:html={key} />
      {t.key}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="db" hidden>
  <div class="anchor ap-box ap-db">
    <div class="ap-box__title">
      <Fragment set:html={cylinder} />
      {t.db}
    </div>
    <div class="ap-db__row">
      <span>14F</span>
      <span class="ap-db__state" id="ap-db-state" data-state="free">
        {t.seat.free}
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="pay" hidden>
  <div class="anchor ap-box">
    <div class="ap-box__title">
      <Fragment set:html={card} />
      {t.pay}
    </div>
    <div class="ap-box__sub">{t.other}</div>
  </div>
</div>

<div class="scene-actor" data-actor="mail" hidden>
  <div class="anchor ap-box">
    <div class="ap-box__title">
      <Fragment set:html={envelope} />
      {t.mail}
    </div>
    <div class="ap-box__sub">{t.other}</div>
  </div>
</div>

<div class="scene-actor" data-actor="weather" hidden>
  <div class="anchor ap-box ap-weather">
    <div class="ap-box__title">
      <Fragment set:html={cloud} />
      {t.weather}
    </div>
    <div class="ap-box__sub">Open-Meteo</div>
  </div>
</div>

<div class="scene-actor" data-actor="web" hidden>
  <div class="anchor ap-device ap-device--web">
    <div class="ap-device__bar">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <WeatherCard kind="web" lang={Astro.props.lang} />
  </div>
  <span class="scene-label">{t.web}</span>
</div>

<div class="scene-actor" data-actor="ios" hidden>
  <div class="anchor ap-device ap-device--ios">
    <WeatherCard kind="ios" lang={Astro.props.lang} />
  </div>
  <span class="scene-label">{t.ios}</span>
</div>

<div class="scene-actor" data-actor="android" hidden>
  <div class="anchor ap-device ap-device--android">
    <WeatherCard kind="android" lang={Astro.props.lang} />
  </div>
  <span class="scene-label">{t.android}</span>
</div>

<div class="scene-actor" data-actor="terminal" hidden>
  <div class="anchor ap-term">
    <div class="ap-term__bar">
      <i></i>
      <i></i>
      <i></i>
      <span>{t.terminal}</span>
    </div>
    <div class="ap-term__line">
      <span class="ap-term__prompt">$</span>
      <span class="ap-term__cmd" id="ap-curl"></span>
    </div>
    <div class="ap-term__out" id="ap-json">
      {t.answer}
    </div>
  </div>
</div>
