---
/**
 * The rag world's actors (rag.ts says what they do): the table of the help's chunks, the returns
 * page as Markdown, one chunk's text, the top-k, the assistant's rules, the search results, the
 * JSON answer and the evals. HTML boxes with their text at its own size, SVG only for icons; every
 * part that shows up later already has its room (spec §4.3). Ids start with `rg-`.
 */
import type { Locale } from '~/lib/locales';
import { RAG_INITIAL, TOP, sources } from './rag';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const lang = Astro.props.lang;
const t = strings[lang];
const s = RAG_INITIAL;
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const cylinder = icon(
  '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
);
const file = icon('<path d="M4 1.8h5.2L12.5 5v9.2H4zM9 1.8V5h3.5M6 8.2h4.5M6 10.8h4.5"/>');
const flask = icon(
  '<path d="M6 2h4M6.8 2v4.2L3 13a1 1 0 0 0 .9 1.5h8.2A1 1 0 0 0 13 13L9.2 6.2V2M4.6 10h6.8"/>',
);
const returns = t.pages[t.doc.page]!;
---

<div class="scene-actor" data-actor="helpdb" hidden>
  <div class={s.rgChunks ? 'anchor rg-box rg-db' : 'anchor rg-box rg-db is-empty'} id="rg-db">
    <div class="rg-box__title">
      <Fragment set:html={cylinder} />
      {t.table}
      <b class="rg-count" id="rg-count">
        {s.rgCount}
      </b>
    </div>
    {t.pages.map((page, p) => (
      <div class="rg-db__row" id={`rg-page-${p + 1}`}>
        <span class="rg-db__name">{page.name}</span>
        <span class="rg-tiles">
          {page.sections.map((_, i) => (
            <i class="rg-tile" id={`rg-tile-${p * 4 + i + 1}`} />
          ))}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="helpdoc" hidden>
  <div class="anchor rg-box rg-doc">
    <div class="rg-box__title">
      <Fragment set:html={file} />
      {t.doc.file}
    </div>
    <div class="rg-md rg-md--h1"># {t.doc.title}</div>
    {returns.sections.map((section, i) => (
      <div class="rg-md" id={`rg-md-${i + 1}`}>
        ## {section}
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="chunkcard" hidden>
  <div class="anchor rg-card rg-chunk">
    <div class="rg-card__title">{t.chunk.title}</div>
    <div class="rg-chunk__line rg-room" id="rg-chunk-page">
      {t.doc.title}:
    </div>
    <div class="rg-chunk__line rg-room" id="rg-chunk-section">
      {returns.sections[1]}.
    </div>
    <div class="rg-chunk__line">{t.chunk.lead}</div>
  </div>
</div>

<div class="scene-actor" data-actor="topk" hidden>
  <div class="anchor rg-card rg-top">
    <div class="rg-top__how" id="rg-how">
      {t.byMeaning}
    </div>
    <div class="rg-top__query">
      <span class="rg-pin"></span>
      <span id="rg-query"></span>
    </div>
    {Array.from({ length: TOP }, (_, i) => (
      <div class="rg-top__row is-empty" id={`rg-row-${i + 1}`}>
        <span id={`rg-sec-${i + 1}`} />
        <b id={`rg-dist-${i + 1}`} />
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="rulecard" hidden>
  <div class="anchor rg-card rg-rules">
    <div class="rg-card__title">
      <Fragment set:html={file} />
      {t.rules.title}
    </div>
    {t.rules.rows.map((rule, i) => (
      <div class="rg-rule" id={`rg-rule-${i + 1}`}>
        <span>{i < 3 ? i + 1 : '+'}</span>
        {rule}
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="results" hidden>
  <div class="anchor rg-card rg-results">
    <div class="rg-card__title">{t.results.title}</div>
    {t.lists[s.rgResults].rows.map(([section], i) => (
      <div class="rg-result" id={`rg-res-${i + 1}`}>
        <span id={`rg-result-${i + 1}`}>{section}</span>
        <b class="rg-mark" id={`rg-cite-${i + 1}`} />
      </div>
    ))}
    <div class="rg-card__foot">{t.results.footer}</div>
  </div>
</div>

<div class="scene-actor" data-actor="ragjson" hidden>
  <div class="anchor rg-card rg-json" id="rg-json">
    <div class="rg-card__title">{t.json.title}</div>
    <div class="rg-json__row">
      <span>{t.json.text}</span>
      <span class="rg-json__lines">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </div>
    <div class="rg-json__row">
      <span>{t.json.sources}</span>
      <b id="rg-sources">{sources(lang, s)}</b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="ragevals" hidden>
  <div class="anchor rg-card rg-evals">
    <div class="rg-card__title">
      <Fragment set:html={flask} />
      {t.evals.title}
    </div>
    {t.evals.rows.map(([question, check], i) => (
      <div class="rg-eval" id={`rg-eval-${i + 1}`}>
        <span class="rg-eval__q">{question}</span>
        <span class="rg-eval__check">{check}</span>
        <b class="rg-mark" id={`rg-eval-mark-${i + 1}`} />
      </div>
    ))}
  </div>
</div>
