---
/**
 * The analogies world's actors (analogies.ts): each Phase 11 lesson's analogy. Lesson 1: the shop's
 * counter, with a foreign customer, Ana on the phone and an empty sign, and the phone translation
 * service that counts every word it hears and says. People are SVG (people.ts); every label is HTML.
 * Ids start with `an-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const headset = `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10V8a5 5 0 0 1 10 0v2"/><rect x="2" y="9.5" width="2.6" height="4" rx="1"/><rect x="11.4" y="9.5" width="2.6" height="4" rx="1"/><path d="M13 13.5c0 1-1.5 1.5-3.5 1.5"/></svg>`;
---

<div class="scene-actor" data-actor="frontdesk" hidden>
  <div class="anchor an-desk">
    <div class="an-desk__people">
      <span
        class="an-desk__who"
        set:html={personSVG({ id: 'an-guest', skin: 'a', hair: 'b', shirt: 'info' })}
      />
      <span
        class="an-desk__who"
        set:html={personSVG({
          id: 'an-ana',
          skin: 'b',
          hair: 'a',
          shirt: 'keyword',
          facing: 'left',
          phone: true,
          apron: true,
          hairStyle: 2,
        })}
      />
    </div>
    <div class="an-desk__top">
      <span>{t.counter}</span>
      <span class="an-sign" id="an-sign">
        <span class="an-sign__label">{t.sign}</span>
        <span class="an-sign__card an-room" id="an-card">
          {t.card}
        </span>
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="interp" hidden>
  <div class="anchor an-interp">
    <div class="an-interp__title">
      <Fragment set:html={headset} />
      {t.interp}
    </div>
    {(
      [
        ['heard', t.heard, 8],
        ['said', t.said, 6],
      ] as const
    ).map(([id, label, n]) => (
      <div class="an-tally">
        <span>{label}</span>
        <span class="an-tally__cells">
          {Array.from({ length: n }, (_, i) => (
            <i class="an-cell" id={`an-${id}-${i + 1}`} />
          ))}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="speaker" hidden>
  <div class="anchor an-figure">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-speaker', skin: 'a', hair: 'a', shirt: 'info', hairStyle: 2 })}
    />
    <span class="an-lectern"></span>
    <span class="an-figure__label">{t.speaker}</span>
  </div>
</div>

<div class="scene-actor" data-actor="booth" hidden>
  <div class="anchor an-booth">
    <div class="an-interp__title">
      <Fragment set:html={headset} />
      {t.booth}
    </div>
    <div class="an-booth__mode" id="an-mode"></div>
    <div class="an-booth__held">
      {[1, 2, 3].map((i) => (
        <i class="an-cell an-held" id={`an-held-${i}`} />
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="audience" hidden>
  <div class="anchor an-figure" id="an-audience">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-you', skin: 'b', hair: 'b', shirt: 'keyword', facing: 'left' })}
    />
    <span class="an-seat"></span>
    <span class="an-figure__label">{t.you}</span>
  </div>
</div>

<div class="scene-actor" data-actor="caller" hidden>
  <div class="anchor an-figure">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-caller', skin: 'b', hair: 'b', shirt: 'keyword', phone: true })}
    />
    <span class="an-figure__label">{t.customer}</span>
  </div>
</div>

<div class="scene-actor" data-actor="operator" hidden>
  <div class="anchor an-operator">
    <span
      class="an-figure__who"
      set:html={personSVG({
        id: 'an-operator',
        skin: 'a',
        hair: 'a',
        shirt: 'info',
        facing: 'left',
        phone: true,
        hairStyle: 2,
      })}
    />
    <span class="an-sheet" id="an-sheet">
      {t.sheet}
    </span>
    <span class="an-figure__label">{t.operator}</span>
  </div>
</div>

<div class="scene-actor" data-actor="warehouse" hidden>
  <div class="anchor an-booth an-warehouse">
    <div class="an-interp__title">{t.warehouse}</div>
    <div class="an-screen" id="an-screen">
      <span>{t.onLine}</span>
      <span
        class="an-screen__who an-room"
        id="an-on-line"
        set:html={personSVG({
          id: 'an-on-line-who',
          skin: 'b',
          hair: 'b',
          shirt: 'keyword',
          plate: true,
        })}
      />
    </div>
    <div class="an-row">
      <span>{t.theirs}</span>
      <b class="an-mark" id="an-theirs"></b>
    </div>
    <div class="an-row">
      <span>{t.others}</span>
      <b class="an-mark" id="an-others"></b>
    </div>
  </div>
</div>
