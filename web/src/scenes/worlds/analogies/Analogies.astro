---
/**
 * The analogies world's actors (analogies.ts): each Phase 11 lesson's analogy. Lesson 1: the shop's
 * counter, with a foreign customer, Ana on the phone and an empty sign, and the phone translation
 * service that counts every word it hears and says. Lessons 2 and 3: a talk with its booth, and a
 * call center. Lesson 4: phones and a laptop with their chargers. Lesson 5: a supermarket's aisles. People are SVG (people.ts); every label is HTML.
 * Ids start with `an-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
// Lesson 4: each device's port and its charger's plug before USB-C, all different (round, a
// trapezoid, a square), centred on their point; with USB-C, the same rounded one for all.
const OLD = ['M0 -3a3 3 0 1 0 0.01 0z', 'M-6 -2h12l-2.5 4h-7z', 'M-3 -3h6v6h-6z'];
const headset = `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10V8a5 5 0 0 1 10 0v2"/><rect x="2" y="9.5" width="2.6" height="4" rx="1"/><rect x="11.4" y="9.5" width="2.6" height="4" rx="1"/><path d="M13 13.5c0 1-1.5 1.5-3.5 1.5"/></svg>`;
---

<div class="scene-actor" data-actor="frontdesk" hidden>
  <div class="anchor an-desk">
    <div class="an-desk__people">
      <span
        class="an-desk__who"
        set:html={personSVG({ id: 'an-guest', skin: 'a', hair: 'b', shirt: 'info' })}
      />
      <span
        class="an-desk__who"
        set:html={personSVG({
          id: 'an-ana',
          skin: 'b',
          hair: 'a',
          shirt: 'keyword',
          facing: 'left',
          phone: true,
          apron: true,
          hairStyle: 2,
        })}
      />
    </div>
    <div class="an-desk__top">
      <span>{t.counter}</span>
      <span class="an-sign" id="an-sign">
        <span class="an-sign__label">{t.sign}</span>
        <span class="an-sign__card an-room" id="an-card">
          {t.card}
        </span>
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="interp" hidden>
  <div class="anchor an-interp">
    <div class="an-interp__title">
      <Fragment set:html={headset} />
      {t.interp}
    </div>
    {(
      [
        ['heard', t.heard, 8],
        ['said', t.said, 6],
      ] as const
    ).map(([id, label, n]) => (
      <div class="an-tally">
        <span>{label}</span>
        <span class="an-tally__cells">
          {Array.from({ length: n }, (_, i) => (
            <i class="an-cell" id={`an-${id}-${i + 1}`} />
          ))}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="speaker" hidden>
  <div class="anchor an-figure">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-speaker', skin: 'a', hair: 'a', shirt: 'info', hairStyle: 2 })}
    />
    <span class="an-lectern"></span>
    <span class="an-figure__label">{t.speaker}</span>
  </div>
</div>

<div class="scene-actor" data-actor="booth" hidden>
  <div class="anchor an-booth">
    <div class="an-interp__title">
      <Fragment set:html={headset} />
      {t.booth}
    </div>
    <div class="an-booth__mode" id="an-mode"></div>
    <div class="an-booth__held">
      {[1, 2, 3].map((i) => (
        <i class="an-cell an-held" id={`an-held-${i}`} />
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="audience" hidden>
  <div class="anchor an-figure" id="an-audience">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-you', skin: 'b', hair: 'b', shirt: 'keyword', facing: 'left' })}
    />
    <span class="an-seat"></span>
    <span class="an-figure__label">{t.you}</span>
  </div>
</div>

<div class="scene-actor" data-actor="caller" hidden>
  <div class="anchor an-figure">
    <span
      class="an-figure__who"
      set:html={personSVG({ id: 'an-caller', skin: 'b', hair: 'b', shirt: 'keyword', phone: true })}
    />
    <span class="an-figure__label">{t.customer}</span>
  </div>
</div>

<div class="scene-actor" data-actor="operator" hidden>
  <div class="anchor an-operator">
    <span
      class="an-figure__who"
      set:html={personSVG({
        id: 'an-operator',
        skin: 'a',
        hair: 'a',
        shirt: 'info',
        facing: 'left',
        phone: true,
        hairStyle: 2,
      })}
    />
    <span class="an-sheet" id="an-sheet">
      {t.sheet}
    </span>
    <span class="an-figure__label">{t.operator}</span>
  </div>
</div>

<div class="scene-actor" data-actor="warehouse" hidden>
  <div class="anchor an-booth an-warehouse">
    <div class="an-interp__title">{t.warehouse}</div>
    <div class="an-screen" id="an-screen">
      <span>{t.onLine}</span>
      <span
        class="an-screen__who an-room"
        id="an-on-line"
        set:html={personSVG({
          id: 'an-on-line-who',
          skin: 'b',
          hair: 'b',
          shirt: 'keyword',
          plate: true,
        })}
      />
    </div>
    <div class="an-row">
      <span>{t.theirs}</span>
      <b class="an-mark" id="an-theirs"></b>
    </div>
    <div class="an-row">
      <span>{t.others}</span>
      <b class="an-mark" id="an-others"></b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="chargers" hidden>
  <div class="anchor an-chargers" id="an-chargers">
    {t.devices.map((name, i) => (
      <div class="an-device">
        {i < 2 ? (
          <svg class="an-device__body" viewBox="0 0 40 50" aria-hidden="true">
            <rect class="an-device__case" x="10" y="2" width="20" height="40" rx="4" />
            <rect class="an-device__screen" x="13" y="6" width="14" height="28" rx="1.5" />
            <g id={`an-port-${i + 1}`}>
              <path class="an-old an-port" d={OLD[i]} transform="translate(20 39)" />
              <rect
                class="an-new an-port"
                x="-5"
                y="-2"
                width="10"
                height="4"
                rx="2"
                transform="translate(20 39)"
              />
            </g>
          </svg>
        ) : (
          <svg class="an-device__body" viewBox="0 0 40 50" aria-hidden="true">
            <rect class="an-device__case" x="4" y="10" width="32" height="22" rx="2" />
            <rect class="an-device__screen" x="7" y="13" width="26" height="16" rx="1" />
            <path class="an-device__case" d="M1 34h38l-3 5H4z" />
            <g id={`an-port-${i + 1}`}>
              <path class="an-old an-port" d={OLD[i]} transform="translate(20 42.5)" />
              <rect
                class="an-new an-port"
                x="-5"
                y="-2"
                width="10"
                height="4"
                rx="2"
                transform="translate(20 42.5)"
              />
            </g>
          </svg>
        )}
        <svg class="an-charger" id={`an-plug-${i + 1}`} viewBox="0 0 40 30" aria-hidden="true">
          <path class="an-old an-plug" d={OLD[i]} transform="translate(20 4)" />
          <rect
            class="an-new an-plug"
            x="-5"
            y="-2"
            width="10"
            height="4"
            rx="2"
            transform="translate(20 4)"
          />
          <path class="an-cable" d="M20 7v10" />
          <rect class="an-brick" x="12" y="17" width="16" height="11" rx="2" />
        </svg>
        <span class="an-device__label">{name}</span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="market" hidden>
  <div class="anchor an-market">
    <div class="an-aisles">
      {[0, 1, 2, 3].map((i) => (
        <div class="an-aisle" id={`an-aisle-${i + 1}`}>
          <span class="an-aisle__name">{t.aisles[i] ?? ''}</span>
          <span class="an-aisle__goods an-room" id={`an-goods-${i + 1}`}>
            <i />
            <i />
            <i />
          </span>
          {i === 0 && <span class="an-aisle__spot an-room" id="an-spot" />}
        </div>
      ))}
    </div>
    <div class="an-door">
      <span
        class="an-door__who"
        set:html={personSVG({
          id: 'an-shopper',
          skin: 'b',
          hair: 'b',
          shirt: 'keyword',
          hairStyle: 2,
        })}
      />
      <span class="an-door__label">{t.entrance}</span>
    </div>
  </div>
</div>
