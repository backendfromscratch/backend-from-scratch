---
/**
 * The names world's actors (names.ts says what they do): HOSTS.TXT and the computers that copy it;
 * the hotel of the analogy (you, the front desk with its notebook, three offices); the tree of names;
 * your computer, the resolver with its cache and the three servers of a query; the text's table of
 * records; two resolvers and the servers of a domain whose address changes; and a terminal running
 * `dig`. Every part that changes keeps its room (spec §4.3). Ids start with `nm-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const laptop = icon('<rect x="3" y="3" width="10" height="7" rx="1"/><path d="M1.5 12.5h13"/>');
const globe = icon(
  '<circle cx="8" cy="8" r="6.2"/><path d="M1.8 8h12.4M8 1.8c2.2 2.1 2.2 10.3 0 12.4M8 1.8c-2.2 2.1-2.2 10.3 0 12.4"/>',
);
const file = icon(
  '<path d="M4 1.8h5.5L12.5 5v9.2H4z"/><path d="M9.3 1.8V5h3.2M6 8h4.5M6 10.5h4.5"/>',
);
const phone = icon(
  '<path d="M5.2 2.2 3.4 3.4c-.9.6-1 1.9-.4 3.1a15 15 0 0 0 6.5 6.5c1.2.6 2.5.5 3.1-.4l1.2-1.8-2.6-1.8-1.3 1.3a8 8 0 0 1-3.7-3.7l1.3-1.3z"/>',
);
const servers = [
  ['root', t.root, 'f.root-servers.net'],
  ['tld', '.com', 'e.gtld-servers.net'],
  ['auth', 'example.com', 'elliott.ns.cloudflare.com'],
] as const;
---

<div class="scene-actor" data-actor="hostsfile" hidden>
  <div class="anchor nm-file">
    <div class="nm-title">
      <Fragment set:html={file} />
      HOSTS.TXT <span class="nm-version" id="nm-file-v"></span>
    </div>
    {t.hostsLines.map((line) => (
      <div class="nm-file__line">{line}</div>
    ))}
    <div class="nm-file__line">…</div>
  </div>
</div>

<div class="scene-actor" data-actor="copies" hidden>
  <div class="anchor nm-copies">
    {[1, 2, 3].map((i) => (
      <div class="nm-copy" id={`nm-copy-${i}`}>
        <div class="nm-title">
          <Fragment set:html={laptop} />
          {t.computer}
        </div>
        <div class="nm-copy__file">
          HOSTS.TXT <span class="nm-version" id={`nm-copy-v-${i}`} />
        </div>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="desk" hidden>
  <div class="anchor nm-desk">
    <div class="nm-desk__scene">
      <span
        class="nm-desk__guest"
        set:html={personSVG({
          id: 'nm-guest',
          skin: 'a',
          hair: 'a',
          shirt: 'info',
          facing: 'right',
        })}
      />
      <span
        class="nm-desk__clerk"
        set:html={personSVG({
          id: 'nm-clerk',
          skin: 'b',
          hair: 'b',
          shirt: 'keyword',
          facing: 'left',
          phone: true,
          hairStyle: 2,
        })}
      />
      <div class="nm-desk__counter"></div>
    </div>
    <div class="nm-desk__labels">
      <span>{t.guest}</span>
      <span>{t.clerk}</span>
    </div>
    <div class="nm-book" id="nm-book">
      <div class="nm-book__entry" id="nm-book-entry">
        <span>
          <b>{t.shop}</b> · {t.address}
        </span>
        <span class="nm-book__until">{t.until}</span>
      </div>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="offices" hidden>
  <div class="anchor nm-offices">
    {t.offices.map((office, i) => (
      <div class="nm-office" id={`nm-off-${i + 1}`}>
        <Fragment set:html={phone} />
        {office}
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="tree" hidden>
  <div class="anchor nm-tree">
    <div class="nm-name" aria-hidden="true">
      <span id="nm-l-www">www</span>
      <span>.</span>
      <span id="nm-l-example">example</span>
      <span>.</span>
      <span id="nm-l-com">com</span>
      <span id="nm-l-root">.</span>
    </div>
    <div class="nm-tree__row">
      <span class="nm-node nm-node--root" id="nm-t-root">
        .
      </span>
    </div>
    <div class="nm-tree__row">
      <span class="nm-node" id="nm-t-com">
        com
      </span>
      <span class="nm-node" id="nm-t-es">
        es
      </span>
      <span class="nm-node" id="nm-t-org">
        org
      </span>
      <span class="nm-node" id="nm-t-dev">
        dev
      </span>
    </div>
    <div class="nm-tree__row nm-tree__row--left">
      <span class="nm-node" id="nm-t-example">
        example.com
      </span>
    </div>
    <div class="nm-tree__row nm-tree__row--left">
      <span class="nm-node" id="nm-t-www">
        www.example.com
      </span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="pc" hidden>
  <div class="anchor nm-box nm-box--pc">
    <div class="nm-title">
      <Fragment set:html={laptop} />
      {t.pc}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="resolver" hidden>
  <div class="anchor nm-box nm-box--cache">
    <div class="nm-title">
      <Fragment set:html={globe} />
      {t.resolver}
    </div>
    <div class="nm-cache">
      <span class="nm-cache__label">
        {t.cache}{' '}
        <span class="nm-cache__empty" id="nm-c-empty">
          {t.cacheEmpty}
        </span>
      </span>
      <div class="nm-cache__row" id="nm-c-1">
        <b>.com</b>
        <span>NS · 172800 s</span>
      </div>
      <div class="nm-cache__row" id="nm-c-2">
        <b>example.com</b>
        <span>
          A · <span id="nm-c-2-ttl"></span> s
        </span>
      </div>
    </div>
  </div>
</div>

{servers.map(([name, title, host]) => (
  <div class="scene-actor" data-actor={name} hidden>
    <div class="anchor nm-box nm-box--server">
      <div class="nm-title">
        <Fragment set:html={globe} />
        {title}
      </div>
      <div class="nm-host">{host}</div>
    </div>
  </div>
))}

<div class="scene-actor" data-actor="zone" hidden>
  <ul class="anchor nm-zone" role="list">
    {t.records.map(([type, name, value], i) => (
      <li class="nm-rec" id={`nm-r-${i + 1}`}>
        <b class="nm-rec__type">{type}</b>
        <span class="nm-rec__name">{name}</span>
        <span class="nm-rec__value">→ {value}</span>
      </li>
    ))}
  </ul>
</div>

{(
  [
    ['mine', t.yours],
    ['other', t.other],
  ] as const
).map(([name, title]) => (
  <div class="scene-actor" data-actor={name} hidden>
    <div class="anchor nm-box nm-box--cache">
      <div class="nm-title">
        <Fragment set:html={globe} />
        {title}
      </div>
      <div class="nm-cache">
        <span class="nm-cache__label">
          {t.cache}{' '}
          <span class="nm-cache__empty" id={`nm-${name}-empty`}>
            {t.cacheEmpty}
          </span>
        </span>
        <div class="nm-cache__row" id={`nm-${name}-row`}>
          <b>{t.domain}</b>
          <span id={`nm-${name}-value`} />
        </div>
      </div>
    </div>
  </div>
))}

<div class="scene-actor" data-actor="owner" hidden>
  <div class="anchor nm-box nm-box--server">
    <div class="nm-title">
      <Fragment set:html={globe} />
      {t.domain}
    </div>
    <div class="nm-host">{t.owner}</div>
    <div class="nm-rec nm-rec--owner" id="nm-owner-row">
      <b class="nm-rec__type">A</b>
      <span class="nm-rec__value" id="nm-owner-value"></span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="copy" hidden>
  <div class="anchor nm-box nm-box--cache">
    <div class="nm-title">
      <Fragment set:html={globe} />
      {t.yours}
    </div>
    <div class="nm-cache">
      <span class="nm-cache__label">{t.cache}</span>
      <div class="nm-cache__row is-on">
        <b>example.com</b>
        <span>
          A · <span id="nm-d-ttl"></span> s
        </span>
      </div>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="term" hidden>
  <div class="anchor nm-term">
    <div class="nm-term__bar">{t.terminal}</div>
    <div class="nm-term__body">
      {[1, 2].map((i) => (
        <>
          <div class="nm-term__line nm-term__cmd" id={`nm-cmd-${i}`}>
            <span class="nm-term__prompt">$</span> dig +noall +answer example.com A
          </div>
          <div class="nm-term__line nm-term__out" id={`nm-out-${i}`} />
        </>
      ))}
    </div>
  </div>
</div>
