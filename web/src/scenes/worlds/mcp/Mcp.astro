---
/**
 * The mcp world's actors (mcp.ts says what they do): the agents, one more agent, the MCP bus and the
 * services of «De doce conectores a siete piezas»; the host with its person and its MCP client; an
 * MCP client and the shop as an MCP server; the JSON-RPC message; the API's two copies; how the shop
 * registers a tool and its two doors; and the table of keys. HTML boxes with their text at its own
 * size, SVG only for shapes; every part that shows up later already has its room (spec §4.3).
 * Ids start with `mc-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const bot = icon(
  '<rect x="2.5" y="5" width="11" height="8.5" rx="2.2"/><path d="M8 5V2.6"/><circle cx="8" cy="2.2" r=".7" fill="currentColor"/><circle cx="6" cy="9.2" r=".8" fill="currentColor"/><circle cx="10" cy="9.2" r=".8" fill="currentColor"/>',
);
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/><circle cx="11.5" cy="4.75" r=".6" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".6" fill="currentColor"/>',
);
const plug = icon(
  '<path d="M5.5 1.8v3M10.5 1.8v3M3.8 4.8h8.4v2.6a4.2 4.2 0 0 1-8.4 0zM8 11.6v2.6"/>',
);
---

<div class="scene-actor" data-actor="agents" hidden>
  <div class="anchor mc-list">
    {t.agents.map((name, i) => (
      <div class="mc-item" id={`mc-agent-${i + 1}`}>
        <Fragment set:html={bot} />
        <span class="mc-item__name">{name}</span>
        <span class="mc-item__sub">{t.does[i]}</span>
        <span class="mc-chip mc-room" id={`mc-agent-chip-${i + 1}`}>
          {t.client}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="newagent" hidden>
  <div class="anchor mc-list">
    <div class="mc-item mc-room" id="mc-agent-4">
      <Fragment set:html={bot} />
      <span class="mc-item__name">{t.newAgent}</span>
      <span class="mc-chip">{t.client}</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="mcpbus" hidden>
  <div class="anchor mc-bus">
    <div class="mc-bus__bar mc-room" id="mc-bus">
      <span>MCP</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="services" hidden>
  <div class="anchor mc-list">
    {t.services.map((name, i) => (
      <div class="mc-item mc-item--service" id={`mc-service-${i + 1}`}>
        <Fragment set:html={rack} />
        <span class="mc-item__name">{name}</span>
        <span class="mc-chip mc-room" id={`mc-service-chip-${i + 1}`}>
          {t.server}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="host" hidden>
  <div class="anchor mc-host">
    <div class="mc-host__bar">
      <Fragment set:html={bot} />
      <b>{t.host.title}</b>
      <span>{t.host.sub}</span>
    </div>
    <div class="mc-host__body">
      <span
        class="mc-host__who"
        set:html={personSVG({
          id: 'mc-person',
          skin: 'a',
          hair: 'b',
          shirt: 'info',
          plate: true,
          hairStyle: 2,
        })}
      />
      <span class="mc-host__ask mc-room" id="mc-ask">
        {t.host.ask}
      </span>
    </div>
    <div class="mc-host__answer mc-room" id="mc-answer">
      <i style="width:2.6em"></i>
      <i style="width:1.8em"></i>
      <i style="width:2.8em"></i>
    </div>
    <span class="mc-chip mc-host__client" id="mc-host-client">
      {t.client}
    </span>
  </div>
</div>

<div class="scene-actor" data-actor="mcpclient" hidden>
  <div class="anchor mc-box mc-client">
    <div class="mc-box__title">
      <Fragment set:html={plug} />
      {t.client}
    </div>
    <div class="mc-box__sub">curl</div>
    <div class="mc-client__plug" set:html={plug} />
  </div>
</div>

<div class="scene-actor" data-actor="mcpshop" hidden>
  <div class="anchor mc-box mc-shop" id="mc-shop">
    <div class="mc-box__title">
      <Fragment set:html={rack} />
      {t.shop}
      <span class="mc-box__path">POST /mcp</span>
    </div>
    {t.tools.map((name, i) => (
      <div class="mc-tool" id={`mc-tool-${i + 1}`}>
        {name}
      </div>
    ))}
    <div class="mc-status" id="mc-role"></div>
  </div>
</div>

<div class="scene-actor" data-actor="rpccard" hidden>
  <div class="anchor mc-card mc-card--rpc">
    {[1, 2, 3].map((i) => (
      <div class="mc-card__row" id={`mc-rpc-${i}`}>
        <span class="mc-rpc-k" id={`mc-rpc-k-${i}`} />
        <b class="mc-rpc-v" id={`mc-rpc-v-${i}`} />
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="replicas" hidden>
  <div class="anchor mc-copies">
    <div class="mc-box__sub">{t.copies.title}</div>
    {['a', 'b'].map((copy) => (
      <div class="mc-box mc-copy" id={`mc-copy-${copy}`}>
        <div class="mc-box__title">
          <Fragment set:html={rack} />
          api-{copy}
        </div>
        <span class="mc-chip mc-room" id={`mc-built-${copy}`}>
          {t.copies.built}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="toolcard" hidden>
  <div class="anchor mc-card mc-card--tool">
    <div class="mc-card__title">registerTool</div>
    {t.tool.rows.map(([name, value], i) => (
      <div class="mc-card__row" id={`mc-def-${i + 1}`}>
        <span>{name}</span>
        <b>{value}</b>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="doors" hidden>
  <div class="anchor mc-doors">
    <div class="mc-door" id="mc-door-1">
      <b>{t.doors.assistant}</b>
      <span>{t.doors.lesson}</span>
    </div>
    <div class="mc-fn" id="mc-fn">
      {t.doors.fn}
    </div>
    <div class="mc-door" id="mc-door-2">
      <b>MCP</b>
      <span>POST /mcp</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="apikeys" hidden>
  <div class="anchor mc-keys">
    <div class="mc-keys__row mc-keys__head">
      {t.keys.head.map((head) => (
        <span>{head}</span>
      ))}
    </div>
    {t.keys.rows.map(([who, credential], i) => (
      <div class="mc-keys__row" id={`mc-key-${i + 1}`}>
        <span>{who}</span>
        <code>{credential}</code>
        <b id={`mc-seen-${i + 1}`} />
      </div>
    ))}
  </div>
</div>
