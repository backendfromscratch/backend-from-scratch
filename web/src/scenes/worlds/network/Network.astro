---
/**
 * The network world's actors (network.ts says what they do). HTML boxes with their text at its own
 * size, and SVG only for shapes (spec §4.2). Hidden from screen readers with the whole stage: the
 * lesson's text says everything. Ids start with `sc-` so they never clash with the page's.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const globe =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M1.8 8h12.4M8 1.8c2.2 2.1 2.2 10.3 0 12.4M8 1.8c-2.2 2.1-2.2 10.3 0 12.4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>';
const key =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="5" cy="8" r="3.1" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.1 8h6.3M12.2 8v2.7M14.3 8v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
const lock =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.6 7V5.2a3.4 3.4 0 0 1 6.8 0V7" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="3" y="7" width="10" height="7.6" rx="1.8" fill="currentColor"/></svg>';
const rack =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2.5" width="12" height="4.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="2" y="9" width="12" height="4.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="11.5" cy="4.75" r=".9" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".9" fill="currentColor"/></svg>';
const dnsServers = [
  ['root', t.root, 'f.root-servers.net'],
  ['com', t.com, 'e.gtld-servers.net'],
  ['auth', t.auth, 'elliott.ns.cloudflare.com'],
] as const;
---

<div class="sc-dns-row" data-group>
  {dnsServers.map(([name, title, host]) => (
    <div class="scene-actor" data-actor={name}>
      <div class="anchor sc-box">
        <div class="sc-box__title">
          <Fragment set:html={globe} />
          {title}
        </div>
        <div class="sc-box__sub">{host}</div>
      </div>
    </div>
  ))}
</div>

<div class="scene-actor" data-actor="resolver">
  <div class="anchor sc-box sc-box--resolver">
    <div class="sc-box__title">
      <Fragment set:html={globe} />
      {t.resolver}
    </div>
    <div class="sc-box__sub">{t.resolverSub}</div>
    <div class="sc-box__cache" id="sc-cache" set:html={t.cacheEmpty} />
  </div>
</div>

<div class="scene-actor" data-actor="you">
  <div
    class="anchor sc-you"
    set:html={personSVG({
      id: 'sc-me',
      skin: 'a',
      hair: 'a',
      shirt: 'info',
      typing: true,
      plate: true,
    })}
  />
  <span class="scene-label">{t.you}</span>
</div>

<div class="scene-actor" data-actor="browser">
  <div class="anchor sc-browser">
    <div class="sc-browser__tabs">
      <span class="sc-browser__dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="sc-browser__tab">
        <span class="sc-spin" id="sc-tab-spin"></span>
        <span id="sc-tab-title">{t.newTab}</span>
      </span>
    </div>
    <div class="sc-browser__bar">
      <span class="sc-browser__lock" id="sc-lock" set:html={lock} />
      <span class="sc-url" id="sc-url">
        <span class="sc-url__placeholder">{t.typeUrl}</span>
        <span class="scene-caret"></span>
      </span>
      <span class="sc-browser__key" id="sc-key-b" set:html={key} />
    </div>
    <div class="sc-page" id="sc-page">
      <div class="sc-page__h" data-paint="1">
        {t.pageTitle}
      </div>
      <div class="sc-page__line" data-paint="1"></div>
      <div class="sc-page__line sc-page__line--short" data-paint="1"></div>
      <div class="sc-page__link" data-paint="1">
        {t.learnMore}
      </div>
      <div class="sc-page__image" data-paint="2"></div>
      <div class="sc-page__ip" id="sc-ip" hidden>
        IP 104.20.23.154
      </div>
    </div>
  </div>
  <span class="scene-label">{t.browser}</span>
</div>

<!-- What each part of the URL tells the browser (the URL scene): a card under the browser, its rows
     reserved from the start so that showing one moves nothing. -->
<div class="scene-actor" data-actor="urlmap" hidden>
  <dl class="anchor sc-urlmap" id="sc-urlmap">
    <div class="sc-urlmap__row" data-kind="tls" id="sc-um-scheme">
      <dt>https</dt>
      <dd>{t.urlParts.scheme}</dd>
    </div>
    <div class="sc-urlmap__row" data-kind="dns" id="sc-um-host">
      <dt>example.com</dt>
      <dd>{t.urlParts.host}</dd>
    </div>
    <div class="sc-urlmap__row" data-kind="http" id="sc-um-path">
      <dt>/</dt>
      <dd>{t.urlParts.path}</dd>
    </div>
  </dl>
</div>

<div class="scene-actor" data-actor="router">
  <div class="anchor sc-router">
    <svg viewBox="0 0 64 44" aria-hidden="true">
      <path class="sc-router__antenna" d="M14 17 L9 3 M50 17 L55 3"></path>
      <rect class="sc-router__box" x="3" y="17" width="58" height="24" rx="6"></rect>
      <circle class="sc-router__led" cx="15" cy="29" r="2.6"></circle>
      <circle class="sc-router__led" cx="24" cy="29" r="2.6"></circle>
      <circle class="sc-router__led sc-router__led--b" cx="33" cy="29" r="2.6"></circle>
    </svg>
  </div>
  <span class="scene-label">{t.router}</span>
</div>

<div class="scene-actor" data-actor="net">
  <div class="anchor sc-net"></div>
</div>

<div class="scene-actor" data-actor="server">
  <div class="anchor sc-server">
    <div class="sc-server__head">
      <Fragment set:html={rack} />
      {t.server}
      <span class="sc-server__key" id="sc-key-s" set:html={key} />
    </div>
    <div class="sc-server__sub" data-server-sub>
      {t.serverSub.near}
    </div>
    <div class="sc-server__rack">
      <i></i>
      <i></i>
      <i></i>
    </div>
  </div>
  <span class="scene-label" data-server-name>
    {t.serverName.near}
  </span>
</div>

<!-- The server opened: it grows out of the server when the scene goes inside it. -->
<div class="scene-actor" data-actor="server-room" data-morph-from="server" hidden>
  <div class="anchor sc-server sc-room">
    <div class="sc-server__head">
      <Fragment set:html={rack} />
      {t.server}
    </div>
    <div class="sc-server__sub" data-server-sub>
      {t.serverSub.near}
    </div>
    <div class="sc-server__inside">
      <div class="sc-srv sc-srv--program sc-room__part" id="sc-srv-program">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4.5l-3 15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <b>{t.program}</b>
        <span>{t.programSub}</span>
      </div>
      <div class="sc-srv sc-srv--db sc-room__part" id="sc-srv-db">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <ellipse
            cx="12"
            cy="5.5"
            rx="7.5"
            ry="3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
          ></ellipse>
          <path
            d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
          ></path>
        </svg>
        <span>{t.database}</span>
      </div>
      <div class="sc-srv sc-srv--file sc-room__part" id="sc-srv-file">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.5 2.5h8l4 4v15h-12z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
          <path
            d="M14.5 2.5v4h4M9 12h6M9 15.5h6M9 19h4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
        <span>index.html</span>
      </div>
      <div class="sc-srv sc-srv--backend sc-room__part" id="sc-srv-backend">
        {t.backend}
      </div>
    </div>
  </div>
  <span class="scene-label" data-server-name>
    {t.serverName.near}
  </span>
</div>
