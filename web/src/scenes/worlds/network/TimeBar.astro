---
/**
 * The network world's instrument (network.ts, `timeBar`): the phases of a request as a bar that fills
 * and a clock that adds up their milliseconds. The bar is decorative (the text gives the numbers);
 * the near/far switch is a real control, shown only during the round-trip scene, in the place of the
 * label, so the bar's height does not change (a taller bar would shrink the stage and cut the scene).
 * On a phone it is one row: the bar, the switch when it shows (after the bar, so the bar's start
 * never moves) and the clock.
 */
import type { Locale } from '~/lib/locales';
import { PHASES } from './network';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const kindOf = { dns: 'dns', tcp: 'tcp', tls: 'tls', wait: 'http', down: 'http' } as const;
---

<div class="scene-instrument sc-time">
  <div class="sc-time__top">
    <span class="sc-time__of" aria-hidden="true">
      {t.time} · <span id="sc-time-of">{t.timeOf.near}</span>
    </span>
    <div class="sc-time__options" data-option="mode" role="group" aria-label={t.modeGroup} hidden>
      <button type="button" data-value="near" aria-pressed="true">
        {t.modes.near}
      </button>
      <button type="button" data-value="far" aria-pressed="false">
        {t.modes.far}
      </button>
    </div>
    <span class="sc-time__clock" id="sc-clock" aria-hidden="true">
      0 ms
    </span>
  </div>
  <div class="sc-time__track" aria-hidden="true">
    <div class="sc-time__bar">
      {PHASES.map((phase) => (
        <span class="sc-time__segment" data-phase={phase} data-kind={kindOf[phase]}>
          <i />
        </span>
      ))}
    </div>
    <ul class="sc-time__legend" role="list">
      {PHASES.map((phase) => (
        <li data-phase={phase} data-kind={kindOf[phase]}>
          {t.phases[phase]} <b>—</b>
        </li>
      ))}
    </ul>
  </div>
</div>
