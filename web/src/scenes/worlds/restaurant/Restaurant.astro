---
/**
 * The restaurant world's actor (restaurant.ts): a restaurant seen from the side. The building and
 * its furniture are SVG shapes; the rooms' names are HTML, so they are translated like any other
 * text. Ids start with `rs-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
---

<!-- Where the supplier's van parks, next to the kitchen: the camera frames it with the restaurant. -->
<div class="scene-actor" data-actor="parking" hidden>
  <div class="anchor rs-parking"></div>
</div>

<div class="scene-actor" data-actor="restaurant" hidden>
  <div class="anchor sc-scenery rs-place">
    <svg viewBox="0 0 480 220" preserveAspectRatio="none" aria-hidden="true">
      <rect class="rs-wall" x="6" y="18" width="468" height="196" rx="6"></rect>
      <path class="rs-divider" d="M240 18 V112"></path>
      <path class="rs-floor" d="M6 212 H474"></path>
      <rect class="rs-tabletop" x="92" y="146" width="104" height="8" rx="2"></rect>
      <path class="rs-table" d="M104 154 V210 M184 154 V210"></path>
      <path class="rs-plate" d="M126 146 a18 6 0 0 1 36 0 Z"></path>
      <rect class="rs-shelf" x="282" y="40" width="70" height="78" rx="2"></rect>
      <path class="rs-shelf" d="M282 66 H352 M282 92 H352"></path>
      <rect class="rs-jar" x="290" y="47" width="11" height="17" rx="2"></rect>
      <rect class="rs-jar" x="306" y="51" width="11" height="13" rx="2"></rect>
      <rect class="rs-jar" x="327" y="73" width="12" height="17" rx="2"></rect>
      <rect class="rs-jar" x="292" y="99" width="16" height="17" rx="2"></rect>
      <rect class="rs-stove" x="380" y="146" width="80" height="64" rx="3"></rect>
      <path class="rs-pot" d="M394 146 V128 H446 V146 Z"></path>
      <path
        class="rs-steam"
        d="M407 124 q-5 -6 0 -12 q5 -6 0 -12 M420 122 q-5 -6 0 -12 q5 -6 0 -12 M433 124 q-5 -6 0 -12 q5 -6 0 -12"
      ></path>
    </svg>
    <span class="rs-room rs-room--dining">{t.dining}</span>
    <span class="rs-room rs-room--kitchen">{t.kitchen}</span>
    <span class="rs-pantry" id="rs-pantry">
      {t.pantry}
    </span>
    <div
      class="rs-person rs-person--you"
      set:html={personSVG({ id: 'rs-you', skin: 'b', hair: 'a', shirt: 'info', facing: 'right' })}
    />
    <div
      class="rs-person rs-person--waiter"
      set:html={personSVG({
        id: 'rs-waiter',
        skin: 'a',
        hair: 'b',
        shirt: 'keyword',
        hairStyle: 2,
        facing: 'left',
      })}
    />
    <div
      class="rs-person rs-person--cook"
      set:html={personSVG({
        id: 'rs-cook',
        skin: 'a',
        hair: 'a',
        shirt: 'info',
        apron: true,
        facing: 'right',
      })}
    />
  </div>
</div>
