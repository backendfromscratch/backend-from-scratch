---
/**
 * The crypto world's actors (crypto.ts says what they do): your browser and the server, each with
 * the secret key it holds (and the browser with the certificate it checked); someone on the café's
 * wifi with what they see go past; the three needs; the analogy's padlocks, box, key, sealed letter
 * and ID; a key pair encrypting and signing; the certificate chain and the browser's three checks;
 * what HTTPS leaves visible; and the badssl.com sites. Every part that changes keeps its room
 * (spec §4.3). Ids start with `cr-`.
 */
import type { Locale } from '~/lib/locales';
import { icons } from '../../core/icons';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const laptop = icon('<rect x="3" y="3" width="10" height="7" rx="1"/><path d="M1.5 12.5h13"/>');
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/>',
);
const open = icon(
  '<path d="M4.6 7V4.6a3.4 3.4 0 0 1 6.6-1.2"/><rect x="3" y="7" width="10" height="7.4" rx="1.8"/>',
);
const cert = icon(
  '<rect x="2" y="2.5" width="12" height="9" rx="1"/><path d="M5 6h6M5 8.5h3.5"/><circle cx="11" cy="12.5" r="1.6"/>',
);
const seal = icon(
  '<circle cx="8" cy="8" r="5.6"/><path d="m8 5 .9 1.9 2 .3-1.5 1.4.4 2L8 9.7l-1.8.9.4-2-1.5-1.4 2-.3z"/>',
);
const sites = [
  'example.com',
  'expired.badssl.com',
  'wrong.host.badssl.com',
  'self-signed.badssl.com',
] as const;
---

<div class="scene-actor" data-actor="browser">
  <div class="anchor cr-box">
    <div class="cr-title">
      <Fragment set:html={laptop} />
      {t.browser}
    </div>
    <div class="cr-slot cr-slot--key" id="cr-b-key">
      <Fragment set:html={icons.key} />
      {t.secret}
    </div>
    <div class="cr-slot cr-slot--cert" id="cr-b-cert">
      <Fragment set:html={cert} />
      {t.certOk}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="server">
  <div class="anchor cr-box">
    <div class="cr-title">
      <Fragment set:html={rack} />
      {t.server}
    </div>
    <div class="cr-sub">example.com</div>
    <div class="cr-slot cr-slot--key" id="cr-s-key">
      <Fragment set:html={icons.key} />
      {t.secret}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="eve" hidden>
  <div class="anchor cr-eve">
    <span
      class="cr-eve__person"
      set:html={personSVG({ id: 'cr-eve', skin: 'a', hair: 'b', shirt: 'keyword', hairStyle: 1 })}
    />
    <span class="cr-eve__name">{t.eve}</span>
    <span class="cr-eve__sees" id="cr-sees"></span>
  </div>
</div>

<div class="scene-actor" data-actor="needs" hidden>
  <div class="anchor cr-needs">
    {t.needs.map((need, i) => (
      <span class="cr-need" id={`cr-need-${i + 1}`}>
        {need}
      </span>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="lockbox" hidden>
  <div class="anchor cr-card cr-lockbox">
    <div class="cr-locks">
      {[1, 2, 3].map(() => (
        <span class="cr-icon" set:html={open} />
      ))}
      <span class="cr-caption">{t.yourName}</span>
    </div>
    <div class="cr-lockbox__row">
      <div class="cr-boxicon" id="cr-box">
        {t.box}
        <span class="cr-boxicon__lock" id="cr-box-lock" set:html={icons.lock} />
      </div>
      <div class="cr-keyicon" id="cr-key">
        <span class="cr-icon" set:html={icons.key} />
        <span class="cr-caption">{t.onlyYou}</span>
      </div>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="seal" hidden>
  <div class="anchor cr-card cr-sealcard">
    <div class="cr-letter" id="cr-letter">
      {t.letter}
      <span class="cr-letter__seal" id="cr-seal" set:html={seal} />
    </div>
    <div class="cr-photo">
      <span class="cr-icon" set:html={seal} />
      <span class="cr-caption">{t.photo}</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="idcard" hidden>
  <div class="anchor cr-card cr-id" id="cr-id">
    <b>{t.idTitle}</b>
    <span class="cr-id__seal">
      <span class="cr-icon" set:html={seal} />
      {t.idText}
    </span>
    <span class="cr-id__stamp" id="cr-id-stamp">
      {t.authority} ✓
    </span>
  </div>
</div>

<div class="scene-actor" data-actor="keypair" hidden>
  <div class="anchor cr-card cr-pair">
    {[
      [t.encrypt, t.message, t.publicKey, t.sights.cipher, t.privateKey, t.message],
      [t.sign, t.message, t.privateKey, `${t.message} + ${t.signature}`, t.publicKey, t.verified],
    ].map(([verb, start, firstKey, middle, secondKey, last], lane) => (
      <div class="cr-lane">
        <span class="cr-lane__verb">{verb}</span>
        <span class="cr-chip">{start}</span>
        <span class="cr-keychip" data-key={firstKey === t.publicKey ? 'public' : 'private'}>
          <Fragment set:html={icons.key} />
          {firstKey}
        </span>
        <span class="cr-chip cr-step" id={`cr-p-${lane * 2 + 1}`}>
          {middle}
        </span>
        <span
          class="cr-keychip cr-step"
          id={`cr-pk-${lane * 2 + 2}`}
          data-key={secondKey === t.publicKey ? 'public' : 'private'}
        >
          <Fragment set:html={icons.key} />
          {secondKey}
        </span>
        <span class="cr-chip cr-step" id={`cr-p-${lane * 2 + 2}`}>
          {last}
        </span>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="chain" hidden>
  <div class="anchor cr-chain">
    <div class="cr-cert" id="cr-c-root">
      <b>
        <Fragment set:html={cert} />
        {t.root}
      </b>
      <span class="cr-cert__note">{t.inBrowser}</span>
    </div>
    <div class="cr-cert" id="cr-c-int">
      <b>
        <Fragment set:html={cert} />
        {t.intermediate}
      </b>
    </div>
    <div class="cr-cert" id="cr-c-site">
      <b>
        <Fragment set:html={cert} />
        example.com
      </b>
      <span class="cr-cert__note">{t.dates}</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="checks" hidden>
  <ul class="anchor cr-card cr-checks" role="list">
    {t.checks.map((check, i) => (
      <li class="cr-check" id={`cr-k-${i + 1}`}>
        <span class="cr-mark" id={`cr-k-m-${i + 1}`} />
        {check}
      </li>
    ))}
  </ul>
</div>

<div class="scene-actor" data-actor="seen" hidden>
  <div class="anchor cr-card cr-seen">
    <div class="cr-seen__col" id="cr-seen-shown">
      <b>{t.visible}</b>
      {t.shown.map((item) => (
        <span>{item}</span>
      ))}
    </div>
    <div class="cr-seen__col cr-seen__col--hidden" id="cr-seen-covered">
      <b>
        <Fragment set:html={icons.lock} />
        {t.hidden}
      </b>
      {t.covered.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="sites" hidden>
  <div class="anchor cr-card cr-sites">
    <div class="cr-site cr-site--head">
      <span></span>
      {t.checks.map((check) => (
        <span class="cr-site__check">{check}</span>
      ))}
    </div>
    {sites.map((site, row) => (
      <div class="cr-site" id={`cr-site-${row + 1}`}>
        <span class="cr-site__name">{site}</span>
        {[1, 2, 3].map((check) => (
          <span class="cr-mark" id={`cr-sm-${row + 1}-${check}`} />
        ))}
      </div>
    ))}
  </div>
</div>
