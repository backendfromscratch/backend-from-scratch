---
/**
 * The assistant world's actors (assistant.ts says what they do): Carmen's browser with the shop's
 * assistant, the shop, the model's API, and the parts only some views need, each an actor of its
 * own (the style guide's rule): the DevTools row and whoever reads it, the shop's checks and Redis,
 * the request and response cards, the cost meter, the fake model, your terminal, the API's stream
 * events, the browser's reader, nginx, the shop's tools, a tool's definition, the orders and what
 * the model reads. HTML boxes with their text at its own size, SVG only for shapes; every part that
 * shows up later already has its room (spec §4.3). Ids start with `ai-`.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { SEGMENTS } from './assistant';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/><circle cx="11.5" cy="4.75" r=".6" fill="currentColor"/><circle cx="11.5" cy="11.25" r=".6" fill="currentColor"/>',
);
const spark = icon('<path d="M8 1.8v12.4M1.8 8h12.4M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/>');
const key = icon('<circle cx="5" cy="8" r="3"/><path d="M8 8h6.3M12.2 8v2.6M14.2 8v2"/>');
const cylinder = icon(
  '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
);
const prompt = icon('<path d="M3 4.5 6.5 8 3 11.5M8.5 12h4.5"/>');
const book = icon(
  '<path d="M2.5 3.5h4a1.5 1.5 0 0 1 1.5 1.5v8a1.2 1.2 0 0 0-1.2-1.2H2.5zM13.5 3.5h-4A1.5 1.5 0 0 0 8 5v8a1.2 1.2 0 0 1 1.2-1.2h4.3z"/>',
);
const proxy = icon(
  '<rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M5 6.5h6M5 9.5h6"/>',
);
const wrench = icon(
  '<path d="M10.5 2.2a3.3 3.3 0 0 0-3.2 4.3L2.6 11.2a1.4 1.4 0 0 0 2 2l4.7-4.7a3.3 3.3 0 0 0 4.3-3.2l-1.9 1.9-1.9-.4-.4-1.9z"/>',
);
const flask = icon(
  '<path d="M6 2h4M6.8 2v4.2L3 13a1 1 0 0 0 .9 1.5h8.2A1 1 0 0 0 13 13L9.2 6.2V2M4.6 10h6.8"/>',
);
// The answer's placeholder lines (assistant.ts, SEGMENTS): their widths in em, line by line.
const lines = [
  [3, 2.2, 3.4, 1.6],
  [2.4, 3.6, 1.8, 2.6],
  [3.2, 1.8, 2.8, 1.4],
];
if (lines.flat().length !== SEGMENTS) throw new Error('[Assistant] SEGMENTS and the lines differ');
const rows = t.request.rows;
---

<div class="scene-actor" data-actor="chat">
  <div class="anchor ai-chat" id="ai-chat">
    <div class="ai-chat__bar">
      <span
        class="ai-chat__avatar"
        set:html={personSVG({
          id: 'ai-carmen',
          skin: 'b',
          hair: 'b',
          shirt: 'keyword',
          plate: true,
          hairStyle: 2,
        })}
      />
      <span>{t.chat}</span>
    </div>
    <div class="ai-chat__body">
      <div class="ai-chat__ask">
        <span id="ai-ask"></span>
      </div>
      <div class="ai-chat__answer">
        {lines.map((widths) => (
          <div class="ai-chat__line">
            {widths.map((w) => (
              <i class="ai-seg" style={`width:${w}em`} />
            ))}
          </div>
        ))}
      </div>
      <div class="ai-chat__note" id="ai-note"></div>
      <div class="ai-chat__closed">{t.closed}</div>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="devtools" hidden>
  <div class="anchor ai-devtools">
    <div class="ai-devtools__title">{t.devtools.title}</div>
    <div class="ai-devtools__row ai-room" id="ai-dev-row">
      <span>POST /v1/messages</span>
      <b>200</b>
    </div>
    <div class="ai-devtools__header ai-room" id="ai-dev-key">
      {t.devtools.header}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="stranger" hidden>
  <div class="anchor ai-stranger">
    <span
      class="ai-stranger__who"
      set:html={personSVG({ id: 'ai-who', skin: 'a', hair: 'a', shirt: 'info', typing: true })}
    />
    <span class="ai-stranger__label">{t.stranger}</span>
  </div>
</div>

<div class="scene-actor" data-actor="api" hidden>
  <div class="anchor ai-box ai-api">
    <div class="ai-box__title">
      <Fragment set:html={rack} />
      {t.shop}
    </div>
    <div class="ai-box__sub">{t.route}</div>
    <div class="ai-key" id="ai-key">
      <Fragment set:html={key} />
      <span class="ai-key__name">ANTHROPIC_API_KEY</span>
      <span class="ai-key__none">{t.noKey}</span>
    </div>
    <div class="ai-status" id="ai-api-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="gate" data-morph-from="api" hidden>
  <div class="anchor ai-box ai-gate">
    <div class="ai-box__title">
      <Fragment set:html={rack} />
      {t.shop}
    </div>
    <div class="ai-box__sub">{t.gate.title}</div>
    {t.gate.rows.map((row, i) => (
      <div class="ai-check">
        <span>{row}</span>
        <b class="ai-mark" id={`ai-check-${i + 1}`} />
      </div>
    ))}
    <div class="ai-check ai-room" id="ai-gate-budget">
      <span>{t.gate.budget}</span>
      <b class="ai-mark" id="ai-check-4" />
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="redis" hidden>
  <div class="anchor ai-box ai-redis" id="ai-redis">
    <div class="ai-box__title">
      <Fragment set:html={cylinder} />
      {t.redis.title}
    </div>
    <div class="ai-redis__row">
      <span>{t.redis.whose}</span>
      <span class="ai-redis__bar" id="ai-bar">
        <i></i>
      </span>
      <b class="ai-redis__count" id="ai-count">
        0/20
      </b>
    </div>
    <div class="ai-redis__down">{t.redis.down}</div>
  </div>
</div>

<div class="scene-actor" data-actor="model" hidden>
  <div class="anchor ai-box ai-model">
    <div class="ai-box__title">
      <Fragment set:html={spark} />
      {t.model}
    </div>
    <div class="ai-box__sub">claude-haiku-5-5</div>
    <div class="ai-status" id="ai-model-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="fakemodel" data-morph-from="model" hidden>
  <div class="anchor ai-box ai-model ai-fake">
    <div class="ai-box__title">
      <Fragment set:html={flask} />
      {t.fake.title}
    </div>
    <div class="ai-box__sub">{t.fake.file}</div>
    <div class="ai-status" id="ai-fake-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="reqcard" hidden>
  <div class="anchor ai-card">
    <div class="ai-card__title">POST /v1/messages</div>
    {rows.map(([name, value], i) => (
      <div class="ai-card__row" id={`ai-req-${i + 1}`}>
        <span>{name}</span>
        <b>{value}</b>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="rescard" hidden>
  <div class="anchor ai-card">
    <div class="ai-card__title">{t.response.title}</div>
    <div class="ai-card__row" id="ai-res-1">
      <span>thinking</span>
      <b>{t.response.thinking}</b>
    </div>
    <div class="ai-card__row" id="ai-res-2">
      <span>text</span>
      <b class="ai-card__lines">
        <i></i>
        <i></i>
        <i></i>
      </b>
    </div>
    <div class="ai-card__row" id="ai-res-3">
      <span>stop_reason</span>
      <b>end_turn</b>
    </div>
    <div class="ai-card__row" id="ai-res-4">
      <span>input_tokens</span>
      <b>{t.response.read}</b>
    </div>
    <div class="ai-card__row" id="ai-res-5">
      <span>output_tokens</span>
      <b>{t.response.wrote}</b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="apievents" hidden>
  <div class="anchor ai-card">
    {(
      [
        ['1', 'message_start'],
        ['2', 'content_block_start'],
        ['', 'content_block_delta'],
        ['', 'content_block_stop'],
        ['3', 'message_delta'],
        ['4', 'message_stop'],
      ] as const
    ).map(([n, name], i) => (
      <div class="ai-card__row ai-card__row--n" id={`ai-evt-${i + 1}`}>
        <span>{n}</span>
        <b>{name}</b>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="meter" hidden>
  <div class="anchor ai-meter">
    <span></span>
    {t.meter.head.map((head) => (
      <span class="ai-meter__head">{head}</span>
    ))}
    {([0, 1] as const).map((i) => (
      <>
        <span class="ai-meter__name">{t.meter.rows[i]}</span>
        {t.meter.values[i].map((value) => (
          <b class="ai-room" data-row={i + 1}>
            {value}
          </b>
        ))}
      </>
    ))}
    <span class="ai-meter__name ai-meter__total">{t.meter.rows[2]}</span>
    <span class="ai-meter__total"></span>
    <span class="ai-meter__total"></span>
    <b class="ai-room ai-meter__total" data-row="3">
      {t.meter.values[2]}
    </b>
  </div>
</div>

<div class="scene-actor" data-actor="shell" hidden>
  <div class="anchor ai-shell">
    <div class="ai-shell__title">
      <Fragment set:html={prompt} />
      {t.shell}
    </div>
    {[1, 2, 3].map((i) => (
      <div class="ai-shell__line">
        <span class="ai-shell__prompt">$</span>
        <span class="ai-shell__cmd" id={`ai-cmd-${i}`} />
        <b class="ai-mark" id={`ai-run-${i}`} />
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="reader" hidden>
  <div class="anchor ai-box ai-reader">
    <div class="ai-box__title">
      <Fragment set:html={book} />
      {t.reader.title}
    </div>
    <div class="ai-box__sub">fetch · getReader()</div>
    <div class="ai-reader__row">
      <span>{t.reader.chunk}</span>
      <b id="ai-chunk"></b>
    </div>
    <div class="ai-reader__row">
      <span>{t.reader.buffer}</span>
      <b id="ai-buffer"></b>
    </div>
    <div class="ai-reader__events">
      {[t.events.text, t.events.text, t.events.text, t.events.end].map((name, i) => (
        <span class="ai-ev ai-room" id={`ai-ev-${i + 1}`}>
          {name}
        </span>
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="nginx" hidden>
  <div class="anchor ai-box ai-nginx">
    <div class="ai-box__title">
      <Fragment set:html={proxy} />
      nginx
    </div>
    <div class="ai-box__sub">{t.location}</div>
    <div class="ai-status" id="ai-buffering"></div>
    <div class="ai-slots">
      {[1, 2, 3].map((i) => (
        <i class="ai-slot" id={`ai-slot-${i}`} />
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="tools" hidden>
  <div class="anchor ai-box ai-tools">
    <div class="ai-box__title">
      <Fragment set:html={wrench} />
      {t.tools.title}
    </div>
    {t.tools.names.map((name, i) => (
      <div class="ai-check" id={`ai-tool-${i + 1}`}>
        <span>{name}</span>
        <b class="ai-mark" id={`ai-tool-mark-${i + 1}`} />
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="defcard" hidden>
  <div class="anchor ai-card ai-card--def">
    {t.definition.map(([name, value], i) => (
      <div class="ai-card__row" id={`ai-def-${i + 1}`}>
        <span>{name}</span>
        <b>{value}</b>
      </div>
    ))}
  </div>
</div>

<div class="scene-actor" data-actor="orders" hidden>
  <div class="anchor ai-box ai-orders" id="ai-orders">
    <div class="ai-box__title">
      <Fragment set:html={cylinder} />
      {t.orders.title}
    </div>
    {t.orders.rows.map(([id, owner]) => (
      <div class="ai-check ai-order" id={`ai-order-${id}`}>
        <span>
          {id} · {owner}
        </span>
        <b class="ai-mark" id={`ai-order-mark-${id}`} />
      </div>
    ))}
    <div class="ai-orders__down">{t.orders.down}</div>
  </div>
</div>

<div class="scene-actor" data-actor="onetext" hidden>
  <div class="anchor ai-card ai-reads" id="ai-reads">
    <div class="ai-card__title">{t.reads.title}</div>
    <div class="ai-reads__text">
      <div class="ai-reads__part">{t.reads.system}</div>
      <div class="ai-reads__part">{t.reads.user}</div>
    </div>
  </div>
</div>
