---
/**
 * The town world's actors (town.ts): your home, the phone book, the road and the furniture shop. The
 * buildings are SVG shapes; the sign's word is HTML, so it is translated like any other text.
 */
import type { Locale } from '~/lib/locales';
import { personSVG } from '../people';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const parcel =
  '<svg viewBox="0 0 44 36" aria-hidden="true"><path class="sc-parcel__top" d="M3 10 L22 3 L41 10 L22 17 Z"/><path class="sc-parcel__left" d="M3 10 V30 L22 35 V17 Z"/><path class="sc-parcel__right" d="M41 10 V30 L22 35 V17 Z"/><path class="sc-parcel__tape" d="M12.5 6.5 L31.5 13.5 V20"/></svg>';
---

<div class="scene-actor" data-actor="home" hidden>
  <div class="anchor sc-scenery sc-home">
    <svg viewBox="0 0 240 200" preserveAspectRatio="none" aria-hidden="true">
      <path class="sc-home__roof" d="M6 80 L120 10 L234 80 Z"></path>
      <rect class="sc-home__wall" x="20" y="76" width="200" height="122" rx="4"></rect>
      <rect class="sc-home__window" x="148" y="98" width="48" height="36" rx="3"></rect>
    </svg>
    <div
      class="sc-home__you"
      set:html={personSVG({ id: 'sc-you', skin: 'a', hair: 'a', shirt: 'info', phone: true })}
    />
    <div class="sc-home__slot">
      <span id="sc-box-home" class="sc-parcel" hidden set:html={parcel} />
      <span id="sc-shelf" hidden>
        <svg viewBox="0 0 48 64" aria-hidden="true">
          <rect class="sc-shelf__frame" x="3" y="2" width="42" height="60" rx="2"></rect>
          <path class="sc-shelf__board" d="M3 22 H45 M3 42 H45"></path>
          <rect class="sc-shelf__book" data-kind="dns" x="9" y="8" width="5" height="14"></rect>
          <rect class="sc-shelf__book" data-kind="tls" x="15" y="10" width="5" height="12"></rect>
          <rect class="sc-shelf__book" data-kind="tcp" x="21" y="7" width="5" height="15"></rect>
          <rect
            class="sc-shelf__book"
            data-kind="tls"
            x="30"
            y="30"
            width="10"
            height="12"
            rx="1"
          ></rect>
          <rect
            class="sc-shelf__book"
            data-kind="dns"
            x="9"
            y="49"
            width="12"
            height="13"
            rx="2"
          ></rect>
        </svg>
      </span>
    </div>
  </div>
  <span class="scene-label">{t.home}</span>
</div>

<div class="scene-actor" data-actor="book" hidden>
  <div class="anchor sc-scenery sc-book" id="sc-book">
    <svg viewBox="0 0 80 60" aria-hidden="true">
      <g class="sc-book__closed">
        <rect class="sc-book__cover" x="18" y="5" width="44" height="50" rx="3"></rect>
        <rect class="sc-book__spine" x="22" y="5" width="5" height="50"></rect>
        <rect class="sc-book__label" x="32" y="16" width="24" height="5" rx="2"></rect>
        <rect class="sc-book__label" x="32" y="25" width="17" height="3" rx="1.5"></rect>
      </g>
      <g class="sc-book__open">
        <path class="sc-book__page" d="M40 12 C30 6 14 6 6 9 V54 C14 51 30 51 40 57 Z"></path>
        <path class="sc-book__page" d="M40 12 C50 6 66 6 74 9 V54 C66 51 50 51 40 57 Z"></path>
        <path
          class="sc-book__lines"
          d="M12 18 H32 M12 25 H34 M12 32 H30 M48 18 H68 M48 25 H66 M48 32 H69 M48 39 H62"
        ></path>
      </g>
    </svg>
  </div>
  <span class="scene-label">{t.guide}</span>
</div>

<div class="scene-actor" data-actor="road" hidden>
  <div class="anchor sc-road-gap"></div>
</div>

<div class="scene-actor" data-actor="shop" hidden>
  <div class="anchor sc-scenery sc-shop">
    <svg viewBox="0 0 240 200" preserveAspectRatio="none" aria-hidden="true">
      <rect class="sc-shop__wall" x="14" y="44" width="212" height="154" rx="4"></rect>
      <rect class="sc-shop__shelf" x="150" y="92" width="62" height="70" rx="2"></rect>
      <path class="sc-shop__shelf" d="M150 115 H212 M150 138 H212"></path>
      <rect class="sc-shop__item" x="158" y="99" width="16" height="14" rx="2"></rect>
      <rect class="sc-shop__item" x="186" y="121" width="18" height="15" rx="2"></rect>
      <path class="sc-shop__awning" d="M6 44 H234 L224 76 H16 Z"></path>
      <path
        class="sc-shop__stripe"
        d="M34 44 H62 L59 76 H31 Z M90 44 H118 L117 76 H89 Z M146 44 H174 L175 76 H147 Z M202 44 H230 L223 76 H204 Z"
      ></path>
    </svg>
    <span class="sc-shop__sign">{t.sign}</span>
    <div
      class="sc-shop__keeper"
      set:html={personSVG({
        id: 'sc-shop',
        skin: 'b',
        hair: 'b',
        shirt: 'keyword',
        phone: true,
        apron: true,
        facing: 'left',
        hairStyle: 2,
      })}
    />
    <div class="sc-shop__counter"></div>
    <span id="sc-box-shop" class="sc-parcel sc-shop__parcel" hidden set:html={parcel} />
  </div>
  <span class="scene-label sc-shop__far">{t.shop}</span>
  <span class="scene-label sc-shop__near">{t.shopNear}</span>
</div>

<!-- The customers of «Modelo cliente-servidor»: they come to the shop's counter, one after another. -->
<div class="scene-actor" data-actor="customers" hidden>
  <div class="anchor sc-customers">
    <div
      set:html={personSVG({ id: 'sc-cust1', skin: 'a', hair: 'b', shirt: 'keyword', hairStyle: 2 })}
    />
    <div set:html={personSVG({ id: 'sc-cust2', skin: 'b', hair: 'a', shirt: 'info' })} />
    <div
      set:html={personSVG({ id: 'sc-cust3', skin: 'a', hair: 'a', shirt: 'info', hairStyle: 2 })}
    />
  </div>
  <span class="scene-label">{t.customers}</span>
</div>
