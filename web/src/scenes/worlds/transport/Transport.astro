---
/**
 * The transport world's actors (transport.ts says what they do): a client and a server with their
 * TCP states (the client with its copy of what isn't acknowledged yet, the server with what its
 * application has read and what it holds back), the text's table of uses, and the three ports
 * `nc -vz` knocks on. Every part that changes keeps its room
 * (spec §4.3). Ids start with `tp-`.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const laptop = icon('<rect x="3" y="3" width="10" height="7" rx="1"/><path d="M1.5 12.5h13"/>');
const rack = icon(
  '<rect x="2" y="2.5" width="12" height="4.5" rx="1.2"/><rect x="2" y="9" width="12" height="4.5" rx="1.2"/>',
);
const targets = ['example.com · 443', '127.0.0.1 · 9', '1.1.1.1 · 81'];
---

<div class="scene-actor" data-actor="client">
  <div class="anchor tp-box">
    <div class="tp-box__title">
      <Fragment set:html={laptop} />
      {t.client}
    </div>
    <div class="tp-state" id="tp-c-state"></div>
    <div class="tp-app tp-unacked" id="tp-unacked">
      <span class="tp-app__label">{t.unacked}</span>
      <span class="tp-app__text tp-copy" id="tp-copy"></span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="server">
  <div class="anchor tp-box tp-server">
    <div class="tp-box__title">
      <Fragment set:html={rack} />
      {t.server}
    </div>
    <div class="tp-state" id="tp-s-state"></div>
    <div class="tp-app">
      <span class="tp-app__label">{t.app}</span>
      <span class="tp-app__text" id="tp-app"></span>
    </div>
    <div class="tp-held" id="tp-held">
      <span class="tp-app__label">{t.held}</span>
      <span class="tp-held__text">{t.segments[2].text}</span>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="uses" hidden>
  <ul class="anchor tp-uses" role="list">
    {t.uses.map(([use, transport], i) => (
      <li class="tp-uses__row" id={`tp-use-${i + 1}`}>
        <span>{use}</span>
        <b data-kind={transport === 'TCP' ? 'tcp' : 'http'}>{transport}</b>
      </li>
    ))}
  </ul>
</div>

<div class="scene-actor" data-actor="targets" hidden>
  <div class="anchor tp-targets">
    <div class="tp-targets__head">nc -vz</div>
    {targets.map((target, i) => (
      <div class="tp-target" id={`tp-t-${i + 1}`}>
        <span class="tp-target__name">{target}</span>
        <span class="tp-target__result" id={`tp-r-${i + 1}`} />
      </div>
    ))}
  </div>
</div>
