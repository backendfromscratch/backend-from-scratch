---
/**
 * The layers world's actors (layers.ts says what they do): your laptop and the server as stacks of
 * the four layers, two routers that only reach the network layer, the message with the envelopes
 * each layer adds, the analogy's letter, OSI next to TCP/IP, and the lesson's `curl -sv` output.
 * Every part that shows up later already has its room (spec §4.3). Ids start with `ly-`.
 */
import type { Locale } from '~/lib/locales';
import { strings, type Layer } from './strings';

interface Props {
  lang: Locale;
}

const t = strings[Astro.props.lang];
const all: readonly Layer[] = ['app', 'transport', 'network', 'link'];
const lower: readonly Layer[] = ['network', 'link'];
const stacks = [
  ['mine', t.mine, all],
  ['theirs', t.theirs, all],
  ['gateway', t.gateway, lower],
  ['isp', t.isp, lower],
] as const;
/** OSI's seven layers and the TCP/IP layer each one falls into (the lesson's table). */
const osiTo: readonly Layer[] = ['app', 'app', 'app', 'transport', 'network', 'link', 'link'];
---

{stacks.map(([id, name, layers]) => (
  <div class="scene-actor" data-actor={id} hidden={id !== 'mine'}>
    <div class:list={['anchor', 'ly-stack', { 'ly-stack--router': layers.length === 2 }]}>
      <div class="ly-stack__name">{name}</div>
      {layers.map((layer) => (
        <div class="ly-row" id={`ly-${id}-${layer}`} data-layer={layer}>
          <span class="ly-row__name">{t.layer[layer]}</span>
          <span class="ly-row__proto">{t.protocol[layer]}</span>
        </div>
      ))}
    </div>
  </div>
))}

<div class="scene-actor" data-actor="wrap" hidden>
  <div class="anchor ly-wrap">
    <div class="ly-wrap__blocks">
      <span class="ly-block ly-block--eth" data-layer="link" data-wrap="3">
        Ethernet
      </span>
      <span class="ly-block ly-block--ip" data-layer="network" data-wrap="2">
        IP
      </span>
      <span class="ly-block ly-block--tcp" data-layer="transport" data-wrap="1">
        TCP
      </span>
      <span class="ly-block ly-block--data is-on" data-layer="app">
        {t.message}
      </span>
      <span class="ly-block ly-block--trailer" data-layer="link" data-wrap="3">
        {t.trailer}
      </span>
    </div>
    <div class="ly-wrap__unit" id="ly-unit">
      {t.unit.app}
    </div>
  </div>
  <span class="scene-label">{t.wrap}</span>
</div>

<div class="scene-actor" data-actor="letter" hidden>
  <div class="anchor ly-letter">
    <svg class="ly-letter__flap" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M2 2 L100 36 L198 2"></path>
    </svg>
    <div class="ly-letter__row ly-letter__row--letter">{t.letter.letter}</div>
    <div class="ly-letter__row" id="ly-name">
      {t.letter.name}
    </div>
    <div class="ly-letter__row" id="ly-address">
      {t.letter.address}
    </div>
  </div>
  <span class="scene-label">{t.letter.title}</span>
</div>

<div class="scene-actor" data-actor="osi" hidden>
  <div class="anchor ly-osi">
    <span class="ly-osi__head">{t.osi}</span>
    <span class="ly-osi__head">{t.tcpip}</span>
    {t.osiNames.map((name, i) => (
      <span
        class="ly-osi__row"
        id={`ly-osi-${7 - i}`}
        style={`grid-row: ${i + 2}`}
        data-layer={osiTo[i]}
      >
        <b>{7 - i}</b> {name}
      </span>
    ))}
    <span class="ly-osi__tcpip" id="ly-tcpip-app" style="grid-row: 2 / span 3" data-layer="app">
      {t.layer.app}
    </span>
    <span class="ly-osi__tcpip" id="ly-tcpip-transport" style="grid-row: 5" data-layer="transport">
      {t.layer.transport}
    </span>
    <span class="ly-osi__tcpip" id="ly-tcpip-network" style="grid-row: 6" data-layer="network">
      {t.layer.network}
    </span>
    <span class="ly-osi__tcpip" id="ly-tcpip-link" style="grid-row: 7 / span 2" data-layer="link">
      {t.layer.link}
    </span>
  </div>
</div>

<div class="scene-actor" data-actor="curl" hidden>
  <div class="anchor ly-term">
    <div class="ly-term__bar">
      <i></i>
      <i></i>
      <i></i>
      <span>curl -sv http://example.com -o /dev/null</span>
    </div>
    <pre class="ly-term__out"><span id="ly-l-dns">* Host example.com:80 was resolved.
* IPv4: 172.66.147.243, 104.20.23.154</span>
<span id="ly-l-try">*   Trying [2606:4700:10::6814:179a]:80...</span>
<span id="ly-l-conn">* Connected to example.com (…) port 80</span>
<span id="ly-l-http">&gt; GET / HTTP/1.1
&gt; Host: example.com
&lt; HTTP/1.1 200 OK</span>
* Connection #0 to host example.com left intact</pre>
  </div>
</div>
