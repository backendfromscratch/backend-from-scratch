---
/**
 * The vectors world's actors (vectors.ts says what they do): the catalogue by name, the model of
 * embeddings, the map of products and its question, two arrows, the models volume, the worker, the
 * products table, HNSW's floors, PostgreSQL with its outbox, the queue, `docker stats` and the table
 * of searches. HTML boxes with their text at its own size, SVG only for shapes (the arrows, the
 * graph); every part that shows up later already has its room (spec §4.3). Ids start with `vx-`.
 */
import type { Locale } from '~/lib/locales';
import { strings } from './strings';
import { VECTORS_INITIAL, ARROW_REST, arrowAngle, barLength, ranks } from './vectors';

interface Props {
  lang: Locale;
}

const lang = Astro.props.lang;
const t = strings[lang];
const icon = (paths: string) =>
  `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const cylinder = icon(
  '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
);
const spark = icon('<path d="M8 1.8v12.4M1.8 8h12.4M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/>');
const gear = icon(
  '<circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v2M8 12.2v2M1.8 8h2M12.2 8h2M3.6 3.6l1.4 1.4M11 11l1.4 1.4M3.6 12.4 5 11M11 5l1.4-1.4"/>',
);
const list = icon('<path d="M5.5 4h8M5.5 8h8M5.5 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01"/>');
const s = VECTORS_INITIAL;
const placed = ranks(t.table.rows);

// HNSW's graph (viewBox 0 0 160 90): three floors, each node also on every floor below it, and the
// question at the same place on each floor. Nodes: id, x, and its height inside its floor.
const FLOORS = [14, 44, 75];
const NODES: readonly (readonly [string, number, number, number])[] = [
  // [id, x, y offset, top floor it reaches (0 top, 2 bottom)]
  ['a', 16, 0, 0],
  ['b', 80, -4, 0],
  ['c', 140, 2, 0],
  ['d', 48, 4, 1],
  ['e', 112, -6, 1],
  ['f', 152, 7, 1],
  ['g', 30, -7, 2],
  ['h', 64, 8, 2],
  ['i', 96, 5, 2],
  ['j', 124, 7, 2],
  ['k', 132, -8, 2],
  ['l', 102, -1, 2],
  ['n', 134, 2, 2],
];
const EDGES: readonly (readonly [number, string, string])[] = [
  [0, 'a', 'b'],
  [0, 'b', 'c'],
  [1, 'a', 'd'],
  [1, 'd', 'b'],
  [1, 'b', 'e'],
  [1, 'e', 'c'],
  [1, 'c', 'f'],
  [2, 'g', 'a'],
  [2, 'a', 'd'],
  [2, 'd', 'h'],
  [2, 'h', 'b'],
  [2, 'b', 'i'],
  [2, 'i', 'l'],
  [2, 'l', 'e'],
  [2, 'e', 'k'],
  [2, 'e', 'j'],
  [2, 'k', 'c'],
  [2, 'c', 'f'],
  [2, 'j', 'i'],
  [2, 'n', 'c'],
  [2, 'n', 'f'],
];
const QUERY_X = 118;
const QUERY_DY = 1;
const node = (id: string) => NODES.find(([n]) => n === id)!;
const y = (floor: number, id: string) => FLOORS[floor]! + node(id)[2];
// Each floor's middle, in board em (the graph is 16em wide for its 160 units), for its name.
const floorTops = FLOORS.map((top) => (top / 10).toFixed(2));
---

<div class="scene-actor" data-actor="catalog" hidden>
  <div class="anchor vx-box vx-catalog">
    <div class="vx-box__title">
      <Fragment set:html={cylinder} />
      {t.catalog.title}
    </div>
    <div class="vx-box__sub">{t.catalog.sub}</div>
    {t.catalog.names.map((name, i) => (
      <div class="vx-row" id={`vx-cat-${i + 1}`}>
        {name}
      </div>
    ))}
    <div class="vx-row vx-row--more">{t.catalog.more}</div>
  </div>
</div>

<div class="scene-actor" data-actor="embedder" hidden>
  <div class="anchor vx-box vx-embedder">
    <div class="vx-box__title">
      <Fragment set:html={spark} />
      {t.embedder.title}
    </div>
    <div class="vx-box__sub">{t.embedder.sub}</div>
    <div class="vx-in vx-room" id="vx-in">
      {t.embedder.input}
    </div>
    <div class="vx-out vx-room" id="vx-out">
      <span>{t.embedder.vector[0]}</span>
      <span>{t.embedder.vector[1]}</span>
      <b>{t.embedder.count}</b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="plane" hidden>
  <div class={s.vxDots ? 'anchor vx-plane' : 'anchor vx-plane is-empty'} id="vx-plane">
    <div class="vx-plane__head">
      <span class="vx-pin vx-pin--icon"></span>
      <span id="vx-query"></span>
    </div>
    <div class="vx-map">
      <svg class="vx-lines" id="vx-lines" viewBox="0 0 16 10" aria-hidden="true"></svg>
      {t.products.map((product, i) => (
        <span
          class={`vx-dot vx-dot--${product.side}`}
          id={`vx-dot-${i + 1}`}
          data-family={product.group}
          style={`left:${product.at[0]}em;top:${product.at[1]}em`}
        >
          <span class="vx-label vx-room" id={`vx-label-${i + 1}`}>
            {product.name}
          </span>
        </span>
      ))}
      {(['cold', 'word'] as const).map((pin) => (
        <span
          class="vx-pin vx-room"
          id={`vx-pin-${pin}`}
          style={`left:${t[pin].at[0]}em;top:${t[pin].at[1]}em`}
        />
      ))}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="angle" hidden>
  <div class="anchor vx-box vx-angle">
    <svg class="vx-angle__svg" viewBox="0 0 90 50" aria-hidden="true">
      <path class="vx-angle__base" d="M8 44h74" />
      <g class="vx-arrow vx-arrow--fixed">
        <path d="M45 44h33M73 40l5 4-5 4" />
      </g>
      <g
        class="vx-arrow vx-arrow--turn"
        id="vx-arrow"
        style={`transform:${arrowAngle(ARROW_REST)}`}
      >
        <path d="M45 44h33M73 40l5 4-5 4" />
      </g>
      <circle class="vx-angle__origin" cx="45" cy="44" r="2.2" />
    </svg>
    <div class="vx-angle__row">
      <span>{t.angle.distance}</span>
      <b class="vx-written" id="vx-cos"></b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="modelvol" hidden>
  <div
    class={s.vxModel ? 'anchor vx-box vx-volume is-full' : 'anchor vx-box vx-volume'}
    id="vx-volume"
  >
    <div class="vx-box__title">
      <Fragment set:html={cylinder} />
      {t.volume.title}
    </div>
    <div class="vx-fill">
      <i id="vx-fill"></i>
    </div>
    <div class="vx-box__sub vx-volume__size">{t.volume.size}</div>
  </div>
</div>

<div class="scene-actor" data-actor="worker" hidden>
  <div class="anchor vx-box vx-worker">
    <div class="vx-box__title">
      <Fragment set:html={gear} />
      {t.worker}
    </div>
    <div class="vx-status vx-written" id="vx-worker-status"></div>
  </div>
</div>

<div class="scene-actor" data-actor="vtable" hidden>
  <div class="anchor vx-table">
    <div class="vx-table__row vx-table__head">
      {t.table.head.map((head) => (
        <span>{head}</span>
      ))}
      <span></span>
    </div>
    {t.table.rows.map(([name, distance], i) => (
      <div class="vx-table__row" id={`vx-row-${i + 1}`}>
        <span>{name}</span>
        <code id={`vx-emb-${i + 1}`}>{s.vxVectors ? '[…]' : 'NULL'}</code>
        <b id={`vx-dist-${i + 1}`}>{s.vxRanked ? distance : ''}</b>
        <i id={`vx-rank-${i + 1}`}>{s.vxRanked ? placed[i] : ''}</i>
      </div>
    ))}
    <div class="vx-table__row vx-room" id="vx-added">
      <span>{t.table.added}</span>
      <code id="vx-emb-added">NULL</code>
      <b></b>
      <i></i>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="hnsw" hidden>
  <div class="anchor vx-hnsw">
    {t.floors.map((floor, i) => (
      <span class="vx-floor" style={`top:${floorTops[i]}em`}>
        <span>{floor}</span>
      </span>
    ))}
    <svg class="vx-hnsw__svg" viewBox="0 0 160 90" aria-hidden="true">
      {FLOORS.map((top) => (
        <rect class="vx-band" x="2" y={top - 11} width="156" height="22" rx="4" />
      ))}
      {NODES.filter(([, , , reach]) => reach < 2).map(([id, x]) =>
        FLOORS.slice(node(id)[3], 2).map((_, k) => (
          <path
            class="vx-drop"
            d={`M${x} ${y(node(id)[3] + k, id)}V${y(node(id)[3] + k + 1, id)}`}
          />
        )),
      )}
      {EDGES.map(([floor, from, to]) => (
        <path
          class="vx-edge"
          d={`M${node(from)[1]} ${y(floor, from)}L${node(to)[1]} ${y(floor, to)}`}
        />
      ))}
      {FLOORS.map((top, floor) => (
        <path
          class="vx-q"
          id={`vx-q-${floor}`}
          d={`M${QUERY_X} ${top + QUERY_DY - 3.4}l1 2.2 2.4.3-1.8 1.6.5 2.4-2.1-1.2-2.1 1.2.5-2.4-1.8-1.6 2.4-.3z`}
        />
      ))}
      {NODES.flatMap(([id, x, , reach]) =>
        FLOORS.slice(reach).map((_, k) => (
          <circle
            class="vx-node"
            id={`vx-h-${reach + k}${id}`}
            cx={x}
            cy={y(reach + k, id)}
            r="2.6"
          />
        )),
      )}
    </svg>
  </div>
</div>

<div class="scene-actor" data-actor="pg" hidden>
  <div class="anchor vx-box vx-pg">
    <div class="vx-box__title">
      <Fragment set:html={cylinder} />
      PostgreSQL
    </div>
    <div class="vx-box__sub">{t.pg.products}</div>
    <div class="vx-pg__row vx-room" id="vx-pg-row">
      <span>{t.table.added}</span>
      <code id="vx-pg-emb">NULL</code>
    </div>
    <div class="vx-box__sub">{t.pg.outbox}</div>
    <div class="vx-pg__row vx-room" id="vx-pg-event">
      <span>{t.pg.event}</span>
      <b class="vx-written" id="vx-pg-sent"></b>
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="queue" hidden>
  <div class="anchor vx-box vx-queue">
    <div class="vx-box__title">
      <Fragment set:html={list} />
      {t.queue.title}
    </div>
    <div class="vx-box__sub">{t.queue.sub}</div>
    <div class="vx-job vx-room" id="vx-job">
      {t.queue.job}
    </div>
  </div>
</div>

<div class="scene-actor" data-actor="memory" hidden>
  <div class="anchor vx-box vx-memory" id="vx-memory">
    <div class="vx-memory__title">{t.memory.title}</div>
    {t.memory.rows.map(([name, before], i) => (
      <div class="vx-mem" id={`vx-mem-${i + 1}`}>
        <span>{name}</span>
        <span class="vx-mem__track">
          <i id={`vx-bar-${i + 1}`} style={`transform:${barLength(before)}`}></i>
        </span>
        <b id={`vx-mib-${i + 1}`}>
          {before} {t.memory.unit}
        </b>
      </div>
    ))}
    <div class="vx-killed">{t.memory.killed}</div>
  </div>
</div>

<div class="scene-actor" data-actor="words" hidden>
  <div class="anchor vx-words">
    {[t.words.head, ...t.words.rows].map((row, r) =>
      row.map((cell, c) => (
        <span
          class:list={['vx-words__cell', { 'is-head': r === 0, 'is-name': c === 0 }]}
          data-col={c}
          id={r === 0 && c > 0 ? `vx-col-${c}` : undefined}
        >
          {cell}
        </span>
      )),
    )}
  </div>
</div>
