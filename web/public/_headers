# Response headers for Cloudflare Workers static assets (copied as is to web/dist/).
# Astro puts a content hash in every file name under /_astro/: when the file changes, so does its
# name. The browser can keep these files for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Practice files the lessons download with curl (Phase 1): useful in a terminal, not in Google.
/practicas/*
  X-Robots-Tag: noindex

# Scripts are shown as text, so they can be read in the browser before running them.
/practicas/*.sh
  Content-Type: text/plain; charset=utf-8

# nginx configurations for the practice VM (Phase 2), shown as text like the scripts.
/practicas/*.conf
  Content-Type: text/plain; charset=utf-8

# Terraform practice files (Phase 8) and the server example to read, shown as text.
/practicas/terraform/*
  Content-Type: text/plain; charset=utf-8

# Phase 2, CORS: JavaScript on any origin may read cors-on.json; its twin, cors-off.json, gets
# no Access-Control-Allow-Origin, so the browser hides it from other origins.
/practicas/http/cors-on.json
  Access-Control-Allow-Origin: *
