# Response headers for Cloudflare Workers static assets (copied as is to web/dist/).
# Astro puts a content hash in every file name under /_astro/: when the file changes, so does its
# name. The browser can keep these files for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Practice files the lessons download with curl (Phase 1): useful in a terminal, not in Google.
/practicas/*
  X-Robots-Tag: noindex
