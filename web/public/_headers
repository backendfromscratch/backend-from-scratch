# Response headers for Cloudflare Workers static assets (copied as is to web/dist/). A path gets the
# headers of every rule that matches it.

# The security headers Phase 2's lesson 4 teaches, on every response:
# - HSTS: a browser that visited over HTTPS uses only HTTPS here for the next max-age seconds, even
#   if a link says http://. Started at one day on 2026-11-23, to be raised step by step while HTTPS
#   keeps working; no includeSubDomains or preload yet (the preload list is slow to leave).
# - nosniff: the browser trusts Content-Type instead of guessing a file's type from its contents.
# - Referrer-Policy: other sites learn which domain a visitor came from, not the full address.
# No Content-Security-Policy: Starlight and the layout write small scripts inside every page (the
# theme, the side panel), which `script-src 'self'` would block.
/*
  Strict-Transport-Security: max-age=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro puts a content hash in every file name under /_astro/: when the file changes, so does its
# name. The browser can keep these files for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Practice files the lessons download with curl (Phase 1): useful in a terminal, not in Google.
/practicas/*
  X-Robots-Tag: noindex

# Scripts are shown as text, so they can be read in the browser before running them.
/practicas/*.sh
  Content-Type: text/plain; charset=utf-8

# nginx configurations for the practice VM (Phase 2), shown as text like the scripts.
/practicas/*.conf
  Content-Type: text/plain; charset=utf-8

# Terraform practice files (Phase 8) and the server example to read, shown as text.
/practicas/terraform/*
  Content-Type: text/plain; charset=utf-8

# The replica practice's Compose files (Phase 9), shown as text.
/practicas/replicas/*
  Content-Type: text/plain; charset=utf-8

# Phase 2, CORS: JavaScript on any origin may read cors-on.json; its twin, cors-off.json, gets
# no Access-Control-Allow-Origin, so the browser hides it from other origins.
/practicas/http/cors-on.json
  Access-Control-Allow-Origin: *
