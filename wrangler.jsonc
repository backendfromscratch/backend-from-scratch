// Cloudflare Workers configuration: the site is a Worker with static assets only, no server code.
// Workers Builds runs `pnpm build` and then `pnpm exec wrangler deploy` on every push to `main`
// (`pnpm exec wrangler preview` on the other branches).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backend-from-scratch",
  "compatibility_date": "2026-10-01",
  // The site lives only at backenddesdecero.com: no second public address on workers.dev.
  // Preview URLs, one per branch, stay on workers.dev. www and backendfromscratch.com are not
  // here: they are Redirect Rules in the dashboard (docs/specs/2026-10-02-site-and-phase-0-design.md, §7).
  "routes": [{ "pattern": "backenddesdecero.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    // What `pnpm build` generates.
    "directory": "./web/dist",
    // Pages are folders with an index.html: /fase-0/que-es-dns/ serves fase-0/que-es-dns/index.html,
    // and /fase-0/que-es-dns redirects to the URL with the trailing slash, the canonical one.
    "html_handling": "auto-trailing-slash",
    // A URL that matches no file gets 404.html with a real 404 status, not the home page.
    "not_found_handling": "404-page",
  },
}
