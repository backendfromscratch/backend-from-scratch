// Knip: unused files, exports and dependencies. It runs in CI (`pnpm knip`).
// What it cannot see is listed here, each with its reason.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The guided projects are separate npm projects with their own CI job (ci.yml, "guided projects").
  "ignore": ["projects/**"],
  "workspaces": {
    ".": {
      // Used as a CLI, never imported: `pnpm exec wrangler deploy` in Workers Builds.
      "ignoreDependencies": ["wrangler"],
    },
    "web": {
      // Starlight loads it from a string in astro.config.ts (`routeMiddleware`).
      "entry": ["src/routeData.ts"],
      "ignoreDependencies": [
        // Loaded by path, as strings: in astro.config.ts (`customCss`) and in lib/og/fonts.ts.
        "@fontsource-variable/atkinson-hyperlegible-next",
        "@fontsource-variable/jetbrains-mono",
        "@fontsource/atkinson-hyperlegible-next",
        "@fontsource/jetbrains-mono",
      ],
      // Commands the reader types in Node's REPL inside a lesson's <TryIt> (the guided project's
      // files, not the site's): knip reads them as imports.
      "ignoreUnresolved": ["./src/bd.ts", "./src/db.ts"],
    },
  },
}
