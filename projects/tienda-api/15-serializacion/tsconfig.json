{
  // Solo para comprobar los tipos (npm run check): Node ejecuta los .ts sin compilarlos.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    // Los import llevan la extensión .ts, como los lee Node.
    "allowImportingTsExtensions": true,
    // Solo la parte de TypeScript que Node sabe borrar: nada de enum, por ejemplo.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
