# Copia este fichero como .env y cambia los valores. .env no se sube a Git: está en .gitignore.
PORT=3000
LOG_LEVEL=info
# Un texto largo y difícil de adivinar. Puedes generar uno con: openssl rand -hex 24
ADMIN_TOKEN=cambia-esto-por-un-token-largo
# El secreto que la tienda comparte con la pasarela de pago para firmar los webhooks. Otro distinto.
WEBHOOK_SECRET=cambia-esto-por-otro-secreto-largo
