{
  "name": "tienda-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/servidor.ts",
    "dev": "node --env-file-if-exists=.env --watch src/servidor.ts",
    "trabajador": "node --env-file-if-exists=.env scripts/trabajador.ts",
    "test": "node --env-file=test/.env --test --test-concurrency=1 'test/*.test.ts'",
    "e2e": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/e2e/*.e2e.ts'",
    "cobertura": "node --env-file=test/.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='test/**' 'test/*.test.ts'",
    "check": "tsc --noEmit",
    "pasarela": "node --env-file-if-exists=.env scripts/pasarela.ts",
    "bd:migrar": "node --env-file-if-exists=.env scripts/migrar.ts",
    "bd:datos": "node --env-file-if-exists=.env scripts/cargar-datos.ts",
    "bd:datos:produccion": "node --env-file-if-exists=.env scripts/cargar-datos.ts --sin-cuentas",
    "bd:muchos-pedidos": "node --env-file-if-exists=.env scripts/muchos-pedidos.ts",
    "bd:generar": "drizzle-kit generate",
    "crear-clave": "node --env-file-if-exists=.env scripts/crear-clave.ts",
    "crear-admin": "node --env-file-if-exists=.env scripts/crear-admin.ts",
    "proveedor": "node scripts/proveedor.ts",
    "otra-web": "node scripts/otra-web.ts",
    "contrato": "node --env-file=test/.env scripts/contrato.ts",
    "carga": "autocannon"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@scalar/hono-api-reference": "0.12.10",
    "ajv": "8.20.0",
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "nodemailer": "10.1.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "protobufjs": "8.8.0",
    "redis": "6.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "oauth2-mock-server": "9.2.0",
    "typescript": "7.0.2"
  }
}
