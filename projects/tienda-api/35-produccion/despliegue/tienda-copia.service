# Una copia de seguridad de la base de datos (la lanza tienda-copia.timer). Instálalo con:
#   sudo cp despliegue/tienda-copia.service despliegue/tienda-copia.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tienda-copia.timer
# Cambia User y las dos rutas si tu usuario o tu carpeta no son ubuntu y /opt/tienda.
[Unit]
Description=Copia de seguridad de la base de datos de la tienda
# Sin Docker arrancado no hay base de datos de la que copiar.
Requires=docker.service
After=docker.service

[Service]
# Type=oneshot: hace una tarea y termina (no es un servidor que se queda).
Type=oneshot
# Si se queda colgado (un volcado que no acaba), systemd lo corta a los 30 minutos.
TimeoutStartSec=30min
# Un usuario del grupo docker, no root. Ojo: el grupo docker equivale a root (quien puede hablar con
# Docker puede montar cualquier carpeta del servidor en un contenedor). Se usa igual porque así las
# copias son de ubuntu y no de root, y ubuntu es quien ya administra Docker en este servidor.
User=ubuntu
WorkingDirectory=/opt/tienda
ExecStart=/opt/tienda/despliegue/copia-seguridad.sh
