# Copia este fichero como .env y cambia los valores. .env no se sube a Git: está en .gitignore.
PORT=3000
LOG_LEVEL=info
# Un texto largo y difícil de adivinar. Puedes generar uno con: openssl rand -hex 24
ADMIN_TOKEN=cambia-esto-por-un-token-largo
# El secreto que la tienda comparte con la pasarela de pago para firmar los webhooks. Otro distinto.
WEBHOOK_SECRET=cambia-esto-por-otro-secreto-largo
# La base de datos: postgres://usuario:contraseña@servidor:puerto/base. La contraseña, la que le
# diste al usuario tienda al crearlo.
DATABASE_URL=postgres://tienda:cambia-esta-contraseña@localhost:5432/tienda
# El proveedor de identidad (lección 4). Para practicar, el de npm run proveedor, en tu ordenador:
# acepta cualquier id y secreto. Con Google, el emisor es https://accounts.google.com, y el id y el
# secreto te los da Google Cloud al registrar la tienda (con la URL de vuelta exacta de abajo).
OIDC_EMISOR=http://localhost:9000
OIDC_CLIENTE_ID=tienda
OIDC_CLIENTE_SECRETO=cambia-esto-por-el-secreto-del-proveedor
OIDC_VUELTA=http://localhost:3000/v2/sesion/proveedor/vuelta
