# Copia este fichero como .env y cambia los valores. .env no se sube a Git: está en .gitignore.
PORT=3000
LOG_LEVEL=info
# El secreto que la tienda comparte con la pasarela de pago para firmar los webhooks. Como mínimo,
# 32 caracteres, y nunca el de este ejemplo (el servidor no arranca con él). Genera uno con:
#   openssl rand -base64 32
WEBHOOK_SECRET=cambia-esto-por-un-secreto-de-openssl-rand
# La base de datos: postgres://usuario:contraseña@servidor:puerto/base. La contraseña, la que le
# diste al usuario tienda al crearlo.
DATABASE_URL=postgres://tienda:cambia-esta-contraseña@localhost:5432/tienda
# Solo con Docker Compose (compose.yaml): la contraseña de la base de datos que Compose crea en su
# propio contenedor. Allí, DATABASE_URL la pone compose.yaml con esta contraseña. Va dentro de una
# URL, así que solo letras y números: genera una con
#   openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esta-contraseña
# Redis, para los límites de intentos y la cola de trabajos (Fase 9). Sin ella, los intentos se
# guardan en la memoria del servidor, y los trabajos (los avisos, el correo) se hacen en el mismo
# proceso, sin reintentos. Con Docker Compose no hace falta: la pone compose.yaml.
# REDIS_URL=redis://localhost:6379
# La caché del catálogo (Fase 9): otro Redis, distinto del de la cola, que puede perder lo que
# guarda (compose.yaml). Sin ella, los productos se leen siempre de PostgreSQL. Sin Docker, un
# segundo redis-server en otro puerto (el 6380, por ejemplo). Con Docker Compose no hace falta: la
# pone compose.yaml (redis://cache:6379).
# CACHE_URL=redis://localhost:6380
# El servidor de correo, para el correo de confirmación de un pedido pagado (Fase 9). Sin ella, no
# se manda ninguno: el log dice cuál habría salido. Con Docker Compose no hace falta: compose.yaml
# pone Mailpit (smtp://mailpit:1025), y los correos se ven en http://localhost:8025.
# SMTP_URL=smtp://localhost:1025
# Quién firma los correos.
# SMTP_REMITENTE=La tienda <pedidos@tienda.example>
# El proveedor de identidad (lección 4). Para practicar, el de npm run proveedor, en tu ordenador:
# acepta cualquier id y secreto. Con Google, el emisor es https://accounts.google.com, y el id y el
# secreto te los da Google Cloud al registrar la tienda (con la URL de vuelta exacta de abajo).
OIDC_EMISOR=http://localhost:9000
OIDC_CLIENTE_ID=tienda
# El secreto lo da el proveedor al registrar la tienda. El de práctica acepta cualquiera: genera
# uno con openssl rand -base64 32.
OIDC_CLIENTE_SECRETO=cambia-esto-por-el-secreto-del-proveedor
OIDC_VUELTA=http://localhost:3000/v2/sesion/proveedor/vuelta
# Las webs desde las que se aceptan peticiones con la cookie de la sesión (lección 7), separadas por
# comas: la propia tienda y, si la hay, la web que usa la API.
ORIGENES_PERMITIDOS=http://localhost:3000
# Solo en tu ordenador: nombres a los que la tienda puede mandar los avisos de reparto por http,
# aunque sean internos (localhost). En un servidor de verdad, déjalo vacío.
AVISOS_HOSTS_DESARROLLO=
# Las IP de tu proxy (Nginx), separadas por comas: solo de ellas se lee X-Forwarded-For. Sin proxy,
# déjalo vacío. Solo se admite UN salto de proxy (la última entrada de
# X-Forwarded-For): con otro proxy delante (el de Cloudflare, por ejemplo), el limitador vería las
# direcciones de ese proxy.
PROXY_CONFIABLE=
# Si la API comprueba sus propias respuestas contra el contrato (Fase 10, lección 3): no, registrar
# (un aviso en el log por cada respuesta que no lo cumple) o fallar (un 500 en su lugar).
VALIDAR_RESPUESTAS=registrar
# Las trazas (Fase 10, lección 4): a dónde las manda la tienda, por OTLP. Sin ella, no se mandan, y
# la tienda funciona igual. Con Docker Compose no hace falta: la pone compose.observabilidad.yaml
# (Jaeger). Sin Docker, con un Jaeger en tu ordenador:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Cómo se llama cada proceso en Jaeger: tienda-api para la API y tienda-trabajador para el trabajador.
# OTEL_SERVICE_NAME=tienda-api
