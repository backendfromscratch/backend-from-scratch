# El despliegue de la tienda (tienda-despliegue.timer lo lanza). Instálalo con:
#   sudo cp despliegue/tienda-despliegue.service despliegue/tienda-despliegue.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tienda-despliegue.timer
# Su registro: journalctl -u tienda-despliegue. Cambia User y las dos rutas si tu usuario o tu
# carpeta no son ubuntu y /opt/tienda.
[Unit]
Description=Despliega la imagen nueva de la tienda, si la hay
# Sin Docker arrancado no hay nada que desplegar, y sin red no se llega al registro.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# Type=oneshot: hace una tarea y termina (no es un servidor que se queda).
Type=oneshot
# El mismo usuario que la copia de seguridad (del grupo docker; ya sabes lo que eso implica) y,
# siempre, el mismo que ejecute desplegar.sh a mano: comparten el fichero de bloqueo.
User=ubuntu
WorkingDirectory=/opt/tienda
ExecStart=/opt/tienda/despliegue/desplegar.sh
# Si se queda colgado (una descarga que no acaba), systemd lo corta a los 15 minutos.
TimeoutStartSec=15min
