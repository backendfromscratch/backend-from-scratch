# Cuándo se hace la copia (Fase 1: un temporizador de systemd es un cron con mejor registro).
[Unit]
Description=Copia de seguridad nocturna de la tienda

[Timer]
# Cada noche a las 03:30, hora del servidor.
OnCalendar=*-*-* 03:30:00
# Si el servidor estaba apagado a esa hora, la hace en cuanto arranca.
Persistent=true

[Install]
WantedBy=timers.target
