{
  "name": "tienda-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/servidor.ts",
    "dev": "node --env-file-if-exists=.env --watch src/servidor.ts",
    "test": "node --env-file=test/.env --test --test-concurrency=1",
    "check": "tsc --noEmit",
    "pasarela": "node --env-file-if-exists=.env scripts/pasarela.ts",
    "bd:crear": "node --env-file-if-exists=.env scripts/crear-bd.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@scalar/hono-api-reference": "0.12.10",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "protobufjs": "8.8.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
