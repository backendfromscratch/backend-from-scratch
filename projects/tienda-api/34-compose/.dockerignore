# Lo que no entra en la imagen: docker build no lo manda, y COPY . . no lo encuentra.

# Las dependencias se instalan dentro, con npm ci, para Linux: las de tu ordenador pueden ser de
# otro sistema, y pesan.
node_modules

# Tus secretos. Una imagen se comparte, y quien la tiene puede leer todos sus ficheros: la
# configuración llega al arrancar, con --env-file o -e.
.env

# La historia de Git, los logs y los ficheros de Docker, que la API no usa.
.git
*.log
Dockerfile
.dockerignore
compose.yaml
