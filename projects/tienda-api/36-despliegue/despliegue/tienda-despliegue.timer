# Cuándo se mira si hay una imagen nueva (Fase 1: un temporizador de systemd es un cron con mejor
# registro).
[Unit]
Description=Mira cada dos minutos si hay una imagen nueva de la tienda

[Timer]
# Un minuto después de arrancar el servidor (la primera vez)…
OnBootSec=1min
# …y cada dos minutos desde que terminó la ejecución anterior (si un despliegue tarda, no se
# amontonan: el siguiente cuenta desde que acaba).
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
