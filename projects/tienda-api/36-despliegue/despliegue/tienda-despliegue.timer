# Cuándo se mira si hay una imagen nueva (Fase 1: un temporizador de systemd es un cron con mejor
# registro).
[Unit]
Description=Mira cada dos minutos si hay una imagen nueva de la tienda

[Timer]
# Un minuto después de arrancar el servidor (la primera vez)…
OnBootSec=1min
# …y cada dos minutos desde que empezó la ejecución anterior. Si una dura más de dos minutos, el
# siguiente aviso espera a que termine: systemd no lanza dos a la vez (y flock tampoco).
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
