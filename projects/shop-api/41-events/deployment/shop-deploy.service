# The shop's deployment (shop-deploy.timer launches it). Install it with:
#   sudo cp deployment/shop-deploy.service deployment/shop-deploy.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now shop-deploy.timer
# Its log: journalctl -u shop-deploy. Change User and the two paths if your user or your folder
# aren't ubuntu and /opt/shop.
[Unit]
Description=Deploys the shop's new image, if there is one
# Without Docker running there is nothing to deploy, and without a network the registry can't be reached.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# Type=oneshot: it does a task and ends (it isn't a server that stays).
Type=oneshot
# The same user as the backup (in the docker group; you know what that implies) and, always, the
# same one that runs deploy.sh by hand: they share the lock file.
User=ubuntu
WorkingDirectory=/opt/shop
ExecStart=/opt/shop/deployment/deploy.sh
# If it hangs (a download that never ends), systemd cuts it after 15 minutes.
TimeoutStartSec=15min
