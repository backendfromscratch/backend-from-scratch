{
  // Only for checking the types (npm run check): Node runs the .ts files without compiling them.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    // Imports include the .ts extension, the way Node reads them.
    "allowImportingTsExtensions": true,
    // Only the part of TypeScript that Node can erase: no enum, for example.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
