# Copy this file as .env and change the values. .env isn't uploaded to Git: it's in .gitignore.
PORT=3000
LOG_LEVEL=info
# The secret the shop shares with the payment gateway to sign the webhooks. At least 32
# characters, and never the one in this example (the server doesn't start with it). Generate one
# with:
#   openssl rand -base64 32
WEBHOOK_SECRET=change-this-to-a-secret-from-openssl-rand
# The database: postgres://user:password@server:port/database. The password is the one you gave
# the shop user when you created it.
DATABASE_URL=postgres://shop:change-this-password@localhost:5432/shop
# The identity provider (lesson 4). For practice, the one from npm run provider, on your computer:
# it accepts any id and secret. With Google, the issuer is https://accounts.google.com, and Google
# Cloud gives you the id and the secret when you register the shop (with the exact redirect URL
# below).
OIDC_ISSUER=http://localhost:9000
OIDC_CLIENT_ID=shop
# The provider gives the secret when you register the shop. The practice one accepts any: generate
# one with openssl rand -base64 32.
OIDC_CLIENT_SECRET=change-this-to-the-provider-secret
OIDC_REDIRECT_URI=http://localhost:3000/v2/session/provider/callback
# The sites requests with the session cookie are accepted from (lesson 7), separated by commas:
# the shop itself and, if there is one, the site that uses the API.
ALLOWED_ORIGINS=http://localhost:3000
# Only on your computer: names the shop can send the delivery notifications to over http, even if
# they're internal (localhost). On a real server, leave it empty.
NOTIFICATION_DEV_HOSTS=
