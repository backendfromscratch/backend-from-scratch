# A backup of the database (shop-backup.timer launches it). Install it with:
#   sudo cp deployment/shop-backup.service deployment/shop-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now shop-backup.timer
# Change User and the two paths if your user or your folder aren't ubuntu and /opt/shop.
[Unit]
Description=Backup of the shop's database
# Without Docker running there is no database to copy from.
Requires=docker.service
After=docker.service

[Service]
# Type=oneshot: it does a task and ends (it isn't a server that stays).
Type=oneshot
# A user in the docker group, not root. Careful: the docker group is equivalent to root (whoever
# can talk to Docker can mount any folder of the server in a container). It's used anyway because
# that way the backups belong to ubuntu and not to root, and ubuntu is who already administers
# Docker on this server.
User=ubuntu
WorkingDirectory=/opt/shop
ExecStart=/opt/shop/deployment/backup.sh
