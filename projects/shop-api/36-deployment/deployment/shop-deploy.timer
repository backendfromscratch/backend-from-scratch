# When to look for a new image (Phase 1: a systemd timer is a cron with better logging).
[Unit]
Description=Every two minutes, looks for a new image of the shop

[Timer]
# One minute after the server starts (the first time)…
OnBootSec=1min
# …and every two minutes since the previous run started. If one lasts longer than two minutes, the
# next trigger waits for it to end: systemd doesn't start two at once (and flock wouldn't allow it).
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
