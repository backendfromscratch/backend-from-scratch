# When to look for a new image (Phase 1: a systemd timer is a cron with better logging).
[Unit]
Description=Every two minutes, looks for a new image of the shop

[Timer]
# One minute after the server starts (the first time)…
OnBootSec=1min
# …and every two minutes since the previous run ended (if a deployment takes long, they don't pile
# up: the next one counts from when it ends).
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
