# Copy this file as .env and change the values. .env isn't uploaded to Git: it's in .gitignore.
PORT=3000
LOG_LEVEL=info
# The secret the shop shares with the payment gateway to sign the webhooks. At least 32
# characters, and never the one in this example (the server doesn't start with it). Generate one
# with:
#   openssl rand -base64 32
WEBHOOK_SECRET=change-this-to-a-secret-from-openssl-rand
# The database: postgres://user:password@server:port/database. The password is the one you gave
# the shop user when you created it.
DATABASE_URL=postgres://shop:change-this-password@localhost:5432/shop
# Only with Docker Compose (compose.yaml): the password of the database Compose creates in its own
# container. There, compose.yaml sets DATABASE_URL with this password. It goes inside a URL, so
# only letters and numbers: generate one with
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-this-password
# Redis, for the attempt limits and the job queue (Phase 9). Without it, the attempts are kept in
# the server's memory, and the jobs (the notifications, the email) are done in the same process,
# without retries. With Docker Compose it isn't needed: compose.yaml sets it.
# REDIS_URL=redis://localhost:6379
# The catalogue's cache (Phase 9): another Redis, not the queue's, that can lose what it holds
# (compose.yaml). Without it, the products are always read from PostgreSQL. Without Docker, a second
# redis-server on another port (6380, for example). With Docker Compose it isn't needed:
# compose.yaml sets it (redis://cache:6379).
# CACHE_URL=redis://localhost:6380
# The mail server, for the confirmation email of a paid order (Phase 9). Without it, none is sent:
# the log says which one would have gone out. With Docker Compose it isn't needed: compose.yaml
# sets Mailpit (smtp://mailpit:1025), and the emails can be seen at http://localhost:8025.
# SMTP_URL=smtp://localhost:1025
# Who signs the emails.
# SMTP_FROM=The shop <orders@shop.example>
# The identity provider (lesson 4). For practice, the one from npm run provider, on your computer:
# it accepts any id and secret. With Google, the issuer is https://accounts.google.com, and Google
# Cloud gives you the id and the secret when you register the shop (with the exact redirect URL
# below).
OIDC_ISSUER=http://localhost:9000
OIDC_CLIENT_ID=shop
# The provider gives the secret when you register the shop. The practice one accepts any: generate
# one with openssl rand -base64 32.
OIDC_CLIENT_SECRET=change-this-to-the-provider-secret
OIDC_REDIRECT_URI=http://localhost:3000/v2/session/provider/callback
# The sites requests with the session cookie are accepted from (lesson 7), separated by commas:
# the shop itself and, if there is one, the site that uses the API.
ALLOWED_ORIGINS=http://localhost:3000
# Only on your computer: names the shop can send the delivery notifications to over http, even if
# they're internal (localhost). On a real server, leave it empty.
NOTIFICATION_DEV_HOSTS=
# The IPs of your proxy (Nginx), separated by commas: X-Forwarded-For is only read from them. Without
# a proxy, leave it empty. Only ONE proxy hop is supported (the last X-Forwarded-For entry): with
# another proxy in front (Cloudflare's, say), the limiter would see that proxy's addresses.
TRUSTED_PROXY=
# Whether the API checks its own responses against the contract (Phase 10, lesson 3): no, log (a
# warning in the log for each response that doesn't meet it) or fail (a 500 instead).
VALIDATE_RESPONSES=log
