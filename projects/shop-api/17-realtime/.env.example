# Copy this file as .env and change the values. .env isn't uploaded to Git: it's in .gitignore.
PORT=3000
LOG_LEVEL=info
# A long text that's hard to guess. You can generate one with: openssl rand -hex 24
ADMIN_TOKEN=change-this-to-a-long-token
# The secret the shop shares with the payment gateway to sign the webhooks. A different one.
WEBHOOK_SECRET=change-this-to-another-long-secret
