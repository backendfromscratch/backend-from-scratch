# Only for the tests.
LOG_LEVEL=silent
ADMIN_TOKEN=test-token-0123456789abcdef
WEBHOOK_SECRET=test-secret-0123456789abcdef
# The tests' database, on your own computer. The tests empty it and fill it again every time: it
# has to be a different one, never the real one. If DATABASE_URL is already in the environment (in
# CI, for example), Node doesn't replace it with this one.
DATABASE_URL=postgres://shop:shop@localhost:5432/shop_test
# The practice identity provider (npm run provider). The tests in oauth.test.ts start their own,
# on a free port, and change OIDC_ISSUER.
OIDC_ISSUER=http://localhost:9000
OIDC_CLIENT_ID=shop
OIDC_CLIENT_SECRET=test-secret-0123456789abcdef
OIDC_REDIRECT_URI=http://localhost:3000/v2/session/provider/callback
