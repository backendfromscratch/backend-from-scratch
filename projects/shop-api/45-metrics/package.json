{
  "name": "shop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import ./src/instrumentation.ts src/server.ts",
    "dev": "node --env-file-if-exists=.env --import ./src/instrumentation.ts --watch src/server.ts",
    "worker": "node --env-file-if-exists=.env --import ./src/instrumentation.ts scripts/worker.ts",
    "test": "node --env-file=test/.env --test --test-concurrency=1 'test/*.test.ts'",
    "e2e": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/e2e/*.e2e.ts'",
    "coverage": "node --env-file=test/.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='test/**' 'test/*.test.ts'",
    "check": "tsc --noEmit",
    "gateway": "node --env-file-if-exists=.env scripts/payment-gateway.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:production": "node --env-file-if-exists=.env scripts/seed.ts --no-accounts",
    "db:many-orders": "node --env-file-if-exists=.env scripts/many-orders.ts",
    "db:generate": "drizzle-kit generate",
    "create-key": "node --env-file-if-exists=.env scripts/create-key.ts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "provider": "node scripts/provider.ts",
    "other-site": "node scripts/other-site.ts",
    "contract": "node --env-file=test/.env scripts/contract.ts",
    "load": "autocannon"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/otel": "1.2.0",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/instrumentation-redis": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@scalar/hono-api-reference": "0.12.10",
    "ajv": "8.20.0",
    "bullmq": "6.3.15",
    "bullmq-otel": "2.0.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "import-in-the-middle": "3.5.2",
    "jose": "6.2.12",
    "nodemailer": "10.1.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "protobufjs": "8.8.0",
    "redis": "6.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "oauth2-mock-server": "9.2.0",
    "typescript": "7.0.2"
  }
}
