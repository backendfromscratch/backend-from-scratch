# When the backup is made (Phase 1: a systemd timer is a cron with better logging).
[Unit]
Description=Nightly backup of the shop

[Timer]
# Every night at 03:30, server time.
OnCalendar=*-*-* 03:30:00
# If the server was off at that time, it does it as soon as it starts.
Persistent=true

[Install]
WantedBy=timers.target
