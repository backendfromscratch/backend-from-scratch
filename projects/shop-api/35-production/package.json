{
  "name": "shop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --env-file=test/.env --test --test-concurrency=1",
    "check": "tsc --noEmit",
    "gateway": "node --env-file-if-exists=.env scripts/payment-gateway.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:production": "node --env-file-if-exists=.env scripts/seed.ts --no-accounts",
    "db:many-orders": "node --env-file-if-exists=.env scripts/many-orders.ts",
    "db:generate": "drizzle-kit generate",
    "create-key": "node --env-file-if-exists=.env scripts/create-key.ts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "provider": "node scripts/provider.ts",
    "other-site": "node scripts/other-site.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@scalar/hono-api-reference": "0.12.10",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "protobufjs": "8.8.0",
    "redis": "6.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "oauth2-mock-server": "9.2.0",
    "typescript": "7.0.2"
  }
}
