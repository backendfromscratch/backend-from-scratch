diff --color -ruN --exclude node_modules --exclude dist --exclude .astro --exclude docs backup-web/src/lib/translations.ts spike/web/src/lib/translations.ts
--- backup-web/src/lib/translations.ts	1970-01-01 01:00:00
+++ spike/web/src/lib/translations.ts	2026-10-03 12:29:19
@@ -0,0 +1,61 @@
+/**
+ * PRUEBA DE CONCEPTO (desechable): une cada página con su traducción cuando sus rutas difieren.
+ * La clave es `translationKey` del frontmatter o, si no hay, la ruta sin el prefijo de idioma.
+ */
+import { getCollection, type CollectionEntry } from 'astro:content';
+import type { Locale } from './locales';
+
+type Doc = CollectionEntry<'docs'>;
+
+export function localeOfId(id: string): Locale {
+  return id === 'en' || id.startsWith('en/') ? 'en' : 'es';
+}
+
+/** URL pública de una entrada: 'index' → '/', 'fase-0/que-es-dns' → '/fase-0/que-es-dns/'. */
+export function urlOfId(id: string): string {
+  const clean = id === 'index' ? '' : id.replace(/\/index$/, '');
+  return clean ? `/${clean}/` : '/';
+}
+
+function keyOf(doc: Doc): string {
+  const base = doc.id === 'index' ? '' : doc.id;
+  return doc.data.translationKey ?? base.replace(/^en(\/|$)/, '');
+}
+
+export interface TranslationIndex {
+  /** clave → { es: entrada, en: entrada } */
+  byKey: Map<string, Partial<Record<Locale, Doc>>>;
+  keyById: Map<string, string>;
+  /** URLs de las páginas que existen de verdad (sin las copias de respaldo de Starlight). */
+  realUrls: Set<string>;
+}
+
+let cache: Promise<TranslationIndex> | undefined;
+
+export function translationIndex(): Promise<TranslationIndex> {
+  cache ??= getCollection('docs').then((docs) => {
+    const byKey = new Map<string, Partial<Record<Locale, Doc>>>();
+    for (const doc of docs) {
+      const key = keyOf(doc);
+      const locale = localeOfId(doc.id);
+      const pair = byKey.get(key) ?? {};
+      if (pair[locale]) {
+        throw new Error(`[translations] Dos páginas en "${locale}" con la clave "${key}": ${pair[locale]!.id} y ${doc.id}`);
+      }
+      byKey.set(key, { ...pair, [locale]: doc });
+    }
+    return {
+      byKey,
+      keyById: new Map(docs.map((d) => [d.id, keyOf(d)])),
+      realUrls: new Set(docs.map((d) => urlOfId(d.id))),
+    };
+  });
+  return cache;
+}
+
+/** URLs de la página `entryId` en cada idioma en que existe. */
+export async function translationsOf(entryId: string): Promise<Partial<Record<Locale, string>>> {
+  const { byKey, keyById } = await translationIndex();
+  const pair = byKey.get(keyById.get(entryId) ?? '') ?? {};
+  return Object.fromEntries(Object.entries(pair).map(([l, d]) => [l, urlOfId(d!.id)]));
+}
