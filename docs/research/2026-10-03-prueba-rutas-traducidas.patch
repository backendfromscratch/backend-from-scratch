--- backup-web/src/routeData.ts	1970-01-01 01:00:00
+++ spike/web/src/routeData.ts	2026-10-03 12:29:19
@@ -0,0 +1,49 @@
+/** PRUEBA DE CONCEPTO (desechable): corrige lo que Starlight deduce de «misma ruta en cada idioma». */
+import { defineRouteMiddleware, type StarlightRouteData } from '@astrojs/starlight/route-data';
+import { translationsOf, translationIndex } from './lib/translations';
+
+type SidebarEntry = StarlightRouteData['sidebar'][number];
+type Link = Extract<SidebarEntry, { type: 'link' }>;
+
+function prune(entries: SidebarEntry[], real: Set<string>): SidebarEntry[] {
+  return entries.flatMap((entry) => {
+    if (entry.type === 'link') return real.has(entry.href) ? [entry] : [];
+    const children = prune(entry.entries, real);
+    return children.length ? [{ ...entry, entries: children }] : [];
+  });
+}
+
+function flatten(entries: SidebarEntry[]): Link[] {
+  return entries.flatMap((e) => (e.type === 'link' ? [e] : flatten(e.entries)));
+}
+
+export const onRequest = defineRouteMiddleware(async (context) => {
+  const route = context.locals.starlightRoute;
+  const { realUrls } = await translationIndex();
+
+  // 1. El sidebar en inglés incluye las copias de respaldo de las páginas en español: fuera.
+  route.sidebar = prune(route.sidebar, realUrls);
+
+  // 2. La paginación se calculó con el sidebar sin limpiar: se recalcula.
+  const links = flatten(route.sidebar);
+  const i = links.findIndex((l) => l.isCurrent);
+  if (i !== -1) route.pagination = { prev: links[i - 1], next: links[i + 1] };
+
+  // 3. hreflang: Starlight los deduce cambiando el prefijo de idioma. Se reconstruyen desde las claves.
+  route.head = route.head.filter((tag) => !(tag.tag === 'link' && tag.attrs?.rel === 'alternate' && tag.attrs?.hreflang));
+  if (route.isFallback) {
+    // 4. Una copia de respaldo no debe indexarse (y el build la borra).
+    route.head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } });
+  } else if (context.site) {
+    const urls = await translationsOf(route.entry.id);
+    const langs = Object.entries(urls);
+    if (langs.length > 1) {
+      for (const [lang, url] of langs) {
